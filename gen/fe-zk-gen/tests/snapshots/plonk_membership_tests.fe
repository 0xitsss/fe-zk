fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<FixtureVerifier>(value: Wei::zero(), args: (), salt: 0)
}

fn vp(_ p: Address, _ w: [u256; 24], _ x: [u256; 3]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(addr: p, gas: 10000000, value: Wei::zero(), message: FixtureVerifierMsg::VerifyProof { proof: w, input: x })
    r
}

#[test]
fn valid_proof_accepted() uses (evm: mut Evm) {
    let p = deploy()
    let g0 = evm.gas()
    let ok = vp(p, proof_words(), inputs())
    evm.emit(GasUsed { what: 3, gas: g0 - evm.gas() })
    assert(ok)
}

#[test]
fn vk_digest_exposed() uses (evm: mut Evm) {
    let p = deploy()
    let d: u256 = evm.call(addr: p, gas: 1000000, value: Wei::zero(), message: FixtureVerifierMsg::VkDigest {})
    assert(d == VK_DIGEST)
    assert(d == 0xa6eb817eb0ace229d3ec0aa7fac16d4627a795f56f96207b1d7a25cf2c184df7)
}

#[test]
fn tampered_commitment_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // every one of the 9 commitments replaced by the (valid) generator
    var i: usize = 0
    while i < 9 {
        var w = proof_words()
        w[2 * i] = 1
        w[2 * i + 1] = 2
        assert(!vp(p, w, inputs()))
        i += 1
    }
}

#[test]
fn tampered_evaluation_rejected() uses (evm: mut Evm) {
    let p = deploy()
    var i: usize = 0
    while i < 6 {
        var w = proof_words()
        w[18 + i] = (w[18 + i] + 1) % R
        assert(!vp(p, w, inputs()))
        i += 1
    }
}

