fn point_not_on_curve_rejected() uses (evm: mut Evm) {
    let p = deploy()
    let idx: [usize; 10] = [0, 2, 4, 6, 8, 10, 17, 20, 22, 25]
    var k: usize = 0
    while k < 10 {
        let i = idx[k]
