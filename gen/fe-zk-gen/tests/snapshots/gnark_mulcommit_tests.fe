fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<FixtureVerifier>(value: Wei::zero(), args: (), salt: 0)
}

fn vp(_ p: Address, _ w: [u256; 27], _ x: [u256; 2]) -> bool
uses (evm: mut Evm)
{
    vb(p, bytes_from_words(w), dyn_array_from(x))
}

fn vb(_ p: Address, _ proof: Bytes, _ x: Vec<u256>) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(addr: p, gas: 10000000, value: Wei::zero(), message: FixtureVerifierMsg::Verify { proof, public_inputs: x })
    r
}

#[test]
fn valid_proof_accepted() uses (evm: mut Evm) {
    let p = deploy()
    let g0 = evm.gas()
    let ok = vp(p, proof_words(), inputs())
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
}

#[test]
fn vk_digest_exposed() uses (evm: mut Evm) {
    let p = deploy()
    let d: u256 = evm.call(addr: p, gas: 1000000, value: Wei::zero(), message: FixtureVerifierMsg::VkDigest {})
    assert(d == VK_DIGEST)
    assert(d == 0x05c76285ee3ab0e8200a2028783538d5961c012385bb34c8569402eae50b4780)
}

#[test]
fn tampered_commitment_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // every proof commitment replaced by the (valid) generator
    let idx: [usize; 10] = [0, 2, 4, 6, 8, 10, 17, 20, 22, 25]
    var k: usize = 0
    while k < 10 {
        let i = idx[k]
        var w = proof_words()
        w[i] = 1
        w[i + 1] = 2
        assert(!vp(p, w, inputs()))
        k += 1
    }
}

#[test]
fn tampered_evaluation_rejected() uses (evm: mut Evm) {
    let p = deploy()
    let idx: [usize; 7] = [12, 13, 14, 15, 16, 19, 24]
    var k: usize = 0
    while k < 7 {
        let i = idx[k]
        var w = proof_words()
        w[i] = (w[i] + 1) % R
        assert(!vp(p, w, inputs()))
        k += 1
    }
}

#[test]
fn tampered_public_input_rejected() uses (evm: mut Evm) {
    let p = deploy()
    var i: usize = 0
    while i < 2 {
        var x = inputs()
        x[i] = x[i] + 1
        assert(!vp(p, proof_words(), x))
        i += 1
    }
}

#[test]
fn non_canonical_public_input_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // pub + r is the same residue: a verifier that reduces silently would accept it
    var i: usize = 0
    while i < 2 {
        var x = inputs()
        x[i] = x[i] + R
        assert(!vp(p, proof_words(), x))
        i += 1
    }
    var y = inputs()
    y[0] = R
    assert(!vp(p, proof_words(), y))
    var z = inputs()
    z[0] = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    assert(!vp(p, proof_words(), z))
}

#[test]
fn non_canonical_evaluation_rejected() uses (evm: mut Evm) {
    let p = deploy()
    let idx: [usize; 7] = [12, 13, 14, 15, 16, 19, 24]
    var k: usize = 0
    while k < 7 {
        let i = idx[k]
        var w = proof_words()
        w[i] = w[i] + R
        assert(!vp(p, w, inputs()))
        k += 1
    }
    var w = proof_words()
    w[12] = R
    assert(!vp(p, w, inputs()))
    w[12] = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    assert(!vp(p, w, inputs()))
}

#[test]
fn non_canonical_coordinate_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // same point, coordinates shifted by q
    let idx: [usize; 10] = [0, 2, 4, 6, 8, 10, 17, 20, 22, 25]
    var k: usize = 0
    while k < 10 {
        let i = idx[k]
        var w = proof_words()
        w[i] = w[i] + Q
        w[i + 1] = w[i + 1] + Q
        assert(!vp(p, w, inputs()))
        k += 1
    }
}

