    }
}

#[test]
fn infinity_commitment_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // gnark's byte encoding of infinity is not representable in the Solidity layout: refused
    let idx: [usize; 10] = [0, 2, 4, 6, 8, 10, 17, 20, 22, 25]
    var k: usize = 0
    while k < 10 {
        let i = idx[k]
        var w = proof_words()
        w[i] = 0
        w[i + 1] = 0
        assert(!vp(p, w, inputs()))
        k += 1
    }
}

#[test]
fn wrong_proof_length_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // exactly 27 words (864 bytes) are required: never truncated, never padded
    assert(!vb(p, bytes_from_words(proof_one_word_longer()), dyn_array_from(inputs())))
    assert(!vb(p, bytes_from_words(proof_one_word_shorter()), dyn_array_from(inputs())))
    assert(!vb(p, bytes_from_words_prefix<863, 27>(proof_words()), dyn_array_from(inputs())))
    assert(!vb(p, bytes_from_words_prefix<865, 28>(proof_one_word_longer()), dyn_array_from(inputs())))
    let nothing: [u256; 0] = []
    assert(!vb(p, bytes_from_words(nothing), dyn_array_from(inputs())))
}

#[test]
fn wrong_public_input_count_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // exactly 2 inputs are required: a caller can neither drop nor append one
    let more: [u256; 3] = [3, 22, 0]
    assert(!vb(p, bytes_from_words(proof_words()), dyn_array_from(more)))
    let fewer: [u256; 1] = [3]
    assert(!vb(p, bytes_from_words(proof_words()), dyn_array_from(fewer)))
}

#[test]
fn swapped_public_inputs_rejected() uses (evm: mut Evm) {
    let p = deploy()
    var x = inputs()
    let t = x[0]
    x[0] = x[1]
    x[1] = t
    assert(!vp(p, proof_words(), x))
}

