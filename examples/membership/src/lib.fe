//! Anonymous group membership with a Poseidon Merkle tree and a Groth16 proof (demo).
//!
//! * `insert(leaf)` appends `leaf = Poseidon(secret)` to an incremental tree of depth 10
//!   (Poseidon(2) per level, empty leaf = 0; same hashing as examples/membership/circuit).
//! * `prove(root, nullifierHash, externalNullifier, a, b, c)` checks, in this order: the root is
//!   a known historical root, the nullifier was not used, the proof verifies against the
//!   verifier generated by fe-zk-gen (public signals `[nullifierHash, root, externalNullifier]`).
//!   Then it records `nullifierHash`.
//!
//! Rule 8 (malleability): Groth16 proofs are malleable, so the proof (or its hash) is NEVER
//! stored or used as an id. Replay protection is the nullifier hash, a deterministic function
//! `Poseidon(secret, externalNullifier)` that the circuit binds to the secret.
//!
//! The demo is permissionless (anyone can insert); a real application would gate `insert`.
use fe_zk::{Bn254Fr, Field, poseidon_2}
use membership_verifier::MembershipVerifierMsg
use std::evm::{Address, Call, StorageMap}

pub const DEPTH: u256 = 10

msg GroupMsg {
    #[selector = sol("insert(uint256)")]
    Insert { leaf: u256 } -> u256,
    #[selector = sol("root()")]
    Root -> u256,
    #[selector = sol("isKnownRoot(uint256)")]
    IsKnownRoot { root: u256 } -> bool,
    #[selector = sol("nullifierUsed(uint256)")]
    NullifierUsed { nullifier_hash: u256 } -> bool,
    #[selector = sol(
        "prove(uint256,uint256,uint256,uint256[2],uint256[2][2],uint256[2])",
    )]
    Prove {
        root: u256,
        nullifier_hash: u256,
        external_nullifier: u256,
        a: [u256; 2],
        b: [[u256; 2]; 2],
        c: [u256; 2],
    } -> bool,
}

struct Store {
    verifier: Address,
    next_index: u256,
    root: u256,
    zeros: StorageMap<u256, u256>,
    filled: StorageMap<u256, u256>,
    roots: StorageMap<u256, bool>,
    nullifiers: StorageMap<u256, bool>,
}

fn fr(_ v: u256) -> Bn254Fr {
    // Reject non-canonical field elements: a leaf >= r would alias another leaf.
    Bn254Fr::from_canonical(v).unwrap()
}

fn hash2(_ l: u256, _ r: u256) -> u256 {
    poseidon_2(fr(l), fr(r)).to_canonical()
}

pub contract MembershipGroup {
    mut store: Store,

    /// `bootstrap_root` (0 = none) registers a root of an earlier tree (snapshot or previous
    /// deployment) as known, so proofs against it verify without re-inserting its leaves.
    init(verifier: Address, bootstrap_root: u256)
    uses (mut store)
    {
        store.verifier = verifier
        // zeros[i] = root of an empty subtree of height i
        var z: u256 = 0
        var i: u256 = 0
        while i < DEPTH {
            store.zeros[i] = z
            z = hash2(z, z)
            i += 1
        }
        store.root = z
        store.roots[z] = true
        if bootstrap_root != 0 {
            store.roots[bootstrap_root] = true
        }
    }

    recv GroupMsg {
        Insert { leaf } -> u256 uses (mut store) {
            let index = store.next_index
            assert(index < 1024)
            var idx = index
            var cur = leaf
            var level: u256 = 0
            while level < DEPTH {
                if idx % 2 == 0 {
                    store.filled[level] = cur
                    cur = hash2(cur, store.zeros[level])
                } else {
                    cur = hash2(store.filled[level], cur)
                }
                idx = idx / 2
                level += 1
            }
            store.next_index = index + 1
            store.root = cur
            store.roots[cur] = true
            index
        }

        Root -> u256 uses (store) {
            store.root
        }

        IsKnownRoot { root } -> bool uses (store) {
            store.roots[root]
        }

        NullifierUsed { nullifier_hash } -> bool uses (store) {
            store.nullifiers[nullifier_hash]
        }

        Prove { root, nullifier_hash, external_nullifier, a, b, c } -> bool
        uses (mut store, call: Call)
        {
            assert(store.roots[root])
            assert(!store.nullifiers[nullifier_hash])
            let ok: bool = store
                .verifier
                .static(
                    MembershipVerifierMsg::VerifyProof {
                        a: a,
                        b: b,
                        c: c,
                        input: [nullifier_hash, root, external_nullifier],
                    },
                )
            assert(ok)
            store.nullifiers[nullifier_hash] = true
            true
        }
    }
}
