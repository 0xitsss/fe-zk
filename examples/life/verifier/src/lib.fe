pub msg Life512VerifierMsg {
    #[selector = sol(
        "verifyProof(uint256[2],uint256[2][2],uint256[2],uint256[2])",
    )]
    VerifyProof { a: [u256; 2], b: [[u256; 2]; 2], c: [u256; 2], input: [u256; 2] } -> bool,
    #[selector = sol("vkDigest()")]
    VkDigest -> u256,
}

pub contract Life512Verifier {
    recv Life512VerifierMsg {
        VerifyProof { a, b, c, input } -> bool uses (call: Call, ctx: Ctx) {
            // calldata b = [[x_imag, x_real], [y_imag, y_real]]; the library wants real first
