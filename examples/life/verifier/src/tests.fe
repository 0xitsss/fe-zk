fn vp(_ p: Address, _ a: [u256; 2], _ b: [[u256; 2]; 2], _ c: [u256; 2], _ x: [u256; 2]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(
            addr: p,
            gas: 10000000,
            value: Wei::zero(),
            message: Life512VerifierMsg::VerifyProof { a: a, b: b, c: c, input: x },
