//! Game of Life on a 16x16 torus packed into one u256 (see board.fe for the bit layout).
//!
//! `Life` has pure messages (`step`, `run`: no storage effect) and a stateful variant
//! (`set`, `advance`, `board`) where only the storage-touching handlers declare `uses (mut store)`.
//!
//! zk path: `proveRun` / `advanceProven` check a Groth16 proof (verifier generated by fe-zk-gen
//! from examples/life/circuit/life.circom, `PROVEN_GENERATIONS` generations, public signals
//! `[startCommit, endCommit]`, each `Poseidon(lo128, hi128)` of a packed board, circomlib Poseidon(2)).
//! `advanceProven` recomputes both commitments on chain from the stored board and the claimed end
//! board, so one proof advances the stored board by `PROVEN_GENERATIONS` steps at constant gas.
//! Caveat: the board is public in storage, so this demo shows succinctness, not hiding; the
//! circuit itself keeps the start board private. Groth16 proofs are malleable and are never stored
//! or used as ids here.

use fe_zk::{Bn254Fr, Field, poseidon_2}
use life512_verifier::Life512VerifierMsg
use std::evm::{Address, Call}

pub use board::{step, step_n}

/// Generations covered by one proof (fixed by the circuit, hence by the verifying key).
pub const PROVEN_GENERATIONS: u256 = 512
const HALF: u256 = 0x100000000000000000000000000000000

msg LifeMsg {
    #[selector = sol("step(uint256)")]
    Step { board: u256 } -> u256,
    #[selector = sol("run(uint256,uint256)")]
    Run { board: u256, n: u256 } -> u256,
    #[selector = sol("set(uint256)")]
    Set { board: u256 },
    #[selector = sol("advance(uint256)")]
    Advance { n: u256 } -> u256,
    #[selector = sol("board()")]
    Board -> u256,
    #[selector = sol("setCommitted(uint256,uint256)")]
    SetCommitted { lo: u256, hi: u256 },
    #[selector = sol("commitment()")]
    Commitment -> u256,
    #[selector = sol("provenGenerations()")]
    ProvenGenerations -> u256,
    #[selector = sol(
        "proveRun(uint256,uint256,uint256[2],uint256[2][2],uint256[2])",
    )]
    ProveRun {
        start_commit: u256,
        end_commit: u256,
        a: [u256; 2],
        b: [[u256; 2]; 2],
        c: [u256; 2],
    } -> bool,
    #[selector = sol(
        "advanceProven(uint256,uint256,uint256[2],uint256[2][2],uint256[2])",
    )]
    AdvanceProven {
        end_lo: u256,
        end_hi: u256,
        a: [u256; 2],
        b: [[u256; 2]; 2],
        c: [u256; 2],
    } -> u256,
}

struct LifeStore { board: u256, verifier: Address }

/// Poseidon(lo, hi) over BN254 Fr of a board's 128-bit halves (same as the circuit's commitment).
/// Halves are < 2^128 < r, so they are canonical field elements.
fn commit_halves(_ lo: u256, _ hi: u256) -> u256 {
    assert(lo < HALF)
    assert(hi < HALF)
    poseidon_2(
        Bn254Fr::from_canonical(lo).unwrap(),
        Bn254Fr::from_canonical(hi).unwrap(),
    )
        .to_canonical()
}

fn commit_board(_ board: u256) -> u256 {
    commit_halves(board % HALF, board / HALF)
}

pub contract Life {
    mut store: LifeStore,

    /// `verifier` is the deployed fe-zk-gen verifier of the zk path (unused by the pure messages).
    init(verifier: Address)
    uses (mut store)
    {
        store.board = 0
        store.verifier = verifier
    }

    recv LifeMsg {
        Step { board } -> u256 {
            step(board)
        }

        Run { board, n } -> u256 {
            step_n(board, n)
        }

        Set { board } uses (mut store) {
            store.board = board
        }

        Advance { n } -> u256 uses (mut store) {
            store.board = step_n(store.board, n)
            store.board
        }

        Board -> u256 uses (store) {
            store.board
        }

        SetCommitted { lo, hi } uses (mut store) {
            assert(lo < HALF)
            assert(hi < HALF)
            store.board = lo + hi * HALF
        }

        Commitment -> u256 uses (store) {
            commit_board(store.board)
        }

        ProvenGenerations -> u256 {
            PROVEN_GENERATIONS
        }

        ProveRun { start_commit, end_commit, a, b, c } -> bool
        uses (store, call: Call)
        {
            store
                .verifier
                .static(
                    Life512VerifierMsg::VerifyProof {
                        a: a,
                        b: b,
                        c: c,
                        input: [start_commit, end_commit],
                    },
                )
        }

        AdvanceProven { end_lo, end_hi, a, b, c } -> u256
        uses (mut store, call: Call)
        {
            let start_commit = commit_board(store.board)
            let end_commit = commit_halves(end_lo, end_hi)
            let ok: bool = store
                .verifier
                .static(
                    Life512VerifierMsg::VerifyProof {
                        a: a,
                        b: b,
                        c: c,
                        input: [start_commit, end_commit],
                    },
                )
            assert(ok)
            store.board = end_lo + end_hi * HALF
            store.board
        }
    }
}
