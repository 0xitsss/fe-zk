//! GENERATED by vectors/tornado/gen_fe_tests.py -- do not edit.
//! Real `withdraw` proofs of the Tornado Cash classic 0.1 ETH pool, taken from Ethereum mainnet transactions
//! (hashes in vectors/tornado/txs.txt). Verdicts must equal the deployed Verifier.sol's.
use super::*
use std::evm::{Address, Evm}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<TornadoVerifier>(value: Wei::zero(), args: (), salt: 0)
}

fn vp(_ p: Address, _ a: [u256; 2], _ b: [[u256; 2]; 2], _ c: [u256; 2], _ x: [u256; 6]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(
            addr: p,
            gas: 10000000,
            value: Wei::zero(),
            message: TornadoVerifierMsg::VerifyProof { a: a, b: b, c: c, input: x },
        )
    r
}

