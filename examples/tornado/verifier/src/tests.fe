fn point_not_on_curve_rejected() uses (evm: mut Evm) {
    let p = deploy()
    assert(!vp(p, [A0, A1 + 1], good_b(), [C0, C1], inputs()))
    assert(!vp(p, [A0, A1], good_b(), [C0, C1 + 1], inputs()))
    assert(
        !vp(
