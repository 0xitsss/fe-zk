fn is_point_word(_ i: usize) -> bool {
    i < EVAL_START || i >= OPEN_START
}
fn is_x_word(_ i: usize) -> bool {
    if i < EVAL_START {
        i % 2 == 0
    } else {
        i >= OPEN_START && (i - OPEN_START) % 2 == 0
    }
}

fn deploy_shplonk() -> Address uses (evm: mut Evm) {
    evm.create2<Halo2CircuitShplonkVerifier>(value: Wei::zero(), args: (), salt: 0)
}

fn vs(_ p: Address, _ pr: [u256; 57], _ x: [u256; 1]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(
            addr: p,
            gas: 20000000,
            value: Wei::zero(),
            message: Halo2CircuitShplonkVerifierMsg::VerifyShplonk { proof: pr, instances: x },
        )
    r
}

fn deploy_gwc() -> Address uses (evm: mut Evm) {
    evm.create2<Halo2CircuitGwcVerifier>(value: Wei::zero(), args: (), salt: 0)
}

fn vg(_ p: Address, _ pr: [u256; 61], _ x: [u256; 1]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(
            addr: p,
            gas: 20000000,
            value: Wei::zero(),
            message: Halo2CircuitGwcVerifierMsg::VerifyGwc { proof: pr, instances: x },
        )
    r
}

#[test]
fn shplonk_vk_digest_exposed() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    let d: u256 = evm
        .call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: Halo2CircuitShplonkVerifierMsg::VkDigest {},
        )
    assert(d == VK_DIGEST)
    assert(
        d == 0x6eb34121a1280702ea74e5b4261e37f37ad6c2f3a82cb545477aed4d2b7700ed,
    )
}

#[test]
fn shplonk_valid_proof_accepted() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    let g0 = evm.gas()
    let ok = vs(p, SHPLONK_PROOF, SHPLONK_INSTANCES)
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    assert(ok)
}

#[test]
fn shplonk_wrong_instance_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    assert(!vs(p, SHPLONK_PROOF, [SHPLONK_INSTANCES[0] + 1]))
    assert(!vs(p, SHPLONK_PROOF, [0]))
}

#[test]
fn shplonk_non_canonical_instance_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    // value + r is the same residue: rejected, never reduced
    assert(!vs(p, SHPLONK_PROOF, [SHPLONK_INSTANCES[0] + R]))
    assert(!vs(p, SHPLONK_PROOF, [R]))
    assert(
        !vs(
            p,
            SHPLONK_PROOF,
            [0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff],
        ),
    )
}

#[test]
fn shplonk_every_word_plus_one_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    var i: usize = 0
    while i < 57 {
        var pr = SHPLONK_PROOF
        pr[i] = pr[i] + 1
        assert(!vs(p, pr, SHPLONK_INSTANCES))
        i += 1
    }
}

#[test]
fn shplonk_non_canonical_words_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    // every word shifted by its modulus (q for coordinates, r for scalars): same residue, not canonical
    var i: usize = 0
    while i < 57 {
        var pr = SHPLONK_PROOF
        if is_point_word(i) {
            pr[i] = pr[i] + Q
        } else {
            pr[i] = pr[i] + R
        }
        assert(!vs(p, pr, SHPLONK_INSTANCES))
        i += 1
    }
}

#[test]
fn shplonk_off_curve_points_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    var i: usize = 0
    while i < 57 {
        if is_x_word(i) {
            var pr = SHPLONK_PROOF
            pr[i + 1] = pr[i + 1] + 1
            assert(!vs(p, pr, SHPLONK_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn shplonk_infinity_points_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    // halo2's EvmTranscript rejects the point at infinity
    var i: usize = 0
    while i < 57 {
        if is_x_word(i) {
            var pr = SHPLONK_PROOF
            pr[i] = 0
            pr[i + 1] = 0
            assert(!vs(p, pr, SHPLONK_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn shplonk_negated_points_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    var i: usize = 0
    while i < 57 {
        if is_x_word(i) {
            var pr = SHPLONK_PROOF
            pr[i + 1] = Q - pr[i + 1]
            assert(!vs(p, pr, SHPLONK_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn shplonk_swapped_commitments_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    var pr = SHPLONK_PROOF
    let x0 = pr[0]
    let y0 = pr[1]
    pr[0] = pr[2]
    pr[1] = pr[3]
    pr[2] = x0
    pr[3] = y0
    assert(!vs(p, pr, SHPLONK_INSTANCES))
}

#[test]
fn shplonk_proof_of_other_scheme_rejected() uses (evm: mut Evm) {
    let p = deploy_shplonk()
    // the other scheme's proof words, resized to this scheme's length, never verify
    var pr = SHPLONK_PROOF
    var i: usize = 0
    while i < 57 {
        pr[i] = GWC_PROOF[i % 61]
        i += 1
    }
    assert(!vs(p, pr, SHPLONK_INSTANCES))
}

#[test]
fn gwc_vk_digest_exposed() uses (evm: mut Evm) {
    let p = deploy_gwc()
    let d: u256 = evm
        .call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: Halo2CircuitGwcVerifierMsg::VkDigest {},
        )
    assert(d == VK_DIGEST)
    assert(
        d == 0x6eb34121a1280702ea74e5b4261e37f37ad6c2f3a82cb545477aed4d2b7700ed,
    )
}

#[test]
fn gwc_valid_proof_accepted() uses (evm: mut Evm) {
    let p = deploy_gwc()
    let g0 = evm.gas()
    let ok = vg(p, GWC_PROOF, GWC_INSTANCES)
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
}

#[test]
fn gwc_wrong_instance_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    assert(!vg(p, GWC_PROOF, [GWC_INSTANCES[0] + 1]))
    assert(!vg(p, GWC_PROOF, [0]))
}

#[test]
fn gwc_non_canonical_instance_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    // value + r is the same residue: rejected, never reduced
    assert(!vg(p, GWC_PROOF, [GWC_INSTANCES[0] + R]))
    assert(!vg(p, GWC_PROOF, [R]))
    assert(
        !vg(
            p,
            GWC_PROOF,
            [0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff],
        ),
    )
}

#[test]
fn gwc_every_word_plus_one_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    var i: usize = 0
    while i < 61 {
        var pr = GWC_PROOF
        pr[i] = pr[i] + 1
        assert(!vg(p, pr, GWC_INSTANCES))
        i += 1
    }
}

#[test]
fn gwc_non_canonical_words_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    // every word shifted by its modulus (q for coordinates, r for scalars): same residue, not canonical
    var i: usize = 0
    while i < 61 {
        var pr = GWC_PROOF
        if is_point_word(i) {
            pr[i] = pr[i] + Q
        } else {
            pr[i] = pr[i] + R
        }
        assert(!vg(p, pr, GWC_INSTANCES))
        i += 1
    }
}

#[test]
fn gwc_off_curve_points_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    var i: usize = 0
    while i < 61 {
        if is_x_word(i) {
            var pr = GWC_PROOF
            pr[i + 1] = pr[i + 1] + 1
            assert(!vg(p, pr, GWC_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn gwc_infinity_points_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    // halo2's EvmTranscript rejects the point at infinity
    var i: usize = 0
    while i < 61 {
        if is_x_word(i) {
            var pr = GWC_PROOF
            pr[i] = 0
            pr[i + 1] = 0
            assert(!vg(p, pr, GWC_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn gwc_negated_points_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    var i: usize = 0
    while i < 61 {
        if is_x_word(i) {
            var pr = GWC_PROOF
            pr[i + 1] = Q - pr[i + 1]
            assert(!vg(p, pr, GWC_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn gwc_swapped_commitments_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    var pr = GWC_PROOF
    let x0 = pr[0]
    let y0 = pr[1]
    pr[0] = pr[2]
    pr[1] = pr[3]
    pr[2] = x0
    pr[3] = y0
    assert(!vg(p, pr, GWC_INSTANCES))
}

#[test]
fn gwc_proof_of_other_scheme_rejected() uses (evm: mut Evm) {
    let p = deploy_gwc()
    // the other scheme's proof words, resized to this scheme's length, never verify
    var pr = GWC_PROOF
    var i: usize = 0
    while i < 61 {
        pr[i] = SHPLONK_PROOF[i % 57]
        i += 1
    }
    assert(!vg(p, pr, GWC_INSTANCES))
}

/// The key constants pass the full checks of the library (canonical, on curve, G2 subgroup),
/// also at runtime.
#[test]
fn vk_constants_pass_full_checks() {
    assert(G1::from_coords(SRS_G1_X, SRS_G1_Y).is_some())
    assert(
        G2::from_coords(SRS_G2_X0, SRS_G2_X1, SRS_G2_Y0, SRS_G2_Y1).is_some(),
    )
    assert(
        G2::from_coords(SRS_S_G2_X0, SRS_S_G2_X1, SRS_S_G2_Y0, SRS_S_G2_Y1).is_some(),
    )
    assert(G1::from_coords(FX0_X, FX0_Y).is_some())
    assert(G1::from_coords(FX1_X, FX1_Y).is_some())
    assert(G1::from_coords(FX2_X, FX2_Y).is_some())
    assert(G1::from_coords(FX3_X, FX3_Y).is_some())
    assert(G1::from_coords(FX4_X, FX4_Y).is_some())
    assert(G1::from_coords(FX5_X, FX5_Y).is_some())
    assert(G1::from_coords(FX6_X, FX6_Y).is_some())
    assert(G1::from_coords(FX7_X, FX7_Y).is_some())
    assert(G1::from_coords(SG0_X, SG0_Y).is_some())
    assert(G1::from_coords(SG1_X, SG1_Y).is_some())
    assert(G1::from_coords(SG2_X, SG2_Y).is_some())
    assert(G1::from_coords(SG3_X, SG3_Y).is_some())
}

/// What `static_assert` rejects at compile time, checked at runtime: each of these constants
/// would make the generated verifier fail to compile.
#[test]
fn invalid_keys_fail_the_compile_time_checks() {
    assert(!g2_is_valid(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1))
    assert(
        !g2_is_valid(SRS_S_G2_X0, SRS_S_G2_X1, SRS_S_G2_Y0, SRS_S_G2_Y1 + 1),
    )
    assert(
        !g2_is_valid(SRS_G2_X0 + Q, SRS_G2_X1, SRS_G2_Y0, SRS_G2_Y1),
    )
    assert(!g1_is_valid(SG0_X, SG0_Y + 1))
    assert(!g1_is_valid(SG0_X + Q, SG0_Y))
    assert(!g1_is_valid(SRS_G1_X, SRS_G1_Y + 1))
}

#[test]
fn vk_construction_gas() uses (evm: mut Evm) {
    let g0 = evm.gas()
    let k = vk()
    evm.emit(GasUsed { what: 0, gas: g0 - evm.gas() })
    assert(k.g1().x() == 1)
}
