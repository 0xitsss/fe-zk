//! Reference values: snarkjs proof in vectors/groth16/multiplier2 (public inputs [33, 3]);
//! Poseidon(1, 2) from circomlibjs (vectors/poseidon/poseidon.json).
use super::{Gate, GateMsg, horner}
use fe_zk::{Bn254Fr, Field, KoalaBear}
use multiplier2_verifier::Multiplier2Verifier
use std::evm::{Address, Evm}

const A0: u256 = 7448169393390896365717508977079948665922164597790969091221782932347809683962
const A1: u256 = 856045400059498295244774248674336299011578222471765182142698656190995343630
// calldata (EVM) order: [[x_imag, x_real], [y_imag, y_real]]
const BX_IMAG: u256 = 19218880711464147920097216256888416352504874737662349918493822731203259458251
const BX_REAL: u256 = 10128683618413140045832818953114530727358033116612254975979393217023646851938
const BY_IMAG: u256 = 10619580949012590390672218647453077680869449321532047878779645275033390063317
const BY_REAL: u256 = 2514235191151238097241823538264318835446406500039375754258699347627251407100
const C0: u256 = 6485723789840182790847565595236775070775044884799420435840409733046332409240
const C1: u256 = 541881383159464474220678934842776834622831092755233222115972544615651141303

fn deploy() -> Address uses (evm: mut Evm) {
    let v = evm.create2<Multiplier2Verifier>(value: Wei::zero(), args: (), salt: 0)
    evm.create2<Gate>(value: Wei::zero(), args: (v,), salt: 1)
}

fn check(_ g: Address, _ a0: u256, _ x: [u256; 2]) -> bool uses (evm: mut Evm) {
    let r: bool = evm
        .call(
            addr: g,
            gas: 10000000,
            value: Wei::zero(),
            message: GateMsg::Check {
                a: [a0, A1],
                b: [[BX_IMAG, BX_REAL], [BY_IMAG, BY_REAL]],
                c: [C0, C1],
                input: x,
            },
        )
    r
}

#[test]
fn valid_proof_accepted() uses (evm: mut Evm) {
    let g = deploy()
    assert(check(g, A0, [33, 3]))
}

#[test]
fn tampered_proof_and_input_rejected() uses (evm: mut Evm) {
    let g = deploy()
    assert(!check(g, A0 + 1, [33, 3]))
    assert(!check(g, A0, [34, 3]))
}

#[test]
fn poseidon_matches_circomlibjs() uses (evm: mut Evm) {
    let g = deploy()
    let h: u256 = evm
        .call(
            addr: g,
            gas: 10000000,
            value: Wei::zero(),
            message: GateMsg::Commit { value: 1, salt: 2 },
        )
    assert(
        h == 7853200120776062878684798364095072458815029376092732009249414926327459813530,
    )
}

#[test]
fn horner_is_generic_over_fields() {
    // 1 + 2x + 3x^2 at x = 5 is 86, in two different fields, same code.
    let a = horner(
        [Bn254Fr::reduce(1), Bn254Fr::reduce(2), Bn254Fr::reduce(3)],
        Bn254Fr::reduce(5),
    )
    assert(a.to_canonical() == 86)
    let b = horner(
        [KoalaBear::reduce(1), KoalaBear::reduce(2), KoalaBear::reduce(3)],
        KoalaBear::reduce(5),
    )
    assert(b.to_canonical() == 86)
    // wrap-around is per field: x = p - 1 gives 1 - 2 + 3 = 2 (mod p)
    let m = horner(
        [KoalaBear::reduce(1), KoalaBear::reduce(2), KoalaBear::reduce(3)],
        KoalaBear::reduce(KoalaBear::MODULUS - 1),
    )
    assert(m.to_canonical() == 2)
}
