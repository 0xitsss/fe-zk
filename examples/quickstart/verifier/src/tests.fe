#[test]
fn valid_proof_accepted() uses (evm: mut Evm) {
    let p = deploy()
    let g0 = evm.gas()
    let ok = vp(p, [A0, A1], good_b(), [C0, C1], inputs())
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
}

#[test]
fn vk_digest_exposed() uses (evm: mut Evm) {
    let p = deploy()
    let d: u256 = evm
        .call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: Multiplier2VerifierMsg::VkDigest {},
        )
    assert(d == VK_DIGEST)
    assert(
        d == 0x8c6d19843267a294fe81da838e7361fcdeb6bb3c96ade60053affbfa8d309fcc,
    )
}

#[test]
fn tampered_a_rejected() uses (evm: mut Evm) {
    let p = deploy()
    assert(!vp(p, [1, 2], good_b(), [C0, C1], inputs()))
    assert(!vp(p, [A0, Q - A1], good_b(), [C0, C1], inputs()))
}

#[test]
fn tampered_b_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // the G2 generator is a valid point of the right group but the wrong proof element
    let g = G2::generator()
    let gb: [[u256; 2]; 2] = [[g.x1(), g.x0()], [g.y1(), g.y0()]]
    assert(!vp(p, [A0, A1], gb, [C0, C1], inputs()))
}

#[test]
fn tampered_c_rejected() uses (evm: mut Evm) {
    let p = deploy()
    assert(!vp(p, [A0, A1], good_b(), [1, 2], inputs()))
    assert(!vp(p, [A0, A1], good_b(), [0, 0], inputs()))
}

#[test]
fn tampered_public_input_rejected() uses (evm: mut Evm) {
    let p = deploy()
    var x = inputs()
    x[0] = x[0] + 1
    assert(!vp(p, [A0, A1], good_b(), [C0, C1], x))
}

#[test]
fn non_canonical_public_input_rejected() uses (evm: mut Evm) {
    let p = deploy()
    // r itself and x + r (same residue mod r) must be rejected, never reduced
    var x = inputs()
    x[0] = R
    assert(!vp(p, [A0, A1], good_b(), [C0, C1], x))
    var y = inputs()
    y[0] = y[0] + R
    assert(!vp(p, [A0, A1], good_b(), [C0, C1], y))
    var z = inputs()
    z[0] = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    assert(!vp(p, [A0, A1], good_b(), [C0, C1], z))
}

