/// The key constants pass the full checks of the library (canonical, on curve, G2 subgroup).
#[test]
fn vk_constants_pass_full_checks() {
    assert(G1::from_coords(ALPHA_X, ALPHA_Y).is_some())
    assert(
        G2::from_coords(BETA_X0, BETA_X1, BETA_Y0, BETA_Y1).is_some(),
    )
    assert(
        G2::from_coords(GAMMA_X0, GAMMA_X1, GAMMA_Y0, GAMMA_Y1).is_some(),
    )
    assert(
        G2::from_coords(DELTA_X0, DELTA_X1, DELTA_Y0, DELTA_Y1).is_some(),
    )
    assert(G1::from_coords(IC0_X, IC0_Y).is_some())
    assert(G1::from_coords(IC1_X, IC1_Y).is_some())
    assert(G1::from_coords(IC2_X, IC2_Y).is_some())
    assert(G1::from_coords(IC3_X, IC3_Y).is_some())
    assert(G1::from_coords(IC4_X, IC4_Y).is_some())
}
