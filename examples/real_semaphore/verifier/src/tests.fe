fn vp(_ p: Address, _ a: [u256; 2], _ b: [[u256; 2]; 2], _ c: [u256; 2], _ x: [u256; 4]) -> bool
uses (evm: mut Evm)
{
    let r: bool = evm
        .call(
            addr: p,
            gas: 10000000,
            value: Wei::zero(),
            message: RealSemaphoreVerifierMsg::VerifyProof { a: a, b: b, c: c, input: x },
        )
    r
}

