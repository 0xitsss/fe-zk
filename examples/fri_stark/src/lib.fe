//! Deployable FRI/STARK verifier contract: checks a Plonky3 `p3-uni-stark` proof of the
//! Fibonacci AIR (`fib(0, 1, ..) = x` after 2^10 rows, public values `(a, b, x)`) for the secure
//! configuration `fe_zk::verifier::fri::config_secure` (KoalaBear, degree-4 extension, FRI arity 2,
//! `log_blowup = 4`, 20 queries, 20 bits of query proof of work: 100 conjectured bits).
//!
//! The call is `verify(uint256[],uint256[3])`: the proof as flat words in the layout documented
//! in `verifier/fri.fe`, then the 3 public values, standard ABI encoding (head: the offset of the
//! proof, which must be `0x80`, and the 3 public values; tail: the proof length and words). The
//! proof length is not one constant since Plonky3 0.8 prunes the Merkle multi-openings: the proof
//! declares its sibling counts and `verify` checks the length against them (safety rule 4); the
//! contract only bounds it by `MAX_PROOF_WORDS` and requires the calldata to be exactly the
//! encoding of that length. The words are copied from calldata into a `MemArray<u256>` (a typed
//! static array would not compile in reasonable time with Fe 26.5.0: `docs/DESIGN.md`, "FRI/STARK
//! verifier"). Canonicity, transcript, Merkle multi-openings, proof of work, folding, final
//! polynomial and the AIR check at the out-of-domain point all run inside `verify`. The contract
//! is pure: it reads no storage. Runtime code size is checked by `scripts/code-size.sh`.
use core::abi::ByteSource
use core::ptr::{MemArray, cast}
use std::evm::CallData
use fe_zk::verifier::fri::config_secure::{MAX_PROOF_WORDS, verify}

msg FriMsg {
    // selector of verify(uint256[],uint256[3]) (keccak256 of the signature): a typed signature
    // would need typed fields
    #[selector = 0xc969d25e]
    Verify -> bool,
}

pub contract FriFibVerifier {
    recv FriMsg {
        Verify {} -> bool {
            let cd = CallData::with_base(4)
            let size = cd.size() as u256
            // head: offset of the proof (4 words of head), 3 public values; tail: length, words
            if size < 160 || cd.word_at(0) != 128 {
                return false
            }
            let n = cd.word_at(128)
            if n > (MAX_PROOF_WORDS as u256) || size != 160 + 32 * n {
                return false
            }
            var proof = unsafe {
                MemArray<u256>::new_uninit(n as usize)
            }
            // one calldatacopy of the whole proof (the size was checked above)
            unsafe {
                cd.copy_to_memory(dest: cast<u256, u8>(proof.ptr()), src_offset: 160, len: 32 * n)
            }
            verify(proof, [cd.word_at(32), cd.word_at(64), cd.word_at(96)])
        }
    }
}
