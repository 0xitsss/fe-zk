const NUL_OUTSIDER_OPTION1: u256 = 10082525428190618137519116013349141182803247234029511855925950879920891841118
const MSG_OUTSIDER_OPTION1: u256 = 1

msg StrangerMsg {
    #[selector = sol("poke(address,uint256)")]
    Poke { target: Address, commitment: u256 } -> bool,
}

/// A second account: calls `VoteMsg::Register` from an address that is not the owner.
pub contract Stranger uses (call: mut Call) {
    recv StrangerMsg {
        Poke { target, commitment } -> bool uses (mut call) {
            target.try_call(VoteMsg::Register { commitment: commitment }).success()
        }
    }
}

fn stranger_registers(_ p: Address, _ c: u256) -> bool uses (evm: mut Evm) {
    let s = evm.create2<Stranger>(value: Wei::zero(), args: (), salt: 7)
    evm.call(
        addr: s,
        gas: 10000000,
        value: Wei::zero(),
        message: StrangerMsg::Poke { target: p, commitment: c },
    )
}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<AnonVote>(value: Wei::zero(), args: (SCOPE, OPTIONS), salt: 0)
}

fn register(_ p: Address, _ c: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: p,
        gas: 10000000,
        value: Wei::zero(),
        message: VoteMsg::Register { commitment: c },
    )
        .success()
}

/// Poll with all three voters registered (same order as the proofs' group).
fn setup() -> Address uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    assert(register(p, ms[0]))
    assert(register(p, ms[1]))
    assert(register(p, ms[2]))
    let root: u256 = evm.call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: VoteMsg::Root {},
        )
    assert(root == ROOT)
    p
}

fn vote(
    _ p: Address,
    _ option: u256,
    _ depth: u256,
    _ root: u256,
    _ nul: u256,
    _ pts: [u256; 8],
) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: p,
        gas: 30000000,
        value: Wei::zero(),
        message: VoteMsg::Vote {
            option: option,
            merkle_tree_depth: depth,
            merkle_tree_root: root,
            nullifier: nul,
            points: pts,
        },
    )
        .success()
}

fn tally(_ p: Address, _ option: u256) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: p,
        gas: 1000000,
        value: Wei::zero(),
        message: VoteMsg::Tally { option: option },
    )
}

#[test]
fn vote_flow_counts_each_member_once() uses (evm: mut Evm) {
    let p = setup()
    let g0 = evm.gas()
    let ok = vote(
        p,
        MSG_A_OPTION1,
        DEPTH,
        ROOT,
        NUL_A_OPTION1,
        pts_a_option1(),
    )
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    assert(ok)
    assert(tally(p, 1) == 1)
    assert(
        vote(
            p,
            MSG_B_OPTION2,
            DEPTH,
            ROOT,
            NUL_B_OPTION2,
            pts_b_option2(),
        ),
    )
    assert(tally(p, 1) == 1)
    assert(tally(p, 2) == 1)
    assert(tally(p, 0) == 0)
}

#[test]
fn same_member_twice_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(
        vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    // the same proof again
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    // a different, valid proof of the same member for another option: same scope, same nullifier
    assert(NUL_A_OPTION2 == NUL_A_OPTION1)
    assert(
        !vote(
            p,
            MSG_A_OPTION2,
            DEPTH,
            ROOT,
            NUL_A_OPTION2,
            pts_a_option2(),
        ),
    )
    assert(tally(p, 1) == 1)
    assert(tally(p, 2) == 0)
}

#[test]
fn front_run_with_other_option_rejected() uses (evm: mut Evm) {
    let p = setup()
    // an attacker copies A's pending proof (option 1) and swaps the option
    assert(!vote(p, 2, DEPTH, ROOT, NUL_A_OPTION1, pts_a_option1()))
    assert(!vote(p, 0, DEPTH, ROOT, NUL_A_OPTION1, pts_a_option1()))
    assert(tally(p, 2) == 0)
    // the failed attempts burned nothing: A's own vote still goes through, for option 1
    assert(
        vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    assert(tally(p, 1) == 1)
}

#[test]
fn unknown_root_and_outsider_rejected() uses (evm: mut Evm) {
    let p = setup()
    // a valid proof for a group this poll does not have
    assert(
        !vote(
            p,
            MSG_OUTSIDER_OPTION1,
            DEPTH,
            7074717169226336456945489906914855256590406220541831409696599987455254140894,
            NUL_OUTSIDER_OPTION1,
            pts_outsider_option1(),
        ),
    )
    // the same proof claiming the poll's root
    assert(
        !vote(
            p,
            MSG_OUTSIDER_OPTION1,
            DEPTH,
            ROOT,
            NUL_OUTSIDER_OPTION1,
            pts_outsider_option1(),
        ),
    )
    assert(tally(p, 1) == 0)
}

#[test]
fn root_before_registration_rejected() uses (evm: mut Evm) {
    // only two of the three voters are registered: ROOT is not (yet) a root of this poll
    let p = deploy()
    let ms = members()
    assert(register(p, ms[0]))
    assert(register(p, ms[1]))
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    // after the third registration the same proof is accepted
    assert(register(p, ms[2]))
    assert(
        vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
}

#[test]
fn option_out_of_range_rejected() uses (evm: mut Evm) {
    let p = setup()
    // a valid proof for option 9 of a poll with 4 options
    assert(MSG_A_OPTION9 == 9)
    assert(
        !vote(
            p,
            MSG_A_OPTION9,
            DEPTH,
            ROOT,
            NUL_A_OPTION9,
            pts_a_option9(),
        ),
    )
    assert(tally(p, 9) == 0)
}

#[test]
fn option_nine_accepted_when_poll_has_ten_options() uses (evm: mut Evm) {
    // control of the test above: the same proof is fine once option 9 exists
    let p = evm.create2<AnonVote>(value: Wei::zero(), args: (SCOPE, 10), salt: 5)
    let ms = members()
    assert(register(p, ms[0]))
    assert(register(p, ms[1]))
    assert(register(p, ms[2]))
    assert(
        vote(
            p,
            MSG_A_OPTION9,
            DEPTH,
            ROOT,
            NUL_A_OPTION9,
            pts_a_option9(),
        ),
    )
    assert(tally(p, 9) == 1)
}

#[test]
fn wrong_depth_nullifier_or_points_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH + 1,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    assert(
        !vote(p, MSG_A_OPTION1, 0, ROOT, NUL_A_OPTION1, pts_a_option1()),
    )
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            11,
            ROOT,
            NUL_A_OPTION1,
            pts_a_option1(),
        ),
    )
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1 + 1,
            pts_a_option1(),
        ),
    )
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            pts_b_option2(),
        ),
    )
    assert(
        !vote(
            p,
            MSG_A_OPTION1,
            DEPTH,
            ROOT,
            NUL_A_OPTION1,
            [0, 0, 0, 0, 0, 0, 0, 0],
        ),
    )
    assert(tally(p, 1) == 0)
}

#[test]
fn register_guards() uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    // only the owner registers voters
    assert(!stranger_registers(p, ms[0]))
    assert(register(p, ms[0]))
    // no duplicates, no zero, no non-canonical commitment (it would alias another one)
    assert(!register(p, ms[0]))
    assert(!register(p, 0))
    assert(!register(p, ms[1] + R))
    assert(register(p, ms[1]))
}

#[test]
fn group_capacity_is_32_members() uses (evm: mut Evm) {
    // verify_proof_low has no key above depth 5: the 33rd member would never be able to prove
    let p = deploy()
    var i: u256 = 1
    while i <= 32 {
        assert(register(p, i))
        i += 1
    }
    assert(!register(p, 33))
}
