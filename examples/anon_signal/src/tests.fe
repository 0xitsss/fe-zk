const NUL_B_T99_H2: u256 = 17569640310603274293581043917119570021497270092372897891270701171659554083540
const MSG_B_T99_H2: u256 = 73996835074002516381597251847798512275450130359530270023125661105605591017868
const SCOPE_B_T99_H2: u256 = 99

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<AnonSignal>(value: Wei::zero(), args: (), salt: 0)
}

fn join(_ p: Address, _ c: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: p,
        gas: 10000000,
        value: Wei::zero(),
        message: SignalMsg::Join { commitment: c },
    )
        .success()
}

fn setup() -> Address uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    assert(join(p, ms[0]))
    assert(join(p, ms[1]))
    assert(join(p, ms[2]))
    let root: u256 = evm
        .call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: SignalMsg::Root {},
        )
    assert(root == ROOT)
    p
}

fn post(
    _ p: Address,
    _ topic: u256,
    _ text: u256,
    _ depth: u256,
    _ root: u256,
    _ nul: u256,
    _ pts: [u256; 8],
) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: p,
        gas: 30000000,
        value: Wei::zero(),
        message: SignalMsg::Post {
            topic: topic,
            text_hash: text,
            merkle_tree_depth: depth,
            merkle_tree_root: root,
            nullifier: nul,
            points: pts,
        },
    )
        .success()
}

fn spent(_ p: Address, _ topic: u256, _ nul: u256) -> bool uses (evm: mut Evm) {
    evm.call(
        addr: p,
        gas: 1000000,
        value: Wei::zero(),
        message: SignalMsg::Spent { topic: topic, nullifier: nul },
    )
}

#[test]
fn signal_flow() uses (evm: mut Evm) {
    let p = setup()
    assert(!spent(p, T99, NUL_A_T99_H1))
    let g0 = evm.gas()
    let ok = post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1())
    evm.emit(GasUsed { what: 3, gas: g0 - evm.gas() })
    assert(ok)
    assert(spent(p, T99, NUL_A_T99_H1))
    // another member, same topic
    assert(
        post(p, T99, H2, DEPTH, ROOT, NUL_B_T99_H2, pts_b_t99_h2()),
    )
    assert(NUL_B_T99_H2 != NUL_A_T99_H1)
}

#[test]
fn same_topic_twice_rejected_other_topic_accepted() uses (evm: mut Evm) {
    let p = setup()
    assert(
        post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    // same member, same topic: the same proof and a different text both fail
    assert(
        !post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    assert(NUL_A_T99_H2 == NUL_A_T99_H1)
    assert(
        !post(p, T99, H2, DEPTH, ROOT, NUL_A_T99_H2, pts_a_t99_h2()),
    )
    // same member, other topic: a different nullifier, accepted, unlinkable to the first
    assert(NUL_A_T100_H1 != NUL_A_T99_H1)
    assert(
        post(p, T100, H1, DEPTH, ROOT, NUL_A_T100_H1, pts_a_t100_h1()),
    )
    assert(spent(p, T100, NUL_A_T100_H1))
    // a nullifier spent in one topic is not spent in the other
    assert(!spent(p, T100, NUL_A_T99_H1))
}

#[test]
fn changed_text_or_topic_rejected() uses (evm: mut Evm) {
    let p = setup()
    // swapped text (front-running)
    assert(
        !post(p, T99, H2, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    // proof made for topic 99 presented for topic 100
    assert(
        !post(p, T100, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    assert(!spent(p, T99, NUL_A_T99_H1))
    assert(!spent(p, T100, NUL_A_T99_H1))
}

#[test]
fn unknown_root_and_bad_depth_rejected() uses (evm: mut Evm) {
    // two of three members joined: ROOT is unknown
    let p = deploy()
    let ms = members()
    assert(join(p, ms[0]))
    assert(join(p, ms[1]))
    assert(
        !post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    assert(join(p, ms[2]))
    assert(!post(p, T99, H1, 0, ROOT, NUL_A_T99_H1, pts_a_t99_h1()))
    assert(
        !post(p, T99, H1, DEPTH + 1, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
    assert(!post(p, T99, H1, 11, ROOT, NUL_A_T99_H1, pts_a_t99_h1()))
    assert(
        post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_a_t99_h1()),
    )
}

#[test]
fn tampered_nullifier_and_points_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(
        !post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1 + 1, pts_a_t99_h1()),
    )
    assert(
        !post(p, T99, H1, DEPTH, ROOT, NUL_A_T99_H1, pts_b_t99_h2()),
    )
    assert(
        !post(p, T99, H1, DEPTH, ROOT + R, NUL_A_T99_H1, pts_a_t99_h1()),
    )
}

#[test]
fn join_guards() uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    assert(join(p, ms[0]))
    assert(!join(p, ms[0]))
    assert(!join(p, 0))
    assert(!join(p, ms[1] + R))
}

#[test]
fn group_capacity_is_32_members() uses (evm: mut Evm) {
    // verify_proof_low has no key above depth 5: the 33rd member would never be able to prove
    let p = deploy()
    var i: u256 = 1
    while i <= 32 {
        assert(join(p, i))
        i += 1
    }
    assert(!join(p, 33))
}
