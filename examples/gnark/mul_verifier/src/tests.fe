/// The key constants pass the full checks of the library (canonical, on curve, G2 subgroup,
/// evaluation domain), also at runtime.
#[test]
fn vk_constants_pass_full_checks() {
    assert(G1::from_coords(QL_X, QL_Y).is_some())
    assert(G1::from_coords(QR_X, QR_Y).is_some())
    assert(G1::from_coords(QM_X, QM_Y).is_some())
    assert(G1::from_coords(QO_X, QO_Y).is_some())
    assert(G1::from_coords(QK_X, QK_Y).is_some())
    assert(G1::from_coords(S1_X, S1_Y).is_some())
    assert(G1::from_coords(S2_X, S2_Y).is_some())
    assert(G1::from_coords(S3_X, S3_Y).is_some())
    assert(G2::from_coords(X2_X0, X2_X1, X2_Y0, X2_Y1).is_some())
    assert(gnark::domain_is_valid(POWER, OMEGA, COSET_SHIFT))
}

/// What `static_assert` rejects at compile time, checked at runtime: each of these constants
/// would make the generated verifier fail to compile.
#[test]
fn invalid_keys_fail_the_compile_time_checks() {
    // [x]_2 on the twist but outside the order-r subgroup
    assert(!g2_is_valid(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1))
    // [x]_2 off the twist, non-canonical
    assert(!g2_is_valid(X2_X0, X2_X1, X2_Y0, X2_Y1 + 1))
    assert(!g2_is_valid(X2_X0 + Q, X2_X1, X2_Y0, X2_Y1))
    // commitment off the curve / non-canonical
    assert(!g1_is_valid(S1_X, S1_Y + 1))
    assert(!g1_is_valid(S1_X + Q, S1_Y))
    // domain: wrong power, w = 1, w not canonical, k = 0, k in the domain, k^2 in the domain
    assert(!gnark::domain_is_valid(POWER + 1, OMEGA, COSET_SHIFT))
    assert(!gnark::domain_is_valid(0, OMEGA, COSET_SHIFT))
    assert(!gnark::domain_is_valid(POWER, 1, COSET_SHIFT))
    assert(!gnark::domain_is_valid(POWER, OMEGA + R, COSET_SHIFT))
    assert(!gnark::domain_is_valid(POWER, OMEGA, 0))
    assert(!gnark::domain_is_valid(POWER, OMEGA, 1))
}

/// A key that fails the library checks is poisoned by `gnark::Vk::from_consts`: it verifies nothing,
/// not even the valid proof, even if the compile-time assertions were removed.
fn key_with(_ omega: u256, _ cci0: u256) -> gnark::Vk<2, 0> {
    let qcp: [G1; 0] = []
    let cci: [u256; 0] = []
    gnark::Vk<2, 0>::from_consts(
        POWER,
        omega,
        COSET_SHIFT,
        [VK_QL, VK_QR, VK_QM, VK_QO, VK_QK, VK_S1, VK_S2, VK_S3],
        qcp,
        cci,
        VK_X2,
    )
}

#[test]
fn poisoned_keys_reject_every_proof() uses (call: Call, ctx: Ctx) {
    let ok = key_with(OMEGA, 0)
    assert(
        gnark::verify_calldata(
            ok,
            bytes_from_words(proof_words()),
            dyn_array_from(inputs()),
        ),
    )
    let bad_domain = key_with(1, 0)
    assert(
        !gnark::verify_calldata(
            bad_domain,
            bytes_from_words(proof_words()),
            dyn_array_from(inputs()),
        ),
    )
}
