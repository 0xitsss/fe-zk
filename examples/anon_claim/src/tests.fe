const NUL_A_TO_WIDE: u256 = 15062481532235973336025870201174658340649267762445437407494919060600102379324
const MSG_A_TO_WIDE: u256 = 1461501637330902918203684832716283019655932542976

msg StrangerMsg {
    #[selector = sol("poke(address,uint256)")]
    Poke { target: Address, commitment: u256 } -> bool,
}

/// A second account: calls `ClaimMsg::Register` from an address that is not the owner.
pub contract Stranger uses (call: mut Call) {
    recv StrangerMsg {
        Poke { target, commitment } -> bool uses (mut call) {
            target.try_call(ClaimMsg::Register { commitment: commitment }).success()
        }
    }
}

fn stranger_registers(_ p: Address, _ c: u256) -> bool uses (evm: mut Evm) {
    let s = evm.create2<Stranger>(value: Wei::zero(), args: (), salt: 7)
    evm.call(
        addr: s,
        gas: 10000000,
        value: Wei::zero(),
        message: StrangerMsg::Poke { target: p, commitment: c },
    )
}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<AnonClaim>(value: Wei::zero(), args: (SCOPE,), salt: 0)
}

fn register(_ p: Address, _ c: u256) -> bool uses (evm: mut Evm) {
    evm.try_call(
        addr: p,
        gas: 10000000,
        value: Wei::zero(),
        message: ClaimMsg::Register { commitment: c },
    )
        .success()
}

fn setup() -> Address uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    assert(register(p, ms[0]))
    assert(register(p, ms[1]))
    assert(register(p, ms[2]))
    assert(register(p, ms[3]))
    assert(register(p, ms[4]))
    let root: u256 = evm.call(
            addr: p,
            gas: 1000000,
            value: Wei::zero(),
            message: ClaimMsg::Root {},
        )
    assert(root == ROOT)
    p
}

fn claim(
    _ p: Address,
    _ recipient: u256,
    _ depth: u256,
    _ root: u256,
    _ nul: u256,
    _ pts: [u256; 8],
) -> bool
uses (evm: mut Evm)
{
    evm.try_call(
        addr: p,
        gas: 30000000,
        value: Wei::zero(),
        message: ClaimMsg::Claim {
            recipient: recipient,
            merkle_tree_depth: depth,
            merkle_tree_root: root,
            nullifier: nul,
            points: pts,
        },
    )
        .success()
}

fn is_claimed(_ p: Address, _ r: u256) -> bool uses (evm: mut Evm) {
    evm.call(
        addr: p,
        gas: 1000000,
        value: Wei::zero(),
        message: ClaimMsg::IsClaimed { recipient: r },
    )
}

fn claims(_ p: Address) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: p,
        gas: 1000000,
        value: Wei::zero(),
        message: ClaimMsg::Claims {},
    )
}

#[test]
fn claim_flow() uses (evm: mut Evm) {
    let p = setup()
    assert(!is_claimed(p, R1))
    let g0 = evm.gas()
    let ok = claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1())
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
    assert(is_claimed(p, R1))
    assert(claim(p, R2, DEPTH, ROOT, NUL_B_TO_R2, pts_b_to_r2()))
    assert(is_claimed(p, R2))
    assert(claims(p) == 2)
}

#[test]
fn second_claim_by_same_member_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    // same proof again, and a valid proof of the same member for another recipient
    assert(!claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(NUL_A_TO_R3 == NUL_A_TO_R1)
    assert(!claim(p, R3, DEPTH, ROOT, NUL_A_TO_R3, pts_a_to_r3()))
    assert(!is_claimed(p, R3))
    assert(claims(p) == 1)
}

#[test]
fn non_canonical_nullifier_cannot_replay_a_claim() uses (evm: mut Evm) {
    // nullifier + r is the same field element: the verifier must reject it (safety rule 1)
    let p = setup()
    assert(claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(!claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1 + R, pts_a_to_r1()))
    assert(claims(p) == 1)
}

#[test]
fn changed_recipient_rejected() uses (evm: mut Evm) {
    let p = setup()
    // a front-runner redirects A's claim to their own address
    assert(!claim(p, R2, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(!claim(p, 0xdead, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(!is_claimed(p, R2))
    // nothing was burned: the intended claim still works
    assert(claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
}

#[test]
fn recipient_wider_than_an_address_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(MSG_A_TO_WIDE == (1 << 160))
    assert(
        !claim(
            p,
            MSG_A_TO_WIDE,
            DEPTH,
            ROOT,
            NUL_A_TO_WIDE,
            pts_a_to_wide(),
        ),
    )
    assert(claims(p) == 0)
}

#[test]
fn not_on_the_allow_list_rejected() uses (evm: mut Evm) {
    // the allow-list has only the first four holders: the root of the full list is unknown
    let p = deploy()
    let ms = members()
    assert(register(p, ms[0]))
    assert(register(p, ms[1]))
    assert(register(p, ms[2]))
    assert(register(p, ms[3]))
    assert(!claim(p, R2, DEPTH, ROOT, NUL_B_TO_R2, pts_b_to_r2()))
    assert(!claim(p, R2, DEPTH + 1, ROOT, NUL_B_TO_R2, pts_b_to_r2()))
}

#[test]
fn tampered_proof_rejected() uses (evm: mut Evm) {
    let p = setup()
    assert(!claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1 + 1, pts_a_to_r1()))
    assert(!claim(p, R1, DEPTH, ROOT, NUL_A_TO_R1, pts_b_to_r2()))
    assert(!claim(p, R1, DEPTH - 1, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(!claim(p, R1, 0, ROOT, NUL_A_TO_R1, pts_a_to_r1()))
    assert(claims(p) == 0)
}

#[test]
fn register_guards() uses (evm: mut Evm) {
    let p = deploy()
    let ms = members()
    assert(!stranger_registers(p, ms[0]))
    assert(register(p, ms[0]))
    assert(!register(p, ms[0]))
    assert(!register(p, 0))
    assert(!register(p, ms[1] + R))
}

#[test]
fn group_capacity_is_32_members() uses (evm: mut Evm) {
    // verify_proof_low has no key above depth 5: the 33rd member would never be able to prove
    let p = deploy()
    var i: u256 = 1
    while i <= 32 {
        assert(register(p, i))
        i += 1
    }
    assert(!register(p, 33))
}
