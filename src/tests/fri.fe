// ---- gas ----

#[event]
struct GasUsed { what: u256, gas: u256 }

#[test]
fn gas_of_verification() uses (evm: mut Evm) {
    let proof = fib_proof()
    let g0 = evm.gas()
    let ok = verify(PARAMS, proof, FIB_PUBLIC)
    let used = g0 - evm.gas()
    evm.emit(GasUsed { what: 1, gas: used })
    assert(ok)
}
