const H_PIY: u256 = 3509124342425544118804768366834769900923056572789593317566021171258209155557

#[event]
struct GasUsed { what: u256, gas: u256 }

fn g1(_ x: u256, _ y: u256) -> G1 {
    match G1::from_coords(x, y) {
        Option::Some(p) => p,
        Option::None => {
            assert(false)
            G1::infinity()
        },
    }
}

fn fr(_ v: u256) -> Bn254Fr {
    Bn254Fr::from_canonical(v).unwrap()
}

fn vk() -> KzgVk {
    let tau = G2::from_coords(TAU_X0, TAU_X1, TAU_Y0, TAU_Y1).unwrap()
    KzgVk::new(G1::generator(), G2::generator(), tau).unwrap()
}

// A key that differs from `vk()` only in [tau]G2.
fn vk_other_tau() -> KzgVk {
    KzgVk::new(G1::generator(), G2::generator(), G2::generator()).unwrap()
}

// A key that differs from `vk_other_tau()` only in G1 (2G instead of G).
fn vk_other_g1() -> KzgVk {
    let two_g = g1(
        1368015179489954701390400359078579693043519447331113978918064868415326638035,
        9918110051302171585080402603319702774565515993150576347155970296011118125764,
    )
    KzgVk::new(two_g, G2::generator(), G2::generator()).unwrap()
}

fn s_c() -> G1 {
    g1(S_CX, S_CY)
}
fn s_pi() -> G1 {
    g1(S_PIX, S_PIY)
}

fn b_cs() -> [G1; 3] {
    [g1(B_C0X, B_C0Y), g1(B_C1X, B_C1Y), g1(B_C2X, B_C2Y)]
}
fn b_ys() -> [Bn254Fr; 3] {
    [fr(B_Y0), fr(B_Y1), fr(B_Y2)]
}
fn b_pi() -> G1 {
    g1(B_PIX, B_PIY)
}

fn h_cs() -> [G1; 3] {
    [g1(H_C0X, H_C0Y), g1(H_C1X, H_C1Y), g1(H_C2X, H_C2Y)]
}
fn h_evals() -> [Bn254Fr; 4] {
    [fr(H_E00), fr(H_E01), fr(H_E1), fr(H_E2)]
}
fn h_h() -> G1 {
    g1(H_HX, H_HY)
}
fn h_pi() -> G1 {
    g1(H_PIX, H_PIY)
}

// ---------------------------------------------------------------- vk

// Compile-time key: `[tau]G2` is validated (canonical, on the twist, order-r subgroup) by the
// compiler, so building the key costs no gas. A bad constant fails with `static assertion failed`.
const G2_GEN_X0: u256 = 10857046999023057135944570762232829481370756359578518086990519993285655852781
const G2_GEN_X1: u256 = 11559732032986387107991004021392285783925812861821192530917403151452391805634
const G2_GEN_Y0: u256 = 8495653923123431417604973247489272438418190587263600148770280649306958101930
const G2_GEN_Y1: u256 = 4082367875863433681332203403145435568316851327593401208105741076214120093531
static_assert(g1_is_valid(1, 2))
static_assert(g2_is_valid(G2_GEN_X0, G2_GEN_X1, G2_GEN_Y0, G2_GEN_Y1))
static_assert(g2_is_valid(TAU_X0, TAU_X1, TAU_Y0, TAU_Y1))
const CONST_VK: KzgVk = KzgVk::from_consts(
    G1::from_coords_or_infinity(1, 2),
    G2::from_coords_or_infinity(G2_GEN_X0, G2_GEN_X1, G2_GEN_Y0, G2_GEN_Y1),
    G2::from_coords_or_infinity(TAU_X0, TAU_X1, TAU_Y0, TAU_Y1),
)

#[test]
fn const_vk_accepts_all_fixtures() uses (call: Call) {
    assert(!CONST_VK.is_degenerate())
    assert(kzg_verify(CONST_VK, s_c(), fr(S_Z), fr(S_Y), s_pi()))
    assert(
        kzg_batch_verify_gwc(CONST_VK, b_cs(), fr(B_Z), b_ys(), b_pi()),
    )
    assert(
        kzg_verify_shplonk(
            CONST_VK,
            h_cs(),
            fr(H_Z1),
            fr(H_Z2),
            h_evals(),
            h_h(),
            h_pi(),
        ),
    )
    // same challenges as the runtime-validated key
    let y = shplonk_challenge_y(CONST_VK, h_cs(), fr(H_Z1), fr(H_Z2), h_evals())
    assert(y.to_canonical() == H_Y)
}

#[test]
fn const_vk_with_invalid_point_is_poisoned() uses (call: Call) {
    // `from_coords_or_infinity` maps an invalid [tau]G2 (here: y + 1, off the twist) to infinity,
    // `from_consts` poisons the key and every verifier rejects, even a valid proof.
    let bad = KzgVk::from_consts(
        G1::from_coords_or_infinity(1, 2),
        G2::from_coords_or_infinity(G2_GEN_X0, G2_GEN_X1, G2_GEN_Y0, G2_GEN_Y1),
        G2::from_coords_or_infinity(TAU_X0, TAU_X1, TAU_Y0, TAU_Y1 + 1),
    )
    assert(bad.is_degenerate())
    assert(!kzg_verify(bad, s_c(), fr(S_Z), fr(S_Y), s_pi()))
    assert(
        !kzg_batch_verify_gwc(bad, b_cs(), fr(B_Z), b_ys(), b_pi()),
    )
    assert(
        !kzg_verify_shplonk(bad, h_cs(), fr(H_Z1), fr(H_Z2), h_evals(), h_h(), h_pi()),
    )
    // an off-curve G1 generator likewise
    let bad1 = KzgVk::from_consts(
        G1::from_coords_or_infinity(1, 3),
        G2::generator(),
        G2::generator(),
    )
    assert(bad1.is_degenerate())
}

#[test]
fn vk_rejects_infinity() {
    let g2 = G2::generator()
    assert(KzgVk::new(G1::infinity(), g2, g2).is_none())
    assert(KzgVk::new(G1::generator(), G2::infinity(), g2).is_none())
    assert(KzgVk::new(G1::generator(), g2, G2::infinity()).is_none())
    assert(KzgVk::new(G1::generator(), g2, g2).is_some())
}

// ---------------------------------------------------------------- single

#[test]
fn single_accepts_valid() uses (call: Call) {
    assert(kzg_verify(vk(), s_c(), fr(S_Z), fr(S_Y), s_pi()))
}

#[test]
fn single_rejects_tampered() uses (call: Call) {
    let k = vk()
    let one = Bn254Fr::one()
    // tampered value, point, proof, commitment
    assert(!kzg_verify(k, s_c(), fr(S_Z), fr(S_Y).add(one), s_pi()))
    assert(!kzg_verify(k, s_c(), fr(S_Z).add(one), fr(S_Y), s_pi()))
    assert(!kzg_verify(k, s_c(), fr(S_Z), fr(S_Y), G1::generator()))
    assert(!kzg_verify(k, s_c(), fr(S_Z), fr(S_Y), s_pi().neg()))
    assert(!kzg_verify(k, s_c().neg(), fr(S_Z), fr(S_Y), s_pi()))
    assert(!kzg_verify(k, G1::generator(), fr(S_Z), fr(S_Y), s_pi()))
    // proof for a different commitment
    assert(!kzg_verify(k, g1(B_C0X, B_C0Y), fr(S_Z), fr(S_Y), s_pi()))
    // infinity commitment and infinity proof
    assert(!kzg_verify(k, G1::infinity(), fr(S_Z), fr(S_Y), s_pi()))
    assert(!kzg_verify(k, s_c(), fr(S_Z), fr(S_Y), G1::infinity()))
}

#[test]
fn single_rejects_wrong_srs() uses (call: Call) {
    assert(
        !kzg_verify(vk_other_tau(), s_c(), fr(S_Z), fr(S_Y), s_pi()),
    )
}

#[test]
fn raw_inputs_need_checked_constructors() {
    // kzg_verify takes G1 / Bn254Fr only; these are the ways in from raw words.
    assert(Bn254Fr::from_canonical(Bn254Fr::MODULUS).is_none())
    assert(Bn254Fr::from_canonical(Bn254Fr::MODULUS - 1).is_some())
    assert(
        G1::from_coords(
            S_CX + 21888242871839275222246405745257275088696311157297823662689037894645226208583,
            S_CY,
        )
            .is_none(),
    )
    assert(G1::from_coords(S_CX, S_CY + 1).is_none())
}

// ---------------------------------------------------------------- GWC

#[test]
fn gwc_challenge_matches_reference() {
    assert(
        gwc_challenge(vk(), b_cs(), fr(B_Z), b_ys()).to_canonical() == B_V,
    )
}

#[test]
fn gwc_accepts_valid() uses (call: Call) {
    assert(
        kzg_batch_verify_gwc(vk(), b_cs(), fr(B_Z), b_ys(), b_pi()),
    )
}

#[test]
fn gwc_rejects_tampered() uses (call: Call) {
    let k = vk()
    let cs = b_cs()
    let ys = b_ys()
    let z = fr(B_Z)
    let one = Bn254Fr::one()
    // tampered value (each)
    assert(
        !kzg_batch_verify_gwc(k, cs, z, [ys[0].add(one), ys[1], ys[2]], b_pi()),
    )
    assert(
        !kzg_batch_verify_gwc(k, cs, z, [ys[0], ys[1].add(one), ys[2]], b_pi()),
    )
    assert(
        !kzg_batch_verify_gwc(k, cs, z, [ys[0], ys[1], ys[2].add(one)], b_pi()),
    )
    // tampered point
    assert(!kzg_batch_verify_gwc(k, cs, z.add(one), ys, b_pi()))
    // tampered proof
    assert(!kzg_batch_verify_gwc(k, cs, z, ys, G1::generator()))
    assert(!kzg_batch_verify_gwc(k, cs, z, ys, b_pi().neg()))
    // tampered commitment
    assert(
        !kzg_batch_verify_gwc(k, [G1::generator(), cs[1], cs[2]], z, ys, b_pi()),
    )
    assert(
        !kzg_batch_verify_gwc(k, [cs[0], cs[1], cs[2].neg()], z, ys, b_pi()),
    )
    // wrong key
    assert(!kzg_batch_verify_gwc(vk_other_tau(), cs, z, ys, b_pi()))
}

#[test]
fn gwc_rejects_swapped_or_resized() uses (call: Call) {
    let k = vk()
    let cs = b_cs()
    let ys = b_ys()
    let z = fr(B_Z)
    // swapped commitments
    assert(
        !kzg_batch_verify_gwc(k, [cs[1], cs[0], cs[2]], z, ys, b_pi()),
    )
    assert(
        !kzg_batch_verify_gwc(k, [cs[0], cs[2], cs[1]], z, ys, b_pi()),
    )
    // swapped values
    assert(
        !kzg_batch_verify_gwc(k, cs, z, [ys[1], ys[0], ys[2]], b_pi()),
    )
    // dropped element (N = 2, N = 1) with the N = 3 proof
    assert(
        !kzg_batch_verify_gwc(k, [cs[0], cs[1]], z, [ys[0], ys[1]], b_pi()),
    )
    assert(!kzg_batch_verify_gwc(k, [cs[0]], z, [ys[0]], b_pi()))
}

/// Safety rule 5: changing any transcript input changes the challenge.
#[test]
fn gwc_challenge_binds_every_input() {
    let k = vk()
    let cs = b_cs()
    let ys = b_ys()
    let z = fr(B_Z)
    let one = Bn254Fr::one()
    let base = gwc_challenge(k, cs, z, ys)
    // vk: [tau]G2, then G1 (G2 shares the same encoding path)
    assert(!gwc_challenge(vk_other_tau(), cs, z, ys).eq(base))
    assert(
        !gwc_challenge(vk_other_g1(), cs, z, ys).eq(gwc_challenge(vk_other_tau(), cs, z, ys)),
    )
    // point
    assert(!gwc_challenge(k, cs, z.add(one), ys).eq(base))
    // each commitment
    assert(
        !gwc_challenge(k, [G1::generator(), cs[1], cs[2]], z, ys).eq(base),
    )
    assert(
        !gwc_challenge(k, [cs[0], G1::generator(), cs[2]], z, ys).eq(base),
    )
    assert(
        !gwc_challenge(k, [cs[0], cs[1], G1::generator()], z, ys).eq(base),
    )
    // sign of a y coordinate only
    assert(
        !gwc_challenge(k, [cs[0], cs[1], cs[2].neg()], z, ys).eq(base),
    )
    // each value
    assert(
        !gwc_challenge(k, cs, z, [ys[0].add(one), ys[1], ys[2]]).eq(base),
    )
    assert(
        !gwc_challenge(k, cs, z, [ys[0], ys[1].add(one), ys[2]]).eq(base),
    )
    assert(
        !gwc_challenge(k, cs, z, [ys[0], ys[1], ys[2].add(one)]).eq(base),
    )
    // order of commitments
    assert(!gwc_challenge(k, [cs[1], cs[0], cs[2]], z, ys).eq(base))
    // length
    assert(
        !gwc_challenge(k, [cs[0], cs[1]], z, [ys[0], ys[1]]).eq(base),
    )
    // determinism
    assert(gwc_challenge(k, cs, z, ys).eq(base))
}

// ---------------------------------------------------------------- SHPLONK

#[test]
fn shplonk_challenges_match_reference() {
    let y = shplonk_challenge_y(vk(), h_cs(), fr(H_Z1), fr(H_Z2), h_evals())
    assert(y.to_canonical() == H_Y)
    assert(shplonk_challenge_u(y, h_h()).to_canonical() == H_U)
}

#[test]
fn shplonk_accepts_valid() uses (call: Call) {
    assert(
        kzg_verify_shplonk(
            vk(),
            h_cs(),
            fr(H_Z1),
            fr(H_Z2),
            h_evals(),
            h_h(),
            h_pi(),
        ),
    )
}

#[test]
fn shplonk_rejects_tampered() uses (call: Call) {
    let k = vk()
    let cs = h_cs()
    let ev = h_evals()
    let z1 = fr(H_Z1)
    let z2 = fr(H_Z2)
    let one = Bn254Fr::one()
    let h = h_h()
    let pi = h_pi()
    assert(
        !kzg_verify_shplonk(
            k,
            cs,
            z1,
            z2,
            [ev[0].add(one), ev[1], ev[2], ev[3]],
            h,
            pi,
        ),
    )
    assert(
        !kzg_verify_shplonk(
            k,
            cs,
            z1,
            z2,
            [ev[0], ev[1].add(one), ev[2], ev[3]],
            h,
            pi,
        ),
    )
    assert(
        !kzg_verify_shplonk(
            k,
            cs,
            z1,
            z2,
            [ev[0], ev[1], ev[2].add(one), ev[3]],
            h,
            pi,
        ),
    )
    assert(
        !kzg_verify_shplonk(
            k,
            cs,
            z1,
            z2,
            [ev[0], ev[1], ev[2], ev[3].add(one)],
            h,
            pi,
        ),
    )
    // swapped evaluations
    assert(
        !kzg_verify_shplonk(k, cs, z1, z2, [ev[1], ev[0], ev[2], ev[3]], h, pi),
    )
    // points
    assert(!kzg_verify_shplonk(k, cs, z1.add(one), z2, ev, h, pi))
    assert(!kzg_verify_shplonk(k, cs, z2, z1, ev, h, pi))
    // proofs
    assert(
        !kzg_verify_shplonk(k, cs, z1, z2, ev, G1::generator(), pi),
    )
    assert(!kzg_verify_shplonk(k, cs, z1, z2, ev, h, G1::generator()))
    assert(!kzg_verify_shplonk(k, cs, z1, z2, ev, pi, h))
    // commitments (each) and swapped commitments
    assert(
        !kzg_verify_shplonk(k, [G1::generator(), cs[1], cs[2]], z1, z2, ev, h, pi),
    )
    assert(
        !kzg_verify_shplonk(k, [cs[0], cs[1].neg(), cs[2]], z1, z2, ev, h, pi),
    )
    assert(
        !kzg_verify_shplonk(k, [cs[0], cs[1], G1::generator()], z1, z2, ev, h, pi),
    )
    assert(
        !kzg_verify_shplonk(k, [cs[1], cs[0], cs[2]], z1, z2, ev, h, pi),
    )
    assert(
        !kzg_verify_shplonk(k, [cs[0], cs[2], cs[1]], z1, z2, ev, h, pi),
    )
    // wrong key
    assert(!kzg_verify_shplonk(vk_other_tau(), cs, z1, z2, ev, h, pi))
    // degenerate: equal points
    assert(!kzg_verify_shplonk(k, cs, z1, z1, ev, h, pi))
}

#[test]
fn shplonk_challenges_bind_every_input() {
    let k = vk()
    let cs = h_cs()
    let ev = h_evals()
    let z1 = fr(H_Z1)
    let z2 = fr(H_Z2)
    let one = Bn254Fr::one()
    let y = shplonk_challenge_y(k, cs, z1, z2, ev)
    assert(!shplonk_challenge_y(vk_other_tau(), cs, z1, z2, ev).eq(y))
    assert(
        !shplonk_challenge_y(vk_other_g1(), cs, z1, z2, ev)
            .eq(shplonk_challenge_y(vk_other_tau(), cs, z1, z2, ev)),
    )
    assert(!shplonk_challenge_y(k, cs, z1.add(one), z2, ev).eq(y))
    assert(!shplonk_challenge_y(k, cs, z1, z2.add(one), ev).eq(y))
    assert(
        !shplonk_challenge_y(k, [G1::generator(), cs[1], cs[2]], z1, z2, ev).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, [cs[0], G1::generator(), cs[2]], z1, z2, ev).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, [cs[0], cs[1], G1::generator()], z1, z2, ev).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, cs, z1, z2, [ev[0].add(one), ev[1], ev[2], ev[3]]).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, cs, z1, z2, [ev[0], ev[1].add(one), ev[2], ev[3]]).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, cs, z1, z2, [ev[0], ev[1], ev[2].add(one), ev[3]]).eq(y),
    )
    assert(
        !shplonk_challenge_y(k, cs, z1, z2, [ev[0], ev[1], ev[2], ev[3].add(one)]).eq(y),
    )
    let u = shplonk_challenge_u(y, h_h())
    assert(!shplonk_challenge_u(y.add(one), h_h()).eq(u))
    assert(!shplonk_challenge_u(y, G1::generator()).eq(u))
    assert(!shplonk_challenge_u(y, h_h().neg()).eq(u))
}

// ---------------------------------------------------------------- gas

#[test]
fn kzg_gas_report() uses (evm: mut Evm, call: Call) {
    let k = vk()
    var g0 = evm.gas()
    let a = kzg_verify(k, s_c(), fr(S_Z), fr(S_Y), s_pi())
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let b = kzg_batch_verify_gwc(k, b_cs(), fr(B_Z), b_ys(), b_pi())
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let c = kzg_verify_shplonk(k, h_cs(), fr(H_Z1), fr(H_Z2), h_evals(), h_h(), h_pi())
    evm.emit(GasUsed { what: 3, gas: g0 - evm.gas() })
    assert(a && b && c)
}
