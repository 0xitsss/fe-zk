const B_PIY: u256 = 18855173218497954813708192149018917071574486789407010730539487683797175478090
const H_Z1: u256 = 31415926
const H_Z2: u256 = 27182818
const H_C0X: u256 = 1595718970909113440153857555066351092922637483824170337342576281811965259197
const H_C0Y: u256 = 948156895052129017127324714969100395196257637002004527123545665035205501572
const H_C1X: u256 = 12556446719929953560004175171460564237590966738772938528153148556663555205435
const H_C1Y: u256 = 19912204605627978108991910799745812115151370740744459889578466890407152407871
const H_C2X: u256 = 4391677875258002017317126766044756340150654469491448170945578864409924335132
const H_C2Y: u256 = 2906660571419915806817295544918285012250055648114148182457967427794652619005
const H_E00: u256 = 12858099608517076829320871400845064403484360060552428325800489930610402703079
const H_E01: u256 = 9163575734332480143486792983273450836341401631753619166672246165196781906659
const H_E1: u256 = 42128000871316708139029115513377097203892973678779355681452023924
const H_E2: u256 = 34329209544287797279924602015727750990658527089390884057066441019512831744
const H_Y: u256 = 16922016046308380326692227909803692202994249034528700922423164902403787682697
const H_U: u256 = 14462547690741016541473065453917779467992697601856083775924665083262675043407
const H_HX: u256 = 8125429827028913461523006822919935888152574073826400740299306114731891425210
const H_HY: u256 = 1843557644143866611709642324223675797413190627971747677854085562295778732537
