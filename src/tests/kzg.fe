const H_Z1: u256 = 31415926
const H_Z2: u256 = 27182818
const H_C0X: u256 = 19970790590516507234863124867540361425750073013979750746827651634671837598214
const H_C0Y: u256 = 11039700689220948105327668360241897069486972648224477631202549595783607153543
const H_C1X: u256 = 3605036194951822588566992058054786811403198994996223884860420344141474424104
const H_C1Y: u256 = 15189499045690570756824871235860831639792643165732237565416735150841293400270
const H_C2X: u256 = 7784822309062107968547043100998489765642202449624720725159526296322977611355
const H_C2Y: u256 = 21838253202646063513082937137941615925513037495985780783669278682370527004214
