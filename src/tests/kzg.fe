//! KZG verifier tests. Fixtures come from arkworks 0.5.0 (`vectors/kzg`, `scripts/regen-kzg.sh`)
//! with a TEST-ONLY insecure SRS; the constants below are copied from `vectors/kzg/fixtures/kzg.json`.
//! Gas: `fe test --show-logs` prints the `GasUsed` events of `gas_report`.
use ingot::ec::{G1, G2, g1_is_valid, g2_is_valid}
use ingot::field::{Bn254Fr, Field}
use ingot::verifier::kzg::{
    KzgVk,
    gwc_challenge,
    kzg_batch_verify_gwc,
    kzg_verify,
    kzg_verify_shplonk,
    shplonk_challenge_u,
    shplonk_challenge_y,
}
use std::evm::{Call, Evm}

