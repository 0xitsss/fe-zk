//! The secure FRI/STARK configuration (`config_secure`): a real Plonky3 proof, at least 100
//! conjectured bits, run through the shared suite `fri_suite.fe`. Fixture: `fri_fixture_secure.fe`.
use std::evm::Evm
use ingot::verifier::fri::verify
use ingot::verifier::fri::config_secure::{CONJECTURED_BITS, PARAMS, PROOF_WORDS}
use ingot::verifier::fri::{conjectured_bits, proof_words}
use ingot::tests::fri_suite
use ingot::tests::fri_fixture_secure::{
    FIB_PROOF_WORDS,
    FIB_PUBLIC,
    TR_ALPHA,
    TR_BETAS,
    TR_FRI_ALPHA,
    TR_INDICES,
    TR_ZETA,
    fib_proof,
}

#[test]
fn secure_config_matches_fixture() {
    assert(PROOF_WORDS == FIB_PROOF_WORDS)
    assert(proof_words(PARAMS) == (PROOF_WORDS as u256))
    assert(conjectured_bits(PARAMS) == CONJECTURED_BITS)
    assert(CONJECTURED_BITS >= 100)
    assert(
        PARAMS.num_queries * PARAMS.log_blowup + PARAMS.query_pow_bits >= 100,
    )
    fri_suite::layout_is_consistent(PARAMS, fib_proof())
}

#[test]
fn secure_transcript_matches_plonky3() {
    fri_suite::transcript_matches(
        PARAMS,
        fib_proof(),
        FIB_PUBLIC,
        TR_ALPHA,
        TR_ZETA,
        TR_FRI_ALPHA,
        TR_BETAS,
        TR_INDICES,
    )
}

#[test]
fn secure_accepts_plonky3_fibonacci_proof() {
    fri_suite::accepts(PARAMS, fib_proof(), FIB_PUBLIC)
}

#[test]
fn secure_rejects_tampered_merkle_siblings() {
    fri_suite::rejects_tampered_merkle_siblings(PARAMS, fib_proof(), FIB_PUBLIC)
}

