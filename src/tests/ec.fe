//! BN254 curve-layer tests. Reference values come from py_ecc (independent of the Fe code);
//! `scripts/ec-vectors.py` prints every constant below next to the Python expression that makes it.
//! Gas: `fe test --show-logs` prints the `GasUsed` events of `gas_report`.
use core::ptr::{self, MemBuffer}
use core::abi::{load_word, store_word}
use ingot::ec::{G1, G2, g1_add, g1_mul, pairing_check}
use ingot::field::{Bn254Fr, Field}
use std::evm::{Address, Call, Evm}

const Q: u256 = 21888242871839275222246405745257275088696311157297823662689037894645226208583
const R: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617
// s = 0x1234...ef % r (py: s = 0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef % curve_order)
const S: u256 = 8234104122482341265491137074636836252947884782870784360943022469005013929455
const A: u256 = 123456789

// Python: multiply(G1, 2)
const G1_2X: u256 = 1368015179489954701390400359078579693043519447331113978918064868415326638035
const G1_2Y: u256 = 9918110051302171585080402603319702774565515993150576347155970296011118125764
// Python: add(G1, multiply(G1, 2))
const G1_3X: u256 = 3353031288059533942658390886683067124040920775575537747144343083137631628272
const G1_3Y: u256 = 19321533766552368860946552437480515441416830039777911637913418824951667761761
// Python: multiply(G1, S)
const G1_SX: u256 = 11650402473466308343147810157828709405002629083239427252717749646260595675099
const G1_SY: u256 = 12705148232951133326101841362637835177319865853340579988301898117149740186427
// Python: multiply(multiply(G1, 2), S)
const G1_2SX: u256 = 19740082914304353813827053883798169124627421108817543005543168761620327903937
const G1_2SY: u256 = 830455081779719150438453068065706062010996896652476407300629952828327670603
// Python: multiply(G1, A)
const G1_AX: u256 = 9121282642809701931333593728297233225556711250127745709186816755779879923737
const G1_AY: u256 = 8783642022119951289582979607207867126556038468480503109520224385365741455513
// Python: multiply(G2, A), coordinates (x.coeffs[0], x.coeffs[1], y.coeffs[0], y.coeffs[1])
const G2_AX0: u256 = 142094823562702583669092464225103219873886198373818886253774429994499461119
const G2_AX1: u256 = 12703405598006979409108671416960902338538868397248453921759384556929622558257
const G2_AY0: u256 = 10504771741599673449168779439288281645955231116910341346670256599842843491846
const G2_AY1: u256 = 21792722069934396490667258760160363541978805696356802531479377933366930348185
// Python: multiply(G2, 2)
const G2_2X0: u256 = 18029695676650738226693292988307914797657423701064905010927197838374790804409
const G2_2X1: u256 = 14583779054894525174450323658765874724019480979794335525732096752006891875705
const G2_2Y0: u256 = 2140229616977736810657479771656733941598412651537078903776637920509952744750
const G2_2Y1: u256 = 11474861747383700316476719153975578001603231366361248090558603872215261634898
// On the twist, NOT in the order-r subgroup (scripts/ec-vectors.py; Python: multiply(P, curve_order) is not None)
const BAD_X0: u256 = 2
const BAD_X1: u256 = 1
const BAD_Y0: u256 = 7292567877523311580221095596750716176434782432868683424513645834767876293070
const BAD_Y1: u256 = 19659275751359636165940301690575149581329631496732780143538578556285923319774

#[event]
struct GasUsed { what: u256, gas: u256 }

#[event]
struct PrecompileRejectsNonSubgroup { rejected: bool }

fn g1(_ x: u256, _ y: u256) -> G1 {
    match G1::from_coords(x, y) {
        Option::Some(p) => p,
        Option::None => {
            assert(false)
            G1::infinity()
        },
    }
}

fn g2(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> G2 {
    match G2::from_coords(x0, x1, y0, y1) {
        Option::Some(p) => p,
        Option::None => {
            assert(false)
            G2::infinity()
        },
    }
}

fn fr(_ v: u256) -> Bn254Fr {
    Bn254Fr::from_canonical(v).unwrap()
}

#[test]
fn g1_accepts_valid() {
    let gen = G1::generator()
    assert(gen.x() == 1 && gen.y() == 2)
    assert(G1::from_coords(1, 2).unwrap().eq(gen))
    assert(G1::from_coords(G1_2X, G1_2Y).is_some())
    // infinity is explicit
    let inf = G1::from_coords(0, 0).unwrap()
    assert(inf.is_infinity())
    assert(!gen.is_infinity())
    // -G = (1, q - 2); neg(neg(G)) = G
    assert(gen.neg().y() == Q - 2)
    assert(gen.neg().neg().eq(gen))
    assert(G1::from_coords(1, Q - 2).unwrap().eq(gen.neg()))
}

#[test]
fn g1_rejects_invalid() {
    // not on curve: 3 != 1 + 3
    assert(G1::from_coords(1, 3).is_none())
    assert(G1::from_coords(0, 1).is_none())
    assert(G1::from_coords(1, 0).is_none())
    // non-canonical: these would satisfy the curve equation if silently reduced
    assert(G1::from_coords(Q, 0).is_none())
    assert(G1::from_coords(Q + 1, 2).is_none())
    assert(G1::from_coords(1, Q + 2).is_none())
    assert(G1::from_coords(Q, Q).is_none())
    assert(G1::from_coords(0, Q).is_none())
    assert(
        G1::from_coords(
            0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            2,
        )
            .is_none(),
    )
}

#[test]
fn g2_accepts_valid() {
    let gen = G2::generator()
    // generator survives the validating constructor (on-curve + subgroup)
    assert(
        G2::from_coords(gen.x0(), gen.x1(), gen.y0(), gen.y1()).unwrap().eq(gen),
    )
    assert(G2::from_coords(G2_2X0, G2_2X1, G2_2Y0, G2_2Y1).is_some())
    assert(G2::from_coords(G2_AX0, G2_AX1, G2_AY0, G2_AY1).is_some())
    let inf = G2::from_coords(0, 0, 0, 0).unwrap()
    assert(inf.is_infinity())
    assert(gen.neg().neg().eq(gen))
    // -G2 is in the subgroup
    assert(
        G2::from_coords(gen.x0(), gen.x1(), Q - gen.y0(), Q - gen.y1()).is_some(),
    )
}

#[test]
fn g2_rejects_invalid() {
    let gen = G2::generator()
    // not on the twist
    assert(
        G2::from_coords(gen.x0(), gen.x1(), gen.y0() + 1, gen.y1()).is_none(),
    )
    assert(G2::from_coords(1, 0, 2, 0).is_none())
    assert(G2::from_coords(0, 0, 1, 0).is_none())
    // non-canonical coordinates (each of the four)
    assert(
        G2::from_coords(gen.x0() + Q, gen.x1(), gen.y0(), gen.y1()).is_none(),
    )
    assert(
        G2::from_coords(gen.x0(), gen.x1() + Q, gen.y0(), gen.y1()).is_none(),
    )
    assert(
        G2::from_coords(gen.x0(), gen.x1(), gen.y0() + Q, gen.y1()).is_none(),
    )
    assert(
        G2::from_coords(gen.x0(), gen.x1(), gen.y0(), gen.y1() + Q).is_none(),
    )
    assert(G2::from_coords(Q, 0, 0, 0).is_none())
}

#[test]
fn g2_rejects_non_subgroup() {
    // on the twist curve but outside the order-r subgroup
    assert(G2::from_coords(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1).is_none())
}

/// What does the pairing precompile (0x08) do with an on-curve G2 point outside the subgroup?
/// Sends e(G1, P_bad) directly (words in precompile order x_imag, x_real, y_imag, y_real) and
/// records the answer in the log.
#[test]
fn precompile_vs_non_subgroup() uses (evm: mut Evm, call: Call) {
    var input = MemBuffer::with_capacity(192)
    let bad: [u256; 6] = [1, 2, BAD_X1, BAD_X0, BAD_Y1, BAD_Y0]
    var i: usize = 0
    while i < 6 {
        unsafe {
            store_word(
                ptr: ptr::offset_bytes(input.ptr(), (i * 32) as u256),
                value: bad[i],
            )
        }
        i += 1
    }
    unsafe {
        input.set_len(192)
    }
    var out = MemBuffer::with_capacity(32)
    let r = call
        .raw_staticcall(
            addr: Address::new(8),
            gas: 1000000,
            args: input.span(),
            ret: mut out,
        )
    evm.emit(PrecompileRejectsNonSubgroup { rejected: !r.success() })
    assert(!r.success())

    // control: the same call with the generator succeeds and returns 32 bytes
    let ok: [u256; 6] = [
        1,
        2,
        11559732032986387107991004021392285783925812861821192530917403151452391805634,
        10857046999023057135944570762232829481370756359578518086990519993285655852781,
        4082367875863433681332203403145435568316851327593401208105741076214120093531,
        8495653923123431417604973247489272438418190587263600148770280649306958101930,
    ]
    i = 0
    while i < 6 {
        unsafe {
            store_word(
                ptr: ptr::offset_bytes(input.ptr(), (i * 32) as u256),
                value: ok[i],
            )
        }
        i += 1
    }
    let r2 = call
        .raw_staticcall(
            addr: Address::new(8),
            gas: 1000000,
            args: input.span(),
            ret: mut out,
        )
    assert(r2.success())
    assert(r2.returndata_len() == 32)
}

#[test]
fn add_and_mul_match_reference() uses (evm: mut Evm, call: Call) {
    let gen = G1::generator()
    let two = g1_add(gen, gen)
    assert(two.x() == G1_2X && two.y() == G1_2Y)
    let three = g1_add(gen, two)
    assert(three.x() == G1_3X && three.y() == G1_3Y)
    // G + (-G) = infinity, G + infinity = G
    assert(g1_add(gen, gen.neg()).is_infinity())
    assert(g1_add(gen, G1::infinity()).eq(gen))
    let m = g1_mul(gen, fr(S))
    assert(m.x() == G1_SX && m.y() == G1_SY)
    let m2 = g1_mul(two, fr(S))
    assert(m2.x() == G1_2SX && m2.y() == G1_2SY)
    // [r-1] G = -G ; [0] G = infinity
    assert(g1_mul(gen, fr(R - 1)).eq(gen.neg()))
    assert(g1_mul(gen, fr(0)).is_infinity())
    assert(g1_mul(G1::infinity(), fr(5)).is_infinity())
}

#[test]
fn pairing_accepts_and_rejects() uses (evm: mut Evm, call: Call) {
    let p = G1::generator()
    let q = G2::generator()
    // e(P,Q) * e(-P,Q) = 1
    assert(pairing_check([p, p.neg()], [q, q]))
    // e(P,Q) * e(P,Q) != 1
    assert(!pairing_check([p, p], [q, q]))
    // e(P,Q) != 1 on its own
    assert(!pairing_check([p], [q]))
    // infinity pairs contribute 1
    assert(pairing_check([G1::infinity()], [q]))
    assert(pairing_check([p], [G2::infinity()]))
    // e(P,Q) * e(-P,-Q) = e(P,Q)^2 != 1
    assert(!pairing_check([p, p.neg()], [q, q.neg()]))
}

#[test]
fn pairing_bilinearity() uses (evm: mut Evm, call: Call) {
    let p = G1::generator()
    let q = G2::generator()
    let ap = g1(G1_AX, G1_AY)
    let aq = g2(G2_AX0, G2_AX1, G2_AY0, G2_AY1)
    // reference points agree with the precompile-derived one
    assert(g1_mul(p, fr(A)).eq(ap))
    // e(aP, Q) * e(-P, aQ) == 1
    assert(pairing_check([ap, p.neg()], [q, aq]))
    // e(aP, Q) * e(P, aQ) != 1
    assert(!pairing_check([ap, p], [q, aq]))
    // three pairs: e(P,Q) e(P,Q) e(-2P, Q) == 1
    let two = g1(G1_2X, G1_2Y)
    assert(pairing_check([p, p, two.neg()], [q, q, q]))
}

#[test]
fn gas_report() uses (evm: mut Evm, call: Call) {
    let p = G1::generator()
    let q = G2::generator()
    var g0 = evm.gas()
    let two = g1_add(p, p)
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let m = g1_mul(p, fr(S))
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let ok1 = pairing_check([p, p.neg()], [q, q])
    evm.emit(GasUsed { what: 3, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let ok2 = pairing_check([p, p.neg(), two, m], [q, q, q.neg(), q])
    evm.emit(GasUsed { what: 4, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let v = G1::from_coords(G1_2X, G1_2Y)
    evm.emit(GasUsed { what: 5, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let w = G2::from_coords(G2_AX0, G2_AX1, G2_AY0, G2_AY1)
    evm.emit(GasUsed { what: 6, gas: g0 - evm.gas() })
    assert(ok1 && !ok2 && v.is_some() && w.is_some())
}
