//! BLS12-381 (EIP-2537) and EIP-4844 point-evaluation tests. Reference values are generated by
//! `scripts/ec-vectors-bls.py` (py_ecc) into `ec_bls_vectors.fe`, with the Python expression next
//! to each constant. The point-evaluation vector is from c-kzg-4844 (see the script).
use core::ptr::{self, MemBuffer}
use core::abi::store_word
use ingot::ec::{
    Bls12381Fr,
    Bytes48,
    G1Bls,
    G2Bls,
    bls_g1_add,
    bls_g1_msm,
    bls_g1_mul,
    bls_g2_add,
    bls_g2_msm,
    bls_map_fp2_to_g2,
    bls_map_fp_to_g1,
    bls_pairing_check,
    kzg_point_evaluation,
}
use ingot::field::Field
use super::ec_bls_vectors::*
use std::evm::{Address, Call, Ctx, Evm}

#[event]
struct GasUsed { what: u256, gas: u256 }

fn fr(_ v: u256) -> Bls12381Fr {
    Bls12381Fr::from_canonical(v).unwrap()
}

fn g1w(_ xh: u256, _ xl: u256, _ yh: u256, _ yl: u256) -> [u256; 4] {
    [xh, xl, yh, yl]
}

fn g1_2() -> G1Bls uses (call: Call, ctx: Ctx) {
    G1Bls::from_words(g1w(G1_2_X_HI, G1_2_X_LO, G1_2_Y_HI, G1_2_Y_LO)).unwrap()
}

fn g2_2() -> G2Bls uses (call: Call, ctx: Ctx) {
    G2Bls::from_words(
        [
            G2_2_X0_HI,
            G2_2_X0_LO,
            G2_2_X1_HI,
            G2_2_X1_LO,
            G2_2_Y0_HI,
            G2_2_Y0_LO,
            G2_2_Y1_HI,
            G2_2_Y1_LO,
        ],
    )
        .unwrap()
}

#[test]
fn g1_validation() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let g = G1Bls::generator()
    // generator and 2G pass the precompile's curve + subgroup check
    assert(G1Bls::from_words(g.words()).unwrap().eq(g))
    assert(g1_2().words()[0] == G1_2_X_HI)
    // infinity accepted
    assert(G1Bls::from_words([0, 0, 0, 0]).unwrap().is_infinity())
    // not on curve: (1, 1)
    assert(G1Bls::from_words([0, 1, 0, 1]).is_none())
    // non-canonical: x = p (hi, lo) = (P_HI, P_LO)
    assert(
        G1Bls::from_words([P_HI, P_LO, G1_Y_HI, G1_Y_LO]).is_none(),
    )
    assert(
        G1Bls::from_words([G1_X_HI, G1_X_LO, P_HI, P_LO]).is_none(),
    )
    // hi word above 2^128 is non-canonical
    assert(
        G1Bls::from_words([0x100000000000000000000000000000000, 0, G1_Y_HI, G1_Y_LO]).is_none(),
    )
    // neg: -G matches py_ecc neg(G1); double negation is identity
    assert(
        g.neg().words()[2] == G1_NEG_Y_HI && g.neg().words()[3] == G1_NEG_Y_LO,
    )
    assert(g.neg().neg().eq(g))
    assert(G1Bls::from_words(g.neg().words()).is_some())
}

#[test]
fn g1_ops_match_reference() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let g = G1Bls::generator()
    // add(G1, G1) = multiply(G1, 2)
    let two = bls_g1_add(g, g)
    assert(two.words()[1] == G1_2_X_LO && two.words()[3] == G1_2_Y_LO)
    assert(two.words()[0] == G1_2_X_HI && two.words()[2] == G1_2_Y_HI)
    // add(G1, multiply(G1, 2))
    let three = bls_g1_add(g, two)
    assert(
        three.words()[0] == G1_3_X_HI && three.words()[1] == G1_3_X_LO,
    )
    assert(
        three.words()[2] == G1_3_Y_HI && three.words()[3] == G1_3_Y_LO,
    )
    assert(bls_g1_add(g, g.neg()).is_infinity())
    // msm [G1, 2G1] x [s1, s2]
    let m = bls_g1_msm([g, two], [fr(S1), fr(S2)])
    assert(m.words()[0] == G1_MSM_X_HI && m.words()[1] == G1_MSM_X_LO)
    assert(m.words()[2] == G1_MSM_Y_HI && m.words()[3] == G1_MSM_Y_LO)
    // [2] G1 via msm of one pair
    assert(bls_g1_mul(g, fr(2)).eq(two))
}

#[test]
fn g2_ops_match_reference() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let g = G2Bls::generator()
    assert(G2Bls::from_words(g.words()).unwrap().eq(g))
    assert(
        G2Bls::from_words([0, 0, 0, 0, 0, 0, 0, 0]).unwrap().is_infinity(),
    )
    let two = g2_2()
    assert(bls_g2_add(g, g).eq(two))
    assert(bls_g2_add(g, g.neg()).is_infinity())
    let m = bls_g2_msm([g, two], [fr(S1), fr(S2)])
    assert(
        m.words()[0] == G2_MSM_X0_HI && m.words()[1] == G2_MSM_X0_LO,
    )
    assert(
        m.words()[2] == G2_MSM_X1_HI && m.words()[3] == G2_MSM_X1_LO,
    )
    assert(
        m.words()[4] == G2_MSM_Y0_HI && m.words()[5] == G2_MSM_Y0_LO,
    )
    assert(
        m.words()[6] == G2_MSM_Y1_HI && m.words()[7] == G2_MSM_Y1_LO,
    )
    // -G2 matches py_ecc neg(G2) and is valid
    assert(
        g.neg().words()[4] == G2_NEG_Y0_HI && g.neg().words()[5] == G2_NEG_Y0_LO,
    )
    assert(
        g.neg().words()[6] == G2_NEG_Y1_HI && g.neg().words()[7] == G2_NEG_Y1_LO,
    )
    assert(G2Bls::from_words(g.neg().words()).is_some())
    // invalid: (1, 1) not on the twist; non-canonical x0
    assert(G2Bls::from_words([0, 1, 0, 0, 0, 1, 0, 0]).is_none())
    assert(
        G2Bls::from_words(
            [P_HI, P_LO, G2_X1_HI, G2_X1_LO, G2_Y0_HI, G2_Y0_LO, G2_Y1_HI, G2_Y1_LO],
        )
            .is_none(),
    )
}

#[test]
fn pairing() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let p = G1Bls::generator()
    let q = G2Bls::generator()
    // e(P,Q) e(-P,Q) = 1
    assert(bls_pairing_check([p, p.neg()], [q, q]))
    // e(P,Q) e(P,Q) != 1
    assert(!bls_pairing_check([p, p], [q, q]))
    assert(!bls_pairing_check([p], [q]))
    // bilinearity: e(2P, Q) e(-P, 2Q) = 1
    assert(bls_pairing_check([g1_2(), p.neg()], [q, g2_2()]))
    assert(!bls_pairing_check([g1_2(), p], [q, g2_2()]))
}

#[test]
fn map_to_curve() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    // MAP_FP2_TO_G2(1 + 2u) vs py_ecc clear_cofactor_G2(map_to_curve_G2(FQ2([1, 2])))
    let r = bls_map_fp2_to_g2(0, 1, 0, 2)
    assert(
        r.words()[0] == MAP_G2_X0_HI && r.words()[1] == MAP_G2_X0_LO,
    )
    assert(
        r.words()[2] == MAP_G2_X1_HI && r.words()[3] == MAP_G2_X1_LO,
    )
    assert(
        r.words()[4] == MAP_G2_Y0_HI && r.words()[5] == MAP_G2_Y0_LO,
    )
    assert(
        r.words()[6] == MAP_G2_Y1_HI && r.words()[7] == MAP_G2_Y1_LO,
    )
    // G1 map: no py_ecc reference exists for the G1 SSWU map; check the output is a valid,
    // non-infinity subgroup point (and that it is accepted by the validating constructor).
    let s = bls_map_fp_to_g1(0, 1)
    assert(!s.is_infinity())
    assert(G1Bls::from_words(s.words()).unwrap().eq(s))
}

/// Calls a precompile with raw words and reports whether it succeeded.
fn raw_call(_ addr: u256, _ words: [u256; 5]) -> bool
uses (call: Call, ctx: Ctx)
{
    var input = MemBuffer::with_capacity(160)
    var i: usize = 0
    while i < 5 {
        unsafe {
            store_word(
                ptr: ptr::offset_bytes(input.ptr(), (i * 32) as u256),
                value: words[i],
            )
        }
        i += 1
    }
    unsafe {
        input.set_len(160)
    }
    var out = MemBuffer::with_capacity(128)
    call.raw_staticcall(
        addr: Address::new(addr),
        gas: 1000000,
        args: input.span(),
        ret: mut out,
    )
        .success()
}

#[test]
fn precompile_rejects_invalid_point()
uses (evm: mut Evm, call: Call, ctx: Ctx)
{
    // (1, 1) is not on the curve: the G1 MSM precompile must fail.
    assert(!raw_call(0x0c, [0, 1, 0, 1, 1]))
    // control: generator x scalar 1 succeeds
    assert(raw_call(0x0c, [G1_X_HI, G1_X_LO, G1_Y_HI, G1_Y_LO, 1]))
}

#[test]
fn point_evaluation_c_kzg_vector() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let c = Bytes48::new(KZG_C_HI, KZG_C_LO).unwrap()
    let pr = Bytes48::new(KZG_PROOF_HI, KZG_PROOF_LO).unwrap()
    assert(
        kzg_point_evaluation(KZG_VERSIONED_HASH, fr(KZG_Z), fr(KZG_Y), c, pr),
    )
    // tampered y, z, hash, proof, commitment are all rejected
    assert(
        !kzg_point_evaluation(KZG_VERSIONED_HASH, fr(KZG_Z), fr(KZG_Y + 1), c, pr),
    )
    assert(
        !kzg_point_evaluation(KZG_VERSIONED_HASH, fr(KZG_Z - 1), fr(KZG_Y), c, pr),
    )
    assert(
        !kzg_point_evaluation(KZG_VERSIONED_HASH + 1, fr(KZG_Z), fr(KZG_Y), c, pr),
    )
    assert(
        !kzg_point_evaluation(
            KZG_VERSIONED_HASH,
            fr(KZG_Z),
            fr(KZG_Y),
            c,
            Bytes48::new(KZG_PROOF_HI, KZG_PROOF_LO ^ 1).unwrap(),
        ),
    )
    // hi word wider than 16 bytes is not a Bytes48
    assert(
        Bytes48::new(0x100000000000000000000000000000000, 0).is_none(),
    )
}

#[test]
fn gas_report_bls() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let g = G1Bls::generator()
    let h = G2Bls::generator()
    var g0 = evm.gas()
    let two = bls_g1_add(g, g)
    evm.emit(GasUsed { what: 11, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let m = bls_g1_mul(g, fr(S1))
    evm.emit(GasUsed { what: 12, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let h2 = bls_g2_add(h, h)
    evm.emit(GasUsed { what: 13, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let ok = bls_pairing_check([g, g.neg()], [h, h])
    evm.emit(GasUsed { what: 14, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let v = G1Bls::from_words(g.words())
    evm.emit(GasUsed { what: 15, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let v2 = G2Bls::from_words(h.words())
    evm.emit(GasUsed { what: 16, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let c = Bytes48::new(KZG_C_HI, KZG_C_LO).unwrap()
    let pr = Bytes48::new(KZG_PROOF_HI, KZG_PROOF_LO).unwrap()
    let e = kzg_point_evaluation(KZG_VERSIONED_HASH, fr(KZG_Z), fr(KZG_Y), c, pr)
    evm.emit(GasUsed { what: 17, gas: g0 - evm.gas() })
    assert(
        ok
            && e
            && v.is_some()
            && v2.is_some()
            && !two.is_infinity()
            && !m.is_infinity()
            && !h2.is_infinity(),
    )
}
