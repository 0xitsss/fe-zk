//! halo2-KZG verifier tests. Proofs: halo2-axiom 0.5.3 (`vectors/halo2/standard_plonk_lookup`,
//! SHPLONK and GWC, EvmTranscript). Expected challenge values come from the independent Rust
//! mini verifier (`H2_TRACE=1 cargo test --test mini_verifier accepts_valid -- --nocapture`,
//! `vectors/halo2/src/mini_verifier.rs`), never from this repository's Fe code.
//! Gas: `fe test --filter halo2_gas --show-logs`.
use ingot::ec::G2
use ingot::field::{Bn254Fr, Field}
use ingot::ec::g1_mul
use ingot::verifier::halo2::common::{Halo2Vk, batch_inv, final_pairing, fr, g1_const, read_g1}
use ingot::tests::halo2_fixture::{GWC_INSTANCES, GWC_PROOF, SHPLONK_INSTANCES, SHPLONK_PROOF}
use ingot::verifier::halo2::common::Halo2Transcript
use ingot::verifier::halo2::standard_plonk_lookup::{
    Phase1,
    gwc_open,
    phase1,
    shplonk_check,
    shplonk_open,
    verify_gwc,
    verify_shplonk,
    vk,
}
use std::evm::{Call, Evm}

#[event]
struct GasUsed { what: u256, gas: u256 }

// Rust mini verifier, SHPLONK proof.
const SH_THETA: u256 = 0x096d208f9381f4df2ed616bf6d577cfe530a337f6afc8ef90dc589fc7e498448
const SH_BETA: u256 = 0x196ad17724ac121653d737d13ce818c9f2d84fd88b64cfa9bb611f520d33e0aa
const SH_GAMMA: u256 = 0x01ff2d08efda6919d7e1eb138e1a426a2a32816e31504483403d7d825491fe0a
const SH_Y: u256 = 0x206effda5ea41fe8a9cb06366764476a71ab4849474d4cff7902457ab5da2303
const SH_X: u256 = 0x27a381a1ab782c0b240e2e2e9c99288fe0c2cb640715d2f21250a5b10a3568d0
const SH_EXPECTED_H: u256 = 0x1ab7e28c1728c201924cbf647714933fd67852578af995c4e0fc9dac20a8caac
const SH_OPEN_Y: u256 = 0x222ec6901c899577c061ac817b14ed86ee0b6dade4acdc74ed1f60ff1afaab1e
const SH_OPEN_V: u256 = 0x2e2b21b810d61244f3787565c52f540229dc8097a4e962f6f58971dd6af70b38
const SH_OPEN_U: u256 = 0x065fe5c574261f77ad22bf6715071e8ac55cf88292ba5b17ab3df32b78ed7fe2
// Rust mini verifier, GWC proof.
const GW_THETA: u256 = 0x243dfa5b5f17bea65ed1a9fb232e24a88eded31f456cbd6099509b7ac0df4fc6
const GW_BETA: u256 = 0x0ec2b89299cee7da81ceddcde0f55c9786dfa20b4fb6c5fd45d1d0c45dff0d59
const GW_GAMMA: u256 = 0x2aedf9c789ea9cec44b736f80d41ae5fb32e68584ad086c90ec2a8dbaae7118e
const GW_Y: u256 = 0x2697e91284eb67c56776fcac1b801a2613f09eb25fdff262c6b190f0555e7f9c
const GW_X: u256 = 0x227c1fe6576c4e4ae0f6059c8b9cbf25bc44da863357d62688175bc44b4054ab
const GW_EXPECTED_H: u256 = 0x14d5eeaf3bfca175b5957b8b82d115078d5e82e17bf0b3452a0a841cc553a12a
const GW_OPEN_V: u256 = 0x180adf0fdf3e02d4c18dc578166b3f30eacc5da63d8192d3599b1fc6d4a62d29
const GW_OPEN_U: u256 = 0x1f39e7ffb0794886b3f3b0ca972ace3c0f426246264bcab5a95d030bd3d48df2

#[test]
fn shplonk_challenges_match_rust() uses (call: Call) {
    var tr = Halo2Transcript::new()
    let p = phase1(vk(), SHPLONK_PROOF, SHPLONK_INSTANCES, mut tr).unwrap()
    assert(p.theta.to_canonical() == SH_THETA)
    assert(p.beta.to_canonical() == SH_BETA)
    assert(p.gamma.to_canonical() == SH_GAMMA)
    assert(p.y.to_canonical() == SH_Y)
    assert(p.x.to_canonical() == SH_X)
    assert(p.expected_h.to_canonical() == SH_EXPECTED_H)
    let o = shplonk_open(SHPLONK_PROOF, mut tr).unwrap()
    assert(o.y.to_canonical() == SH_OPEN_Y)
    assert(o.v.to_canonical() == SH_OPEN_V)
    assert(o.u.to_canonical() == SH_OPEN_U)
}

#[test]
fn gwc_challenges_match_rust() uses (call: Call) {
    var tr = Halo2Transcript::new()
    let p = phase1(vk(), GWC_PROOF, GWC_INSTANCES, mut tr).unwrap()
    assert(p.theta.to_canonical() == GW_THETA)
    assert(p.beta.to_canonical() == GW_BETA)
    assert(p.gamma.to_canonical() == GW_GAMMA)
    assert(p.y.to_canonical() == GW_Y)
    assert(p.x.to_canonical() == GW_X)
    assert(p.expected_h.to_canonical() == GW_EXPECTED_H)
    let o = gwc_open(GWC_PROOF, mut tr).unwrap()
    assert(o.v.to_canonical() == GW_OPEN_V)
    assert(o.u.to_canonical() == GW_OPEN_U)
}

#[test]
fn shplonk_accepts() uses (call: Call) {
    assert(verify_shplonk(vk(), SHPLONK_PROOF, SHPLONK_INSTANCES))
}

#[test]
fn gwc_accepts() uses (call: Call) {
    assert(verify_gwc(vk(), GWC_PROOF, GWC_INSTANCES))
}

// ---------------------------------------------------------------- rejection helpers

const Q: u256 = 21888242871839275222246405745257275088696311157297823662689037894645226208583
const R: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617
// Proof layout (SPEC section 3): words 0..25 are 13 commitments, 26..52 are 27 evaluations,
// then the opening: SHPLONK h1 (53, 54), h2 (55, 56); GWC witness points W_0..W_3 (53..60).
const EVAL_START: usize = 26
const OPEN_START: usize = 53

fn is_point_word(_ i: usize) -> bool {
    i < EVAL_START || i >= OPEN_START
}

fn is_x_word(_ i: usize) -> bool {
    if i < EVAL_START {
        i % 2 == 0
    } else {
        i >= OPEN_START && (i - OPEN_START) % 2 == 0
    }
}

// ---------------------------------------------------------------- SHPLONK rejections

#[test]
fn shplonk_rejects_wrong_instance() uses (call: Call) {
    let k = vk()
    assert(
        !verify_shplonk(k, SHPLONK_PROOF, [SHPLONK_INSTANCES[0] + 1]),
    )
    assert(!verify_shplonk(k, SHPLONK_PROOF, [0]))
    // non-canonical instance (value + r): rejected, not reduced
    assert(
        !verify_shplonk(k, SHPLONK_PROOF, [SHPLONK_INSTANCES[0] + R]),
    )
}

#[test]
fn shplonk_rejects_every_word_plus_one() uses (call: Call) {
    let k = vk()
    var i: usize = 0
    while i < 57 {
        var p = SHPLONK_PROOF
        p[i] = p[i] + 1
        assert(!verify_shplonk(k, p, SHPLONK_INSTANCES))
        i += 1
    }
}

#[test]
fn shplonk_rejects_negated_points() uses (call: Call) {
    // y -> q - y stays on the curve and canonical: only the pairing / transcript can object.
    let k = vk()
    var i: usize = 0
    while i < 57 {
        if is_point_word(i) && !is_x_word(i) {
            var p = SHPLONK_PROOF
            p[i] = Q - p[i]
            assert(!verify_shplonk(k, p, SHPLONK_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn shplonk_rejects_swapped_commitments() uses (call: Call) {
    let k = vk()
    var p = SHPLONK_PROOF
    p[0] = SHPLONK_PROOF[2]
    p[1] = SHPLONK_PROOF[3]
    p[2] = SHPLONK_PROOF[0]
    p[3] = SHPLONK_PROOF[1]
    assert(!verify_shplonk(k, p, SHPLONK_INSTANCES))
    // swapped evaluations
    var q = SHPLONK_PROOF
    q[26] = SHPLONK_PROOF[27]
    q[27] = SHPLONK_PROOF[26]
    assert(!verify_shplonk(k, q, SHPLONK_INSTANCES))
}

#[test]
fn shplonk_rejects_non_canonical_and_off_curve() uses (call: Call) {
    let k = vk()
    var i: usize = EVAL_START
    while i < OPEN_START {
        // evaluation + r is the same field element but not canonical
        var p = SHPLONK_PROOF
        p[i] = p[i] + R
        assert(!verify_shplonk(k, p, SHPLONK_INSTANCES))
        i += 1
    }
    // coordinate + q: same residue, not canonical
    var a = SHPLONK_PROOF
    a[0] = a[0] + Q
    assert(!verify_shplonk(k, a, SHPLONK_INSTANCES))
    var b = SHPLONK_PROOF
    b[55] = b[55] + Q
    assert(!verify_shplonk(k, b, SHPLONK_INSTANCES))
    // off curve: y + 1
    var c = SHPLONK_PROOF
    c[1] = c[1] + 1
    assert(!verify_shplonk(k, c, SHPLONK_INSTANCES))
    // point at infinity as a commitment / as an opening proof
    var d = SHPLONK_PROOF
    d[0] = 0
    d[1] = 0
    assert(!verify_shplonk(k, d, SHPLONK_INSTANCES))
    var e = SHPLONK_PROOF
    e[53] = 0
    e[54] = 0
    assert(!verify_shplonk(k, e, SHPLONK_INSTANCES))
    var f = SHPLONK_PROOF
    f[55] = 0
    f[56] = 0
    assert(!verify_shplonk(k, f, SHPLONK_INSTANCES))
}

#[test]
fn shplonk_rejects_wrong_vk_constant() uses (call: Call) {
    let k = vk()
    let bad = k.with_transcript_repr(k.transcript_repr().add(Bn254Fr::one()))
    assert(verify_shplonk(k, SHPLONK_PROOF, SHPLONK_INSTANCES))
    assert(!verify_shplonk(bad, SHPLONK_PROOF, SHPLONK_INSTANCES))
}

// ---------------------------------------------------------------- GWC rejections

#[test]
fn gwc_rejects_wrong_instance() uses (call: Call) {
    let k = vk()
    assert(!verify_gwc(k, GWC_PROOF, [GWC_INSTANCES[0] + 1]))
    assert(!verify_gwc(k, GWC_PROOF, [0]))
    assert(!verify_gwc(k, GWC_PROOF, [GWC_INSTANCES[0] + R]))
}

#[test]
fn gwc_rejects_every_word_plus_one() uses (call: Call) {
    let k = vk()
    var i: usize = 0
    while i < 61 {
        var p = GWC_PROOF
        p[i] = p[i] + 1
        assert(!verify_gwc(k, p, GWC_INSTANCES))
        i += 1
    }
}

#[test]
fn gwc_rejects_negated_points() uses (call: Call) {
    let k = vk()
    var i: usize = 0
    while i < 61 {
        if is_point_word(i) && !is_x_word(i) {
            var p = GWC_PROOF
            p[i] = Q - p[i]
            assert(!verify_gwc(k, p, GWC_INSTANCES))
        }
        i += 1
    }
}

#[test]
fn gwc_rejects_non_canonical_and_off_curve() uses (call: Call) {
    let k = vk()
    var i: usize = EVAL_START
    while i < OPEN_START {
        var p = GWC_PROOF
        p[i] = p[i] + R
        assert(!verify_gwc(k, p, GWC_INSTANCES))
        i += 1
    }
    var a = GWC_PROOF
    a[53] = a[53] + Q
    assert(!verify_gwc(k, a, GWC_INSTANCES))
    var c = GWC_PROOF
    c[60] = c[60] + 1
    assert(!verify_gwc(k, c, GWC_INSTANCES))
    var d = GWC_PROOF
    d[57] = 0
    d[58] = 0
    assert(!verify_gwc(k, d, GWC_INSTANCES))
}

#[test]
fn gwc_rejects_wrong_vk_constant() uses (call: Call) {
    let k = vk()
    let bad = k.with_transcript_repr(k.transcript_repr().add(Bn254Fr::one()))
    assert(!verify_gwc(bad, GWC_PROOF, GWC_INSTANCES))
}

// ---------------------------------------------------------------- transcript binding (rule 5)

fn sh_last_challenge(_ k: Halo2Vk, _ proof: [u256; 57], _ inst: [u256; 1]) -> Bn254Fr
uses (call: Call)
{
    var tr = Halo2Transcript::new()
    let _p = phase1(k, proof, inst, mut tr).unwrap()
    shplonk_open(proof, mut tr).unwrap().u
}

fn gw_last_challenge(_ k: Halo2Vk, _ proof: [u256; 61], _ inst: [u256; 1]) -> Bn254Fr
uses (call: Call)
{
    var tr = Halo2Transcript::new()
    let _p = phase1(k, proof, inst, mut tr).unwrap()
    gwc_open(proof, mut tr).unwrap().u
}

#[test]
fn shplonk_challenges_bind_every_input() uses (call: Call) {
    // The last squeeze (u) hashes the whole history: changing the vk constant, any instance or any
    // proof word that is absorbed before it (all but h2) must change it. Point x-words are covered
    // by `transcript_absorbs_coordinates` (changing them makes the point leave the curve).
    let k = vk()
    let base = sh_last_challenge(k, SHPLONK_PROOF, SHPLONK_INSTANCES)
    assert(base.to_canonical() == SH_OPEN_U)
    assert(
        !sh_last_challenge(k, SHPLONK_PROOF, [SHPLONK_INSTANCES[0] + 1]).eq(base),
    )
    let bad = k.with_transcript_repr(k.transcript_repr().add(Bn254Fr::one()))
    assert(
        !sh_last_challenge(bad, SHPLONK_PROOF, SHPLONK_INSTANCES).eq(base),
    )
    var i: usize = 0
    while i < 55 {
        if !is_x_word(i) {
            var p = SHPLONK_PROOF
            if is_point_word(i) {
                p[i] = Q - p[i]
            } else {
                p[i] = p[i] + 1
            }
            assert(!sh_last_challenge(k, p, SHPLONK_INSTANCES).eq(base))
        }
        i += 1
    }
}

#[test]
fn gwc_challenges_bind_every_input() uses (call: Call) {
    let k = vk()
    let base = gw_last_challenge(k, GWC_PROOF, GWC_INSTANCES)
    assert(base.to_canonical() == GW_OPEN_U)
    assert(
        !gw_last_challenge(k, GWC_PROOF, [GWC_INSTANCES[0] + 1]).eq(base),
    )
    let bad = k.with_transcript_repr(k.transcript_repr().add(Bn254Fr::one()))
    assert(!gw_last_challenge(bad, GWC_PROOF, GWC_INSTANCES).eq(base))
    var i: usize = 0
    while i < 61 {
        if !is_x_word(i) {
            var p = GWC_PROOF
            if is_point_word(i) {
                p[i] = Q - p[i]
            } else {
                p[i] = p[i] + 1
            }
            assert(!gw_last_challenge(k, p, GWC_INSTANCES).eq(base))
        }
        i += 1
    }
}

#[test]
fn transcript_absorbs_coordinates() {
    var a = Halo2Transcript::new()
    a.absorb_point(5, 7)
    var b = Halo2Transcript::new()
    b.absorb_point(6, 7)
    var c = Halo2Transcript::new()
    c.absorb_point(5, 8)
    var d = Halo2Transcript::new()
    d.absorb_point(7, 5)
    let ca = a.squeeze()
    assert(!ca.eq(b.squeeze()))
    assert(!ca.eq(c.squeeze()))
    assert(!ca.eq(d.squeeze()))
}

#[test]
fn transcript_one_word_squeeze_is_domain_separated() {
    // A buffer of exactly one word is hashed with a 0x01 suffix; two squeezes in a row chain.
    var t = Halo2Transcript::new()
    t.absorb(1)
    let c1 = t.squeeze()
    let c2 = t.squeeze()
    assert(!c1.eq(c2))
    var u = Halo2Transcript::new()
    u.absorb(1)
    // deterministic
    assert(u.squeeze().eq(c1))
}

// ---------------------------------------------------------------- gas

#[test]
fn halo2_gas_report() uses (evm: mut Evm, call: Call) {
    var g0 = evm.gas()
    let k = vk()
    evm.emit(GasUsed { what: 0, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let a = verify_shplonk(k, SHPLONK_PROOF, SHPLONK_INSTANCES)
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let b = verify_gwc(k, GWC_PROOF, GWC_INSTANCES)
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(a && b)
}

#[test]
fn halo2_gas_phases() uses (evm: mut Evm, call: Call) {
    let k = vk()
    var tr = Halo2Transcript::new()
    var g0 = evm.gas()
    let p1 = phase1(k, SHPLONK_PROOF, SHPLONK_INSTANCES, mut tr).unwrap()
    evm.emit(GasUsed { what: 10, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let o = shplonk_open(SHPLONK_PROOF, mut tr).unwrap()
    evm.emit(GasUsed { what: 11, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let ok = shplonk_check(k, p1, o)
    evm.emit(GasUsed { what: 12, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let pt = read_g1(SHPLONK_PROOF[0], SHPLONK_PROOF[1]).unwrap()
    evm.emit(GasUsed { what: 13, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let q = g1_const(SHPLONK_PROOF[0], SHPLONK_PROOF[1])
    evm.emit(GasUsed { what: 14, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let m = g1_mul(pt, p1.x)
    evm.emit(GasUsed { what: 15, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let ii = batch_inv([p1.x, p1.y, p1.beta])
    evm.emit(GasUsed { what: 16, gas: g0 - evm.gas() })
    g0 = evm.gas()
    let fin = final_pairing(k, pt, q)
    evm.emit(GasUsed { what: 17, gas: g0 - evm.gas() })
    assert(ok)
}
