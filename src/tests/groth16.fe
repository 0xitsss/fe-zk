/// Every invalid case must be rejected; the valid one accepted. `oa/ob/oc` is a valid proof of a
/// different circuit.
fn battery<const N: usize>(
    _ vk: groth16::Vk<N>,
    _ a: [u256; 2],
    _ b: [[u256; 2]; 2],
    _ c: [u256; 2],
    _ x: [u256; N],
    _ oa: [u256; 2],
    _ ob: [[u256; 2]; 2],
    _ oc: [u256; 2],
)
uses (call: Call, ctx: Ctx)
{
    assert(groth16::verify_calldata(vk, a, b, c, x))
    // tampered proof elements (other valid points)
    assert(!groth16::verify_calldata(vk, [1, 2], b, c, x))
    assert(!groth16::verify_calldata(vk, a, b, [1, 2], x))
    let gb: [[u256; 2]; 2] = [
        [
            10857046999023057135944570762232829481370756359578518086990519993285655852781,
            11559732032986387107991004021392285783925812861821192530917403151452391805634,
        ],
        [
            8495653923123431417604973247489272438418190587263600148770280649306958101930,
            4082367875863433681332203403145435568316851327593401208105741076214120093531,
        ],
    ]
    assert(!groth16::verify_calldata(vk, a, gb, c, x))
    // A = -A, C = infinity
    assert(!groth16::verify_calldata(vk, [a[0], Q - a[1]], b, c, x))
    assert(!groth16::verify_calldata(vk, a, b, [0, 0], x))
    // tampered public input
    var t = x
    t[0] = x[0] + 1
    assert(!groth16::verify_calldata(vk, a, b, c, t))
    // non-canonical public input: r and x + r (same residue mod r)
    var nc = x
    nc[0] = R
    assert(!groth16::verify_calldata(vk, a, b, c, nc))
    nc[0] = x[0] + R
    assert(!groth16::verify_calldata(vk, a, b, c, nc))
    // A, C, B not on curve; non-canonical coordinates
    assert(!groth16::verify_calldata(vk, [a[0], a[1] + 1], b, c, x))
    assert(!groth16::verify_calldata(vk, a, b, [c[0], c[1] + 1], x))
    assert(!groth16::verify_calldata(vk, [a[0] + Q, a[1]], b, c, x))
    assert(
        !groth16::verify_calldata(vk, a, [[b[0][0] + Q, b[0][1]], b[1]], c, x),
    )
    assert(
        !groth16::verify_calldata(vk, a, [[b[0][0] + 1, b[0][1]], b[1]], c, x),
    )
    assert(
        !groth16::verify_calldata(vk, a, [b[0], [b[1][0], b[1][1] + 1]], c, x),
    )
    // B on the twist but outside the order-r subgroup: pairing precompile rejects
    assert(
        !groth16::verify_calldata(vk, a, [[BAD_X0, BAD_X1], [BAD_Y0, BAD_Y1]], c, x),
    )
    // B real/imag swapped
    assert(
        !groth16::verify_calldata(vk, a, [[b[0][1], b[0][0]], [b[1][1], b[1][0]]], c, x),
    )
    // proof of a different circuit
    assert(!groth16::verify_calldata(vk, oa, ob, oc, x))
}

/// Swapped public inputs (only meaningful for N >= 2 with distinct inputs).
fn swapped<const N: usize>(
    _ vk: groth16::Vk<N>,
    _ a: [u256; 2],
    _ b: [[u256; 2]; 2],
    _ c: [u256; 2],
    _ x: [u256; N],
)
uses (call: Call, ctx: Ctx)
{
    var s = x
    s[0] = x[1]
    s[1] = x[0]
    assert(!groth16::verify_calldata(vk, a, b, c, s))
}

