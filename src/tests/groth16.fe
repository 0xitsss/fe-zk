#[test]
fn groth16_typed_api_and_gas() uses (evm: mut Evm, call: Call, ctx: Ctx) {
    let p_multiplier = groth16::Proof {
        a: G1::from_coords(
            7721094462243721192636187423381229733086297345272207725305842020332867459139,
            11777289101270056922347586881428666908464962277362243260779970953004571759317,
        )
            .unwrap(),
        b: G2Proof::from_coords(
            5161316430930545003086711383422200777738761246325689252635909985486544014740,
            21277750394916048891567404513831611180277166162069260510584357133920202477378,
            14422645920932369733545549060456712166692491266940685185992320759644209162950,
            14103470080089620595572674831392059767207721215286838770055244440766897379157,
        )
            .unwrap(),
        c: G1::from_coords(
            10472107627023360383508793401069183758176138362484573046971854801581908968635,
            10213754952762924117787775756330474509176482092373894806045581838250651582842,
        )
            .unwrap(),
    }
    let g0 = evm.gas()
    let ok = groth16::verify(
        vk_multiplier(),
        p_multiplier,
        [Bn254Fr::from_canonical(33).unwrap()],
    )
    evm.emit(GasUsed { what: 1, gas: g0 - evm.gas() })
    assert(ok)
    let p_multiplier2 = groth16::Proof {
        a: G1::from_coords(
            7448169393390896365717508977079948665922164597790969091221782932347809683962,
            856045400059498295244774248674336299011578222471765182142698656190995343630,
        )
            .unwrap(),
        b: G2Proof::from_coords(
            10128683618413140045832818953114530727358033116612254975979393217023646851938,
            19218880711464147920097216256888416352504874737662349918493822731203259458251,
            2514235191151238097241823538264318835446406500039375754258699347627251407100,
            10619580949012590390672218647453077680869449321532047878779645275033390063317,
        )
            .unwrap(),
        c: G1::from_coords(
            6485723789840182790847565595236775070775044884799420435840409733046332409240,
            541881383159464474220678934842776834622831092755233222115972544615651141303,
        )
            .unwrap(),
    }
    let g0 = evm.gas()
    let ok = groth16::verify(
        vk_multiplier2(),
        p_multiplier2,
        [Bn254Fr::from_canonical(33).unwrap(), Bn254Fr::from_canonical(3).unwrap()],
    )
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
    let p_membership = groth16::Proof {
        a: G1::from_coords(
            4810324548919303361454080852949399341251465853266531024202729714256110489100,
            4383764383867240769946101020631750830960248787804111379654989428515210551642,
        )
            .unwrap(),
        b: G2Proof::from_coords(
            1346057116814476322966968175818005845439873037298363623843134106877307230160,
            17955696674244493069972090660647218670591196779990137609414587241595350267421,
            13356802564776808361050405961947942888380846875062389841372666599018877954098,
            17420785254547499407538936354725539446900210726630024041019211685495213571718,
        )
            .unwrap(),
        c: G1::from_coords(
            6277219283657834626001126706744000795208989989970507915477603621299499912940,
            11875430409138379404621278268851773883837601194074295378801367390407554264959,
        )
            .unwrap(),
    }
    let g0 = evm.gas()
    let ok = groth16::verify(
        vk_membership(),
        p_membership,
        [
            Bn254Fr::from_canonical(
                7660491506204830424814091262400682580837717357496492544955978635994034360477,
            )
                .unwrap(),
            Bn254Fr::from_canonical(
                7665984613125835945366725920449367301376388972167285630482190992601747249991,
            )
                .unwrap(),
            Bn254Fr::from_canonical(42).unwrap(),
        ],
    )
    evm.emit(GasUsed { what: 3, gas: g0 - evm.gas() })
    assert(ok)
    let p_arkworks_multiplier = groth16::Proof {
        a: G1::from_coords(
            6900011799472017852709358998924779597396061434911732717830649596747462869210,
            8246957783612612618478571772354806455626560485462455804576203830129044049040,
        )
            .unwrap(),
        b: G2Proof::from_coords(
            12132957528234208984946680278472985574491719793837713999033888943313265886448,
            21121734875447969571170928235794454119532425106321145032209044568878078233146,
            3806290818705107664624213493822777588836883132344626149434855314159121863566,
            10939691338038411330661269417723408580609751155003728996722395881854725860109,
        )
            .unwrap(),
        c: G1::from_coords(
            13948620245048379709643599510781879087556128090867789155184328597399803805090,
            2305669142398236144018649607671670779538210455660732783508964808216647276211,
        )
            .unwrap(),
    }
    let g0 = evm.gas()
    let ok = groth16::verify(
        vk_arkworks_multiplier(),
        p_arkworks_multiplier,
        [Bn254Fr::from_canonical(91).unwrap(), Bn254Fr::from_canonical(7).unwrap()],
    )
    evm.emit(GasUsed { what: 2, gas: g0 - evm.gas() })
    assert(ok)
}

/// A `G2Proof` accepts an on-curve non-subgroup point (the full `G2` check rejects it); the pairing
/// precompile then fails (EIP-197), which `pairing_try_proof` / `verify` map to `false`.
#[test]
fn proof_g2_non_subgroup_passes_cheap_check_then_pairing_rejects()
uses (call: Call, ctx: Ctx)
{
    assert(
        G2Proof::from_coords(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1).is_some(),
    )
    assert(G2::from_coords(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1).is_none())
    let bad = G2Proof::from_coords(BAD_X0, BAD_X1, BAD_Y0, BAD_Y1).unwrap()
    let g = G1::generator()
    assert(!ingot::ec::pairing_try_proof([g], [bad]))
    // off-curve or non-canonical coordinates never become a G2Proof
    assert(
        G2Proof::from_coords(BAD_X0, BAD_X1, BAD_Y0 + 1, BAD_Y1).is_none(),
    )
    assert(
        G2Proof::from_coords(BAD_X0 + Q, BAD_X1, BAD_Y0, BAD_Y1).is_none(),
    )
    // infinity is explicit
    assert(G2Proof::from_coords(0, 0, 0, 0).is_some())
}

/// The validated-constants constructors agree with the checked ones on the real key points.
#[test]
fn vk_constants_pass_full_checks() {
    assert(
        G2::from_coords(
            16348171800823588416173124589066524623406261996681292662100840445103873053252,
            3182164110458002340215786955198810119980427837186618912744689678939861918171,
            19687132236965066906216944365591810874384658708175106803089633851114028275753,
            4920802715848186258981584729175884379674325733638798907835771393452862684714,
        )
            .is_some(),
    )
    assert(
        G2::from_coords(
            10857046999023057135944570762232829481370756359578518086990519993285655852781,
            11559732032986387107991004021392285783925812861821192530917403151452391805634,
            8495653923123431417604973247489272438418190587263600148770280649306958101930,
            4082367875863433681332203403145435568316851327593401208105741076214120093531,
        )
            .is_some(),
    )
    assert(
        G2::from_coords(
            14913740744676684184668952065876416917858225268323445330455000270697881319239,
            9603670685741758605208574561654648282688098529260259015128293170251509994135,
            829557247008481397333281466133926567863254073159914880726652034984202334034,
            15837093381311288060927867046628133767772478211080758627242136948352155192904,
        )
            .is_some(),
    )
}
