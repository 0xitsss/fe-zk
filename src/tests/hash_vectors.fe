#[test]
fn poseidon2_bn254_t3_reference_kat() {
    let o = bn254_t3_permute([fr(0), fr(1), fr(2)])
    assert(
        o[0].to_canonical() == 0x0bb61d24daca55eebcb1929a82650f328134334da98ea4f847f760054f4a3033,
    )
    assert(
        o[1].to_canonical() == 0x303b6f7c86d043bfcbcc80214f26a30277a15d3f74ca654992defe7ff8d03570,
    )
    assert(
        o[2].to_canonical() == 0x1ed25194542b12eef8617361c3ba7c52e660b145994427cc86296242cf766ec8,
    )
}

