#[test]
fn merkle_koalabear_plonky3_tree() {
    let leaf = kb8([5001, 5002, 5003, 5004, 5005, 5006, 5007, 5008])
    let path = [
        kb8([4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008]),
        kb8(
            [
                1873774777,
                1352268176,
                490137709,
                393838869,
                1921513666,
                1643326446,
                395233943,
                1466824967,
            ],
        ),
        kb8(
            [
                678820712,
                1739125421,
                176683556,
                1735657085,
                855955250,
                24987058,
                1879613155,
                382408844,
            ],
        ),
    ]
    let root = kb8(
        [121365648, 1445208908, 348576657, 319183891, 1061102753, 235181555, 257876720, 1809633107],
    )
    let r = merkle_root<KoalaBearPoseidon2, [KoalaBear; 8], 3>(leaf, 5, path)
    assert(r.is_some())
    assert(eq8(r.unwrap(), root))
    // wrong index (bit flipped), wrong leaf, and an index beyond the tree depth
    assert(
        !eq8(
            merkle_root<KoalaBearPoseidon2, [KoalaBear; 8], 3>(leaf, 4, path).unwrap(),
            root,
        ),
    )
    var bad = leaf
    bad[0] = kb(5)
    assert(
        !eq8(
            merkle_root<KoalaBearPoseidon2, [KoalaBear; 8], 3>(bad, 5, path).unwrap(),
            root,
        ),
    )
    assert(
        merkle_root<KoalaBearPoseidon2, [KoalaBear; 8], 3>(leaf, 8 + 5, path).is_none(),
    )
}

#[test]
fn transcript_matches_ethers_keccak_reference() {
    var t = Transcript::new(507042409845538478652176950032)
    t.absorb(11)
    t.absorb(22)
    t.absorb_point(33, 44)
    assert(
        t.squeeze(418431133793).to_canonical()
            == 21400286850664361936501651031547911771004354812263853161407492323832945223353,
    )
    t.absorb(
        21888242871839275222246405745257275088548364400416034343698204186575808495616,
    )
    assert(
        t.squeeze(1650816097).to_canonical()
            == 6302330727419064101759296396214062622393779306411144942911581272170730021067,
    )
    assert(
        t.squeeze(1650816097).to_canonical()
            == 11920222599340202064459287353104877833711856241610501782294378388393463856065,
    )
}
