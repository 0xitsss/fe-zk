use ingot::field::{Bn254Fr, Field, KoalaBear}
use ingot::hash::{
    Bn254Poseidon2,
    KoalaBearPoseidon2,
    Transcript,
    bn254_t3_permute,
    koalabear_t16_permute,
    merkle_root,
    poseidon_1,
    poseidon_2,
    poseidon_3,
    poseidon_4,
    poseidon_5,
}

fn fr(_ v: u256) -> Bn254Fr {
    match Bn254Fr::from_canonical(v) {
        Option::Some(x) => x,
        Option::None => {
            assert(false)
            Bn254Fr::zero()
        },
    }
}

fn kb(_ v: u256) -> KoalaBear {
    match KoalaBear::from_canonical(v) {
        Option::Some(x) => x,
        Option::None => {
            assert(false)
            KoalaBear::zero()
        },
    }
}

fn kb8(_ a: [u256; 8]) -> [KoalaBear; 8] {
    [kb(a[0]), kb(a[1]), kb(a[2]), kb(a[3]), kb(a[4]), kb(a[5]), kb(a[6]), kb(a[7])]
}

fn kb16(_ a: [u256; 16]) -> [KoalaBear; 16] {
    var out: [KoalaBear; 16] = [KoalaBear::zero(); 16]
    var i: usize = 0
    while i < 16 {
        out[i] = kb(a[i])
        i += 1
    }
    out
}

fn eq8(_ a: [KoalaBear; 8], _ b: [KoalaBear; 8]) -> bool {
    var i: usize = 0
    while i < 8 {
        if !a[i].eq(b[i]) {
            return false
        }
        i += 1
    }
    true
}

fn eq16(_ a: [KoalaBear; 16], _ b: [KoalaBear; 16]) -> bool {
    var i: usize = 0
    while i < 16 {
        if !a[i].eq(b[i]) {
            return false
        }
        i += 1
    }
    true
}

