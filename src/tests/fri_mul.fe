#[event]
struct GasUsed { what: u256, gas: u256 }

#[test]
fn mul_gas_of_verification() uses (evm: mut Evm) {
    let proof = mul_proof()
    let pubv = public_values(MUL_PUBLIC)
    let g0 = evm.gas()
    let ok = verify<MulAir>(PARAMS, proof, pubv)
    let used = g0 - evm.gas()
    evm.emit(GasUsed { what: 1, gas: used })
    assert(ok)
}
