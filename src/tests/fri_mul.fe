//! The secure FRI/STARK configuration (`config_mul`): a real Plonky3 proof, at least 100
//! conjectured bits, run through the shared suite `fri_suite.fe`. Fixture: `fri_fixture_mul.fe`.
use std::evm::Evm
use ingot::verifier::fri::{public_values, verify}
use ingot::verifier::fri::air_mul::MulAir
use ingot::verifier::fri::config_mul::{CONJECTURED_BITS, MAX_PROOF_WORDS, PARAMS}
use ingot::verifier::fri::{conjectured_bits, proof_words}
use ingot::tests::fri_suite
use ingot::tests::fri_fixture_mul::{
    MUL_PROOF_WORDS,
    MUL_PUBLIC,
    TR_ALPHA,
    TR_BETAS,
    TR_FRI_ALPHA,
    TR_INDICES,
    TR_ZETA,
    mul_proof,
}

#[test]
fn mul_config_matches_fixture() {
    assert(MUL_PROOF_WORDS <= MAX_PROOF_WORDS)
    assert(
        proof_words(PARAMS, mul_proof()) == (MUL_PROOF_WORDS as u256),
    )
    assert(conjectured_bits(PARAMS) == CONJECTURED_BITS)
    assert(CONJECTURED_BITS >= 100)
    assert(
        PARAMS.num_queries * PARAMS.log_blowup + PARAMS.query_pow_bits >= 100,
    )
    fri_suite::layout_is_consistent(PARAMS, mul_proof())
}

#[test]
fn mul_transcript_matches_plonky3() {
    fri_suite::transcript_matches(
        PARAMS,
        mul_proof(),
        public_values(MUL_PUBLIC),
        TR_ALPHA,
        TR_ZETA,
        TR_FRI_ALPHA,
        TR_BETAS,
        TR_INDICES,
    )
}

#[test]
fn mul_accepts_plonky3_fibonacci_proof() {
    fri_suite::accepts<MulAir>(PARAMS, mul_proof(), public_values(MUL_PUBLIC))
}

#[test]
fn mul_rejects_tampered_merkle_siblings() {
    fri_suite::rejects_tampered_merkle_siblings<MulAir>(
        PARAMS,
        mul_proof(),
        public_values(MUL_PUBLIC),
    )
}

