//! FRI / STARK verifier for a Plonky3 `p3-uni-stark` proof (v0.4.2), generic over the AIR.
//!
//! `verify<A: Air>` takes the AIR as a type parameter (`fri/air.fe`; `fri/air_fib.fe` and
//! `fri/air_mul.fe` are two real ones). Everything that depends on the AIR is a compile-time
//! constant of `A` (`A::WIDTH`, `A::NUM_PUBLIC`, `A::MAX_DEGREE`) or the body of `A::eval`, so
//! each instantiation is plain monomorphised code. How to add an AIR: `docs/DESIGN.md`.
//!
//! What is fixed: base field KoalaBear, challenge field `BinomialExtensionField<KoalaBear, 4>`
//! (`x^4 = 3`), FRI arity 2, one trace commitment (`WIDTH` columns), one quotient chunk (AIR
//! constraint degree at most 2), Keccak-256 Merkle commitments over little-endian `u32` rows and
//! the Keccak `SerializingChallenger32` transcript (`fri/challenger.fe`, `fri/merkle.fe`).
//!
//! What is a per-configuration constant: everything in `FriParams` (trace width, trace height,
//! blowup, final polynomial length, number of queries, proof-of-work bits). The constants live in
//! a small module emitted from the Plonky3 proof's own configuration by
//! `vectors/plonky3-stark/emit_fe.py` (`fri/config_secure.fe`, `fri/config_demo.fe`,
//! `fri/config_mul.fe`); the verifier logic below is the same code for every configuration and
//! loops over the queries, the fold rounds, the Merkle levels and the trace columns instead of
//! unrolling them.
//!
//! The proof is one flat array of `proof_words(params)` words (field elements are canonical
//! integers, hashes are 32-byte words). Layout (offsets are functions of the parameters), with
//! `W = width`:
//!
//! ```text
//! trace_commit, quotient_commit,
//! trace_local[W] (4 words each), trace_next[W], quotient_chunk[4],
//! fri_commits[F], commit_pow_witnesses[F], final_poly[2^log_final] (4 words each),
//! query_pow_witness,
//! then NUM_QUERIES times:
//!   trace_row[W], trace_path[LH], quotient_row[4], quotient_path[LH],
//!   fold_sibling[F] (4 words each), fold_paths (F paths, lengths LH-1, LH-2, ..., LH-F)
//! ```
//!
//! with `F = log_n - log_final` fold rounds and `LH = log_n + log_blowup`. A proof with any
//! other length is rejected by `verify` (the public values are a `MemArray` whose length is
//! checked against `A::NUM_PUBLIC`: safety rule 4).
//!
//! SECURITY. The soundness of a proof is set by the configuration constants, not by this
//! code. Plonky3's own convention (`FriParameters::conjectured_soundness_bits`, the ethSTARK
//! conjecture) is `log_blowup * num_queries + query_proof_of_work_bits`.
//! - `config_secure`: trace 2^10 rows, `log_blowup = 4`, 20 queries, 20 bits of query proof of
//!   work: 4 * 20 + 20 = 100 conjectured bits. The proven figure is far lower: about 58 bits
//!   with the Johnson bound and about 38 bits in the unique-decoding regime (estimates in
//!   `docs/DESIGN.md`, "FRI/STARK verifier"). So this is "100 bits under the standard
//!   conjecture", not a proof of 100 bits; this is a research-grade verifier, not an audited
//!   one.
//! - `config_demo`: 4 queries, `log_blowup = 2`, 3 bits of proof of work: about 11 bits. It
//!   exists to test a second configuration and is NOT a secure configuration.
//!
//! The protocol logic follows `p3_uni_stark::verify`, `TwoAdicFriPcs::verify` and
//! `p3_fri::verify_fri` step by step; comments name the Plonky3 counterpart.
//!
//! Safety rules: 1 (every field element of the proof and the public values is checked
//! `< p` before use: `proof_header_is_canonical` up front, the per-query words by `check_query`
//! with `noncanonical`; `proof_is_canonical` is the full pre-check with the same verdict), 4 (public
//! value count is checked against `A::NUM_PUBLIC`, the trace width against `A::WIDTH`, the proof
//! length against the parameters), 5 (the transcript observes the same data in the same order as Plonky3, and tests
//! check that every observed input changes the challenges), 7 (the base-field arithmetic of the
//! hot paths uses `#[arithmetic(unchecked)]` on canonical values only, with the bound stated in the
//! doc comment of each function: `check_query`, `open_input`, `leaf8`, `horner_final`, `noncanonical`,
//! `words_canonical`, `open_input`, `Ext4::mul_lazy`, `climb_path`; shifts and indices are bounded by
//! `params_valid`).
use core::ptr::{MemArray, offset_bytes}
use std::evm::crypto::{keccak_words, mulmod}
use ingot::field::{Field, KoalaBear}
use ingot::field::ext::KoalaBearExt4
use ingot::verifier::fri::air::{Air, AirCtx}
use ingot::verifier::fri::challenger::Challenger
use ingot::verifier::fri::merkle::{RowHasher, climb_path, load}

type E = KoalaBearExt4

/// Fold rounds and queries are bounded so the transcript results fit fixed arrays.
pub const MAX_FOLDS: usize = 20
pub const MAX_QUERIES: usize = 128

const KB_P: u256 = 0x7f000001
/// `1/2 mod p = (p + 1) / 2`.
const HALF: u256 = 0x3f800001
const M32: u256 = 0x100000000
const T64: u256 = 0x10000000000000000
const T96: u256 = 0x1000000000000000000000000
const T128: u256 = 0x100000000000000000000000000000000
const T160: u256 = 0x10000000000000000000000000000000000000000
const T192: u256 = 0x1000000000000000000000000000000000000000000000000
const T224: u256 = 0x100000000000000000000000000000000000000000000000000000000
const BYTE_MASK: u256 = 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff
const HALF_MASK: u256 = 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff
/// Plonky3 `KoalaBear::GENERATOR`, the coset shift of the committed domains.
const KB_GENERATOR: u256 = 3
/// `KoalaBear::two_adic_generator(24)`; smaller generators are its powers.
const KB_TWO_ADIC_24: u256 = 1791270792

/// One FRI/STARK configuration. Emitted into `fri/config_*.fe` from the Plonky3 proof's
/// `config.json`; `params_valid` must hold.
pub struct FriParams {
    /// Trace width (number of columns); `verify<A>` requires `A::WIDTH`.
    pub width: u256,
    /// log2 of the trace height.
    pub log_n: u256,
    pub log_blowup: u256,
    /// log2 of the final polynomial length (`log_final_poly_len`).
    pub log_final: u256,
    pub num_queries: u256,
    pub commit_pow_bits: u256,
    pub query_pow_bits: u256,
}

impl Copy for FriParams {}

/// Everything the Fiat-Shamir transcript derives.
pub struct Challenges {
    /// AIR constraint folding challenge.
    pub alpha: E,
    /// Out-of-domain evaluation point.
    pub zeta: E,
    /// FRI batching challenge.
    pub fri_alpha: E,
    /// FRI folding challenges, one per commit-phase round (first `num_folds` are used).
    pub betas: MemArray<E>,
    /// The same betas as 4 canonical words each (`beta_words[4 j + k]` is coefficient `k`).
    pub beta_words: MemArray<u256>,
    pub pow_ok: bool,
    /// Query indices in `[0, 2^log_h)` (first `num_queries` are used).
    pub indices: MemArray<u256>,
    /// `fri_alpha^k` for `k < 2 W + 4`, the powers that weight the `2 W + 4` opened columns in the
    /// reduced opening (trace_local `0..W`; trace_next `W..2W`; quotient chunk `2W..2W+4`), as 4
    /// canonical words each (`alpha_words[4 k + i]` is coefficient `i` of the power `k`).
    pub alpha_words: MemArray<u256>,
    /// `gen_tab[i] = g_{i+1}` (`KoalaBear::two_adic_generator(i + 1)`) for `i < log_h`, and
    /// `inv_tab[i] = g_{i+1}^-1`: the factors of `g_{LH}^{rev(index)}` and of its inverse.
    pub gen_tab: MemArray<u256>,
    pub inv_tab: MemArray<u256>,
    /// `sum_k fri_alpha^k f_k(zeta)` over the columns opened at `zeta`: trace_local and the
    /// quotient chunk (the part of the reduced opening that does not depend on the query).
    pub claim_z: E,
    /// The same sum over the columns opened at `zeta * g`: trace_next.
    pub claim_zn: E,
}

// ---------------------------------------------------------------------------------------
// configuration and proof layout
// ---------------------------------------------------------------------------------------

/// Plonky3's conjectured soundness bits: `log_blowup * num_queries + query_pow_bits`.
pub fn conjectured_bits(_ c: FriParams) -> u256 {
    c.log_blowup * c.num_queries + c.query_pow_bits
}

/// Parameter ranges this verifier supports: shifts, generator tables and the 32-bit
/// samples of the transcript bound every quantity used below.
pub fn params_valid(_ c: FriParams) -> bool {
    c.width >= 1
        && c.width <= 64
        && c.log_blowup >= 1
        && c.log_blowup <= 8
        && c.log_final <= c.log_n
        && c.log_n - c.log_final >= 1
        && c.log_n - c.log_final <= 20
        && c.log_n + c.log_blowup <= 24
        && c.log_final <= 8
        && c.num_queries >= 1
        && c.num_queries <= 128
        && c.commit_pow_bits <= 30
        && c.query_pow_bits <= 30
}

pub fn log_h(_ c: FriParams) -> u256 {
    c.log_n + c.log_blowup
}

pub fn num_folds(_ c: FriParams) -> u256 {
    c.log_n - c.log_final
}

pub fn off_trace_local() -> u256 {
    2
}

pub fn off_trace_next(_ c: FriParams) -> u256 {
    2 + 4 * c.width
}

pub fn off_quotient_chunk(_ c: FriParams) -> u256 {
    2 + 8 * c.width
}

pub fn off_fri_commits(_ c: FriParams) -> u256 {
    18 + 8 * c.width
}

pub fn off_commit_pow(_ c: FriParams) -> u256 {
    off_fri_commits(c) + num_folds(c)
}

pub fn off_final_poly(_ c: FriParams) -> u256 {
    off_fri_commits(c) + 2 * num_folds(c)
}

pub fn off_query_pow(_ c: FriParams) -> u256 {
    off_final_poly(c) + 4 * (1 << c.log_final)
}

pub fn off_queries(_ c: FriParams) -> u256 {
    off_query_pow(c) + 1
}

/// Words of the F Merkle paths of one query: lengths `LH-1, LH-2, ..., LH-F`.
fn fold_paths_words(_ c: FriParams) -> u256 {
    let f = num_folds(c)
    f * (log_h(c) - 1) - f * (f - 1) / 2
}

/// Offsets inside one query record (relative to its start).
pub fn q_trace_row() -> u256 {
    0
}

pub fn q_trace_path(_ c: FriParams) -> u256 {
    c.width
}

pub fn q_quotient_row(_ c: FriParams) -> u256 {
    c.width + log_h(c)
}

pub fn q_quotient_path(_ c: FriParams) -> u256 {
    c.width + 4 + log_h(c)
}

pub fn q_fold_sibling(_ c: FriParams) -> u256 {
    c.width + 4 + 2 * log_h(c)
}

pub fn q_fold_paths(_ c: FriParams) -> u256 {
    c.width + 4 + 2 * log_h(c) + 4 * num_folds(c)
}

pub fn query_words(_ c: FriParams) -> u256 {
    q_fold_paths(c) + fold_paths_words(c)
}

pub fn query_base(_ c: FriParams, _ q: u256) -> u256 {
    off_queries(c) + q * query_words(c)
}

/// Length of a proof for `c`.
pub fn proof_words(_ c: FriParams) -> u256 {
    off_queries(c) + c.num_queries * query_words(c)
}

// ---------------------------------------------------------------------------------------
// field helpers
// ---------------------------------------------------------------------------------------

/// `p[i]` without a bounds check: `i` must be inside the allocation (callers assert the range).
#[inline(always)]
#[arithmetic(unchecked)]
fn rd(_ base: *u256, _ i: u256) -> u256 {
    unsafe {
        *offset_bytes(base, i * 32)
    }
}

#[inline(always)]
fn at(_ p: MemArray<u256>, _ i: u256) -> u256 {
    load(p, i)
}

/// Decode a canonical felt. Callers must have run `proof_is_canonical`; a non-canonical
/// value here would be a verifier bug, so this reverts instead of reducing.
fn kb(_ v: u256) -> KoalaBear {
    KoalaBear::from_canonical(v).unwrap()
}

/// The extension element stored in the 4 words starting at `i`.
fn extw(_ p: MemArray<u256>, _ i: u256) -> E {
    E::new(
        kb(at(p, i)),
        kb(at(p, i + 1)),
        kb(at(p, i + 2)),
        kb(at(p, i + 3)),
    )
}

/// All `n` words from `from` are `< p`, without a branch per word.
///
/// A word `v` is canonical iff `v < p = 0x7f000001`. `v >> 31 != 0` catches every `v >= 2^31`
/// (whatever its size); for `v < 2^31` the sum `v + 0xffffff` is `< 2^32` (no overflow) and
/// `(v + 0xffffff) >> 31 != 0` iff `v >= 2^31 - 0xffffff = p`. For `v >= 2^31` the sum may wrap
/// modulo `2^256` (unchecked arithmetic, the only bound needed is the one above), which cannot
/// matter because the first term already flags it. The flags are OR-ed together.
#[arithmetic(unchecked)]
fn words_canonical(_ p: MemArray<u256>, _ from: u256, _ n: u256) -> bool {
    var bad: u256 = 0
    var i: u256 = from
    let end = from + n
    assert(end <= (p.len() as u256))
    let base = p.ptr()
    while i < end {
        let v = unsafe {
            *offset_bytes(base, i * 32)
        }
        bad = bad | (v >> 31) | ((v + 0xffffff) >> 31)
        i += 1
    }
    bad == 0
}

/// `KoalaBear::two_adic_generator(k)` for `k <= 24`.
fn two_adic_generator(_ k: u256) -> KoalaBear {
    kb(KB_TWO_ADIC_24).pow(1 << (24 - k))
}

/// `x^(2^k)` by `k` squarings.
fn pow2_loop(_ x: u256, _ k: u256) -> u256 {
    var r = x
    var i: u256 = 0
    while i < k {
        r = mulmod(r, r, KB_P)
        i += 1
    }
    r
}

/// 0 iff `v < p`: `v >> 31` flags every `v >= 2^31` (any size); for `v < 2^31` the sum
/// `v + 0xffffff` is `< 2^32` and reaches bit 31 iff `v >= 2^31 - 0xffffff = p`. For `v >= 2^31`
/// the sum may wrap modulo `2^256` (unchecked), which cannot matter: the first term already
/// flags it.
#[inline(always)]
#[arithmetic(unchecked)]
fn noncanonical(_ v: u256) -> u256 {
    (v >> 31) | ((v + 0xffffff) >> 31)
}

/// `keccak256` input of a fold-round leaf: the Plonky3 serialization of the 8 felts
/// `a0..a3 || b0..b3` (each the 4 little-endian bytes of its Montgomery form `v * 2^32 mod p`),
/// which is exactly one 32-byte word, built in one go: 8 reductions, then one byte swap of
/// all 8 lanes at once. Inputs canonical (`< p < 2^31`), so `v * 2^32 < 2^63`, each lane
/// `m < 2^31` and `m * 2^(32 k)` for `k <= 7` stays below `2^255` and the lanes do not overlap.
#[inline(always)]
#[arithmetic(unchecked)]
fn leaf8(
    _ a0: u256,
    _ a1: u256,
    _ a2: u256,
    _ a3: u256,
    _ b0: u256,
    _ b1: u256,
    _ b2: u256,
    _ b3: u256,
) -> u256 {
    var w = ((a0 * M32) % KB_P) * T224
    w = w | (((a1 * M32) % KB_P) * T192)
    w = w | (((a2 * M32) % KB_P) * T160)
    w = w | (((a3 * M32) % KB_P) * T128)
    w = w | (((b0 * M32) % KB_P) * T96)
    w = w | (((b1 * M32) % KB_P) * T64)
    w = w | (((b2 * M32) % KB_P) * M32)
    w = w | ((b3 * M32) % KB_P)
    // swap the bytes inside every 32-bit lane; the masked parts shifted up stay in their lane
    w = ((w & BYTE_MASK) * 256) | ((w >> 8) & BYTE_MASK)
    keccak_words([((w & HALF_MASK) * 65536) | ((w >> 16) & HALF_MASK)])
}

/// Final polynomial `sum_i c_i x^i` (`n` extension coefficients at words `off ..`, 4 words each)
/// evaluated by Horner at the base-field point `x` on each of the 4 lanes, compared with the
/// lanes `f0..f3`. The coefficient words are range-checked by `proof_is_canonical`
/// (`words_canonical` over the final polynomial) before this is reached, and are checked again
/// here. Unchecked arithmetic: accumulators `< p < 2^31`, `x < p`, so `acc * x + w < 2^62 + 2^31`.
#[arithmetic(unchecked)]
fn horner_final(
    _ p: MemArray<u256>,
    _ off: u256,
    _ n: u256,
    _ x: u256,
    _ f0: u256,
    _ f1: u256,
    _ f2: u256,
    _ f3: u256,
) -> bool {
    var a0: u256 = 0
    var a1: u256 = 0
    var a2: u256 = 0
    var a3: u256 = 0
    var bad: u256 = 0
    var i = n
    while i > 0 {
        i -= 1
        let w0 = at(p, off + 4 * i)
        let w1 = at(p, off + 4 * i + 1)
        let w2 = at(p, off + 4 * i + 2)
        let w3 = at(p, off + 4 * i + 3)
        bad = bad | noncanonical(w0) | noncanonical(w1) | noncanonical(w2) | noncanonical(w3)
        a0 = (a0 * x + w0) % KB_P
        a1 = (a1 * x + w1) % KB_P
        a2 = (a2 * x + w2) % KB_P
        a3 = (a3 * x + w3) % KB_P
    }
    bad == 0 && a0 == f0 && a1 == f1 && a2 == f2 && a3 == f3
}

/// `reverse_bits_len`: reverse the low `bits` bits of `v`.
fn reverse_bits(_ v: u256, _ bits: u256) -> u256 {
    var r: u256 = 0
    var x: u256 = v
    var i: u256 = 0
    while i < bits {
        r = (r << 1) | (x & 1)
        x = x >> 1
        i += 1
    }
    r
}

// ---------------------------------------------------------------------------------------
// rule 1: canonical encoding
// ---------------------------------------------------------------------------------------

/// Every base-field element in the proof and the public values is `< p`. Commitments and
/// Merkle siblings are 32-byte strings and need no range check.
///
/// `verify` runs only `proof_header_is_canonical` up front (the parts every query shares) and
/// leaves the per-query rows and fold siblings to `check_query`, which range-checks exactly the
/// words it reads and rejects the query otherwise; a proof is accepted only if every query
/// passes, so the verdict is the same as with this full pre-check, at one pass over fewer words.
pub fn proof_is_canonical(_ c: FriParams, _ p: MemArray<u256>, _ public: MemArray<u256>) -> bool {
    if !proof_header_is_canonical(c, p, public) {
        return false
    }
    let f = num_folds(c)
    var ok = true
    var q: u256 = 0
    while q < c.num_queries {
        let base = query_base(c, q)
        ok = ok && words_canonical(p, base + q_trace_row(), c.width)
        ok = ok && words_canonical(p, base + q_quotient_row(c), 4)
        ok = ok && words_canonical(p, base + q_fold_sibling(c), 4 * f)
        q += 1
    }
    ok
}

/// The query-independent part of `proof_is_canonical`: public values, claimed evaluations,
/// proof-of-work witnesses, final polynomial.
pub fn proof_header_is_canonical(
    _ c: FriParams,
    _ p: MemArray<u256>,
    _ public: MemArray<u256>,
) -> bool {
    var ok = true
    var k: usize = 0
    while k < public.len() {
        ok = ok && public[k] < KB_P
        k += 1
    }
    // trace_local, trace_next, quotient_chunk: 8 W + 16 contiguous words
    ok = ok && words_canonical(p, off_trace_local(), 8 * c.width + 16)
    let f = num_folds(c)
    // With zero proof-of-work bits the witness is unread by Plonky3; pin it to zero so a
    // proof has one encoding.
    var i: u256 = 0
    while i < f {
        let wit = at(p, off_commit_pow(c) + i)
        ok = ok && wit < KB_P
        if c.commit_pow_bits == 0 {
            ok = ok && wit == 0
        }
        i += 1
    }
    ok = ok && words_canonical(p, off_final_poly(c), 4 * (1 << c.log_final))
    ok && at(p, off_query_pow(c)) < KB_P
}

// ---------------------------------------------------------------------------------------
// Fiat-Shamir (rule 5)
// ---------------------------------------------------------------------------------------

/// Replay the transcript exactly as `p3_uni_stark::verify` + `TwoAdicFriPcs::verify` +
/// `p3_fri::verify_fri` do. Everything the prover sent is observed before the challenge
/// that depends on it.
pub fn replay_transcript(
    _ c: FriParams,
    _ p: MemArray<u256>,
    _ public: MemArray<u256>,
) -> Challenges {
    var ch = Challenger::new()
    // instance: degree_bits, degree_bits - is_zk (zk off), preprocessed width (none)
    ch.observe_felt(kb(c.log_n))
    ch.observe_felt(kb(c.log_n))
    ch.observe_felt(kb(0))
    ch.observe_hash(at(p, 0))
    var k: usize = 0
    while k < public.len() {
        ch.observe_felt(kb(public[k]))
        k += 1
    }
    let alpha = ch.sample_ext()
    ch.observe_hash(at(p, 1))
    let zeta = ch.sample_ext()

    // PCS: all claimed evaluations, in commitment / matrix / point order
    // (trace_local, trace_next, quotient_chunk are contiguous: 2 W + 4 extension elements)
    var i: u256 = 0
    while i < 2 * c.width + 4 {
        ch.observe_ext(extw(p, off_trace_local() + 4 * i))
        i += 1
    }

    // FRI: batching challenge, then per commit-phase round commit, (pow), beta
    let fri_alpha = ch.sample_ext()
    // betas, indices and alpha_words live in memory arrays: `Challenges` is passed to every
    // query check, and a by-value struct with inline arrays is copied on every call
    var betas = unsafe {
        MemArray<E>::new_uninit(num_folds(c) as usize)
    }
    var beta_words = unsafe {
        MemArray<u256>::new_uninit((4 * num_folds(c)) as usize)
    }
    var pow_ok = true
    let f = num_folds(c)
    i = 0
    while i < f {
        ch.observe_hash(at(p, off_fri_commits(c) + i))
        if !ch.check_witness(c.commit_pow_bits, kb(at(p, off_commit_pow(c) + i))) {
            pow_ok = false
        }
        let beta = ch.sample_ext()
        betas[i as usize] = beta
        beta_words[(4 * i) as usize] = beta.coeff(0).to_canonical()
        beta_words[(4 * i + 1) as usize] = beta.coeff(1).to_canonical()
        beta_words[(4 * i + 2) as usize] = beta.coeff(2).to_canonical()
        beta_words[(4 * i + 3) as usize] = beta.coeff(3).to_canonical()
        i += 1
    }
    i = 0
    while i < (1 << c.log_final) {
        ch.observe_ext(extw(p, off_final_poly(c) + 4 * i))
        i += 1
    }
    if !ch.check_witness(c.query_pow_bits, kb(at(p, off_query_pow(c)))) {
        pow_ok = false
    }
    var indices = unsafe {
        MemArray<u256>::new_uninit(c.num_queries as usize)
    }
    i = 0
    while i < c.num_queries {
        indices[i as usize] = ch.sample_bits(log_h(c))
        i += 1
    }
    // Query-independent part of the reduced opening, computed once here instead of once per
    // query: powers of fri_alpha and the claimed evaluations folded with them. Column order of
    // the powers: trace_local (W), trace_next (W), quotient chunk (4).
    let w = c.width
    let np = 2 * w + 4
    var alpha_words = unsafe {
        MemArray<u256>::new_uninit((4 * np) as usize)
    }
    var pw = E::one()
    var claim_z = E::zero()
    var claim_zn = E::zero()
    i = 0
    while i < np {
        alpha_words[(4 * i) as usize] = pw.coeff(0).to_canonical()
        alpha_words[(4 * i + 1) as usize] = pw.coeff(1).to_canonical()
        alpha_words[(4 * i + 2) as usize] = pw.coeff(2).to_canonical()
        alpha_words[(4 * i + 3) as usize] = pw.coeff(3).to_canonical()
        // claimed evaluation of column i (the claims are contiguous: local, next, chunk)
        let term = pw.mul(extw(p, off_trace_local() + 4 * i))
        if i >= w && i < 2 * w {
            claim_zn = claim_zn.add(term)
        } else {
            claim_z = claim_z.add(term)
        }
        pw = pw.mul(fri_alpha)
        i += 1
    }
    // tables of the two-adic generators g_1 .. g_LH and their inverses, from the top:
    // g_LH = g_24^(2^(24-LH)), g_{k-1} = g_k^2
    let lh = log_h(c)
    var gen_tab = unsafe {
        MemArray<u256>::new_uninit(lh as usize)
    }
    var inv_tab = unsafe {
        MemArray<u256>::new_uninit(lh as usize)
    }
    var g = pow2_loop(KB_TWO_ADIC_24, 24 - lh)
    // g_LH has multiplicative order 2^LH and is nonzero: the inverse exists
    var gi = kb(g).inv().unwrap().to_canonical()
    i = lh
    while i > 0 {
        i -= 1
        gen_tab[i as usize] = g
        inv_tab[i as usize] = gi
        g = mulmod(g, g, KB_P)
        gi = mulmod(gi, gi, KB_P)
    }
    Challenges {
        alpha,
        zeta,
        fri_alpha,
        betas,
        beta_words,
        pow_ok,
        indices,
        alpha_words,
        gen_tab,
        inv_tab,
        claim_z,
        claim_zn,
    }
}

// ---------------------------------------------------------------------------------------
// FRI queries
// ---------------------------------------------------------------------------------------

/// `p3_fri::verify_fri::open_input` for one query: check both input Merkle openings and
/// combine the opened values into the reduced opening
/// `sum alpha^k (f_k(z) - f_k(x)) / (z - x)`, over the trace (points zeta and zeta*g) and
/// the quotient chunk (point zeta). `None` if a Merkle path is wrong or `z == x`.
///
/// One pass over the opened trace row (`W` words) and one over the quotient row (4 words) does
/// the range check, the leaf hash and the dot products with the powers of `fri_alpha`.
/// Unchecked arithmetic (safety rule 7): every opened word `v` is flagged into `bad` by
/// `noncanonical` and a query with `bad != 0` returns `None` before any sum is used; for
/// canonical `v < p < 2^31` and `alpha` coefficients `< p`, each product is `< 2^62` and each lane
/// sums at most `W + 4 <= 68` products, `< 2^69`, no overflow of `u256`. (For a non-canonical `v`
/// the sums are garbage or wrap, but they are discarded.) All indices are inside the asserted
/// ranges: the row `base .. base + W`, the quotient row `qr .. qr + 4` and the `4 (2 W + 4)`
/// alpha words.
#[arithmetic(unchecked)]
fn open_input(
    _ c: FriParams,
    _ p: MemArray<u256>,
    _ ch: Challenges,
    _ q: u256,
    _ x: KoalaBear,
) -> Option<E> {
    let base = query_base(c, q)
    let index = load(ch.indices, q)
    let w = c.width
    let qr = base + q_quotient_row(c)
    assert(base + w <= (p.len() as u256))
    assert(qr + 4 <= (p.len() as u256))
    assert(4 * (2 * w + 4) <= (ch.alpha_words.len() as u256))
    let pb = p.ptr()
    let ab = ch.alpha_words.ptr()
    var bad: u256 = 0
    // trace commitment: one matrix, width W, 2^LH rows. Sz lanes: columns opened at zeta (trace
    // local weights `alpha^k`, then the quotient chunk `alpha^(2W+i)`); Szn lanes: trace_next
    // (weights `alpha^(W+k)`).
    var h = RowHasher::new()
    var s0: u256 = 0
    var s1: u256 = 0
    var s2: u256 = 0
    var s3: u256 = 0
    var n0: u256 = 0
    var n1: u256 = 0
    var n2: u256 = 0
    var n3: u256 = 0
    var k: u256 = 0
    while k < w {
        let v = rd(pb, base + k)
        bad = bad | noncanonical(v)
        h.felt_canonical(v)
        let ls = 4 * k
        let ln = 4 * (w + k)
        s0 += rd(ab, ls) * v
        s1 += rd(ab, ls + 1) * v
        s2 += rd(ab, ls + 2) * v
        s3 += rd(ab, ls + 3) * v
        n0 += rd(ab, ln) * v
        n1 += rd(ab, ln + 1) * v
        n2 += rd(ab, ln + 2) * v
        n3 += rd(ab, ln + 3) * v
        k += 1
    }
    // quotient commitment: one chunk, width 4 (the 4 coefficients of an extension value)
    var hq = RowHasher::new()
    k = 0
    while k < 4 {
        let v = rd(pb, qr + k)
        bad = bad | noncanonical(v)
        hq.felt_canonical(v)
        let lq = 4 * (2 * w + k)
        s0 += rd(ab, lq) * v
        s1 += rd(ab, lq + 1) * v
        s2 += rd(ab, lq + 2) * v
        s3 += rd(ab, lq + 3) * v
        k += 1
    }
    // A non-canonical word rejects the query before any of the values is used (the range check
    // of `proof_is_canonical`, done per query: see there).
    if bad != 0 {
        return Option::None
    }
    if climb_path(h.finish(), index, p, base + q_trace_path(c), log_h(c)) != at(p, 0) {
        return Option::None
    }
    if climb_path(hq.finish(), index, p, base + q_quotient_path(c), log_h(c)) != at(p, 1) {
        return Option::None
    }

    // sum_k a^k (f_k(z_k) - f_k(x)) / (z_k - x) = (claim_z - Sz) / (zeta - x)
    //                                            + (claim_zn - Szn) / (zeta*g - x)
    // with Sz = sum a^k f_k(x) over the columns opened at zeta (trace_local, quotient chunk),
    // Szn over trace_next; the f_k(x) are the base-field openings of this query.
    let sz = E::new(
        KoalaBear::reduce(s0),
        KoalaBear::reduce(s1),
        KoalaBear::reduce(s2),
        KoalaBear::reduce(s3),
    )
    let szn = E::new(
        KoalaBear::reduce(n0),
        KoalaBear::reduce(n1),
        KoalaBear::reduce(n2),
        KoalaBear::reduce(n3),
    )
    let zeta = ch.zeta
    let zeta_next = zeta.scale(two_adic_generator(c.log_n))
    let x_ext = E::from_base(x)
    let d0 = zeta.sub(x_ext)
    let d1 = zeta_next.sub(x_ext)
    // one inversion for both denominators: 1/d0 = d1 / (d0 d1), 1/d1 = d0 / (d0 d1);
    // `None` when either is zero (x == zeta or x == zeta*g), as before.
    let inv_d = match d0.mul(d1).inv() {
        Option::Some(v) => v,
        Option::None => {
            return Option::None
        },
    }
    let n0 = ch.claim_z.sub(sz).mul(d1)
    let n1 = ch.claim_zn.sub(szn).mul(d0)
    Option::Some(n0.add(n1).mul(inv_d))
}

/// `p3_fri::verify_fri` loop body for one query: open the inputs, fold `num_folds` times
/// checking each commit-phase Merkle opening, compare with the final polynomial.
///
/// Unchecked arithmetic (safety rule 7), with these bounds. Parameters: `params_valid(c)` is
/// tested first, so every loop counter, shift, offset and `lh`, `j`, `4 * j` is below `2^32`
/// and `lh - 1 - j >= 0` (`j < num_folds <= lh - 1`). Field values: `y, y_inv, den_inv, s`,
/// the lanes `f_k`, `e0_k`, `e1_k` and the beta words are canonical (`< p < 2^31`; the siblings
/// are checked into `bad`, and a query with `bad != 0` returns `false` before the final
/// comparison; the beta words come from `sample_ext`). Then `d_k = e1_k + p - e0_k < 2p`,
/// `b0 = beta_0 + p - s < 2p`, `b_k < p`, each product `< 4 p^2 < 2^64`, and the sums above
/// consist of at most 10 products, `< 2^68`; `(sum % p) * den_inv < 2^62`; adding `e0_k < 2^31`
/// stays far below `2^256`.
#[arithmetic(unchecked)]
pub fn check_query(_ c: FriParams, _ p: MemArray<u256>, _ ch: Challenges, _ q: u256) -> bool {
    if !params_valid(c) {
        return false
    }
    let base = query_base(c, q)
    let index = load(ch.indices, q)
    let lh = log_h(c)
    // the whole query record and the commit-phase commitments lie inside the proof: the reads
    // below use `rd` (no per-word bounds check) on offsets inside these two ranges
    assert(base + query_words(c) <= (p.len() as u256))
    assert(off_fri_commits(c) + num_folds(c) <= (p.len() as u256))
    let pb = p.ptr()
    // y0 = g_{LH}^{rev(index)}. Bit i of `index` contributes g_{LH}^(2^(LH-1-i)) = g_{i+1},
    // so y0 is the product of the table entries of the set bits (no bit reversal, no pow); the
    // same loop builds y0^-1 from the inverse table. The coset shift: x = GENERATOR * y0.
    assert(
        lh <= (ch.gen_tab.len() as u256) && lh <= (ch.inv_tab.len() as u256),
    )
    let gb = ch.gen_tab.ptr()
    let ib = ch.inv_tab.ptr()
    var y0: u256 = 1
    var y0_inv: u256 = 1
    var bits = index
    var i: u256 = 0
    while i < lh {
        if bits & 1 == 1 {
            y0 = mulmod(y0, unsafe { *offset_bytes(gb, i * 32) }, KB_P)
            y0_inv = mulmod(y0_inv, unsafe { *offset_bytes(ib, i * 32) }, KB_P)
        }
        bits = bits >> 1
        i += 1
    }
    let y0k = kb(y0)
    let x = kb(KB_GENERATOR).mul(y0k)
    let first = match open_input(c, p, ch, q, x) {
        Option::Some(v) => v,
        Option::None => {
            return false
        },
    }
    // The folded value is carried as 4 canonical lanes (`u256` locals `< p`) through the fold
    // rounds: the base-field products below are `mulmod`-free raw arithmetic with the bounds
    // stated at `fold_step`, and the proof's own words are read raw and range-checked into
    // `bad` (OR of `noncanonical` flags, tested after the loop).
    var f0 = first.coeff(0).to_canonical()
    var f1 = first.coeff(1).to_canonical()
    var f2 = first.coeff(2).to_canonical()
    var f3 = first.coeff(3).to_canonical()
    var bad: u256 = 0
    // y_j = y0^(2^j) = g_{LH}^{rev(idx_j)} (idx_j = index >> j) because shifting the index
    // squares the point, and the fold point of round j is s_j = (-1)^(idx_j & 1) y_j (the
    // lowest bit of idx_j is the top exponent bit and g^(2^(LH-1)) = -1). Hence no `pow` or bit
    // reversal per round, and 1/(-2 s_j) comes from y0^-1 (squared each round) instead of one
    // inversion per round.
    var y: u256 = y0
    var y_inv: u256 = y0_inv
    var idx = index
    var j: u256 = 0
    var off: u256 = base + q_fold_paths(c)
    let sib_base = base + q_fold_sibling(c)
    while j < num_folds(c) {
        // height of the folded codeword: 2^lhj, so the path has lhj siblings
        let lhj = lh - 1 - j
        let sb = sib_base + 4 * j
        let t0 = rd(pb, sb)
        let t1 = rd(pb, sb + 1)
        let t2 = rd(pb, sb + 2)
        let t3 = rd(pb, sb + 3)
        bad = bad | noncanonical(t0) | noncanonical(t1) | noncanonical(t2) | noncanonical(t3)
        // (e0, e1) = (folded, sibling) in index order
        let odd = idx & 1 == 1
        var leaf: u256 = 0
        if odd {
            leaf = leaf8(t0, t1, t2, t3, f0, f1, f2, f3)
        } else {
            leaf = leaf8(f0, f1, f2, f3, t0, t1, t2, t3)
        }
        idx = idx >> 1
        if climb_path(leaf, idx, p, off, lhj) != rd(pb, off_fri_commits(c) + j) {
            return false
        }
        off += lhj
        // TwoAdicFriFolding::fold_row: xs = [s, -s], s = (-1)^odd y_j;
        // folded = e0 + (beta - s) (e1 - e0) / (-2 s)
        // 1/(-2 s) = (-1)^(odd+1) * (1/2) * y_j^-1
        let half_inv = mulmod(HALF, y_inv, KB_P)
        var s = y
        var den_inv = KB_P - half_inv
        var e00 = f0
        var e01 = f1
        var e02 = f2
        var e03 = f3
        var e10 = t0
        var e11 = t1
        var e12 = t2
        var e13 = t3
        if odd {
            s = KB_P - y
            den_inv = half_inv
            e00 = t0
            e01 = t1
            e02 = t2
            e03 = t3
            e10 = f0
            e11 = f1
            e12 = f2
            e13 = f3
        }
        // e1 - e0 and beta - s as lanes: d_k < 2p, t_k < 2p (bounds at the function head)
        let d0 = e10 + KB_P - e00
        let d1 = e11 + KB_P - e01
        let d2 = e12 + KB_P - e02
        let d3 = e13 + KB_P - e03
        let bw = 4 * j
        let b0 = load(ch.beta_words, bw) + KB_P - s
        let b1 = load(ch.beta_words, bw + 1)
        let b2 = load(ch.beta_words, bw + 2)
        let b3 = load(ch.beta_words, bw + 3)
        // (beta - s)(e1 - e0) in F[x]/(x^4 - 3), then * den_inv, then + e0
        f0 = (e00 + ((b0 * d0 + 3 * (b1 * d3 + b2 * d2 + b3 * d1)) % KB_P) * den_inv) % KB_P
        f1 = (e01 + ((b0 * d1 + b1 * d0 + 3 * (b2 * d3 + b3 * d2)) % KB_P) * den_inv) % KB_P
        f2 = (e02 + ((b0 * d2 + b1 * d1 + b2 * d0 + 3 * (b3 * d3)) % KB_P) * den_inv) % KB_P
        f3 = (e03 + ((b0 * d3 + b1 * d2 + b2 * d1 + b3 * d0) % KB_P) * den_inv) % KB_P
        y = mulmod(y, y, KB_P)
        y_inv = mulmod(y_inv, y_inv, KB_P)
        j += 1
    }
    if bad != 0 { return false }
    // final polynomial (2^log_final coefficients, Horner) at x = g_{LH}^{rev(idx, LH)} = y_F
    horner_final(p, off_final_poly(c), 1 << c.log_final, y, f0, f1, f2, f3)
}

// ---------------------------------------------------------------------------------------
// AIR constraints at the out-of-domain point
// ---------------------------------------------------------------------------------------

/// `p3_uni_stark::verify_constraints` + `recompose_quotient_from_chunks` for the AIR `A`:
/// `A::eval(..) / Z_H(zeta) == quotient(zeta)`, where `A::eval` folds the constraints with
/// `alpha` in Plonky3's assertion order (`fri/air.fe`). The AIR sees the claimed trace rows at
/// `zeta` and `zeta * g`, the public values and the first/last/transition selectors.
pub fn check_air<A: Air>(
    _ c: FriParams,
    _ p: MemArray<u256>,
    _ public: MemArray<u256>,
    _ ch: Challenges,
) -> bool {
    let zeta = ch.zeta
    let one = E::one()
    let h = two_adic_generator(c.log_n)
    let h_inv = match h.inv() {
        Option::Some(v) => v,
        Option::None => {
            return false
        },
    }
    // Z_H(zeta) = zeta^n - 1; zeta on the trace domain is rejected (Plonky3 would divide by 0)
    let z_h = zeta.exp_power_of_2(c.log_n as usize).sub(one)
    if z_h.is_zero() {
        return false
    }
    let z_h_inv = match z_h.inv() {
        Option::Some(v) => v,
        Option::None => {
            return false
        },
    }
    // zeta != 1 and zeta != h^-1 follow from Z_H(zeta) != 0
    let inv_first = match zeta.sub(one).inv() {
        Option::Some(v) => v,
        Option::None => {
            return false
        },
    }
    let h_inv_ext = E::from_base(h_inv)
    let inv_last = match zeta.sub(h_inv_ext).inv() {
        Option::Some(v) => v,
        Option::None => {
            return false
        },
    }
    let is_first = z_h.mul(inv_first)
    let is_last = z_h.mul(inv_last)
    let is_transition = zeta.sub(h_inv_ext)

    // the claimed trace rows at zeta (local) and zeta * g (next), `A::WIDTH` columns each
    let w = c.width
    var local = unsafe {
        MemArray<E>::new_uninit(w as usize)
    }
    var next = unsafe {
        MemArray<E>::new_uninit(w as usize)
    }
    var i: u256 = 0
    while i < w {
        local[i as usize] = extw(p, off_trace_local() + 4 * i)
        next[i as usize] = extw(p, off_trace_next(c) + 4 * i)
        i += 1
    }
    var pubs = unsafe {
        MemArray<E>::new_uninit(public.len())
    }
    i = 0
    while i < (public.len() as u256) {
        pubs[i as usize] = E::from_base(kb(at(public, i)))
        i += 1
    }
    let acc = A::eval(
        AirCtx { local, next, public: pubs, alpha: ch.alpha, is_first, is_last, is_transition },
    )

    // quotient(zeta) = sum_i x^i * chunk_i  (the chunk is the basis decomposition: chunk_i
    // is the coefficient of x^i, a base-field-times-basis element)
    var quotient = E::zero()
    i = 0
    while i < 4 {
        let basis = E::new(
            if i == 0 {
                KoalaBear::one()
            } else {
                KoalaBear::zero()
            },
            if i == 1 {
                KoalaBear::one()
            } else {
                KoalaBear::zero()
            },
            if i == 2 {
                KoalaBear::one()
            } else {
                KoalaBear::zero()
            },
            if i == 3 {
                KoalaBear::one()
            } else {
                KoalaBear::zero()
            },
        )
        quotient = quotient.add(basis.mul(extw(p, off_quotient_chunk(c) + 4 * i)))
        i += 1
    }
    acc.mul(z_h_inv).eq(quotient)
}

// ---------------------------------------------------------------------------------------
// entry point
// ---------------------------------------------------------------------------------------

/// The public values `a` as a memory array (what `verify` takes).
pub fn public_values<const N: usize>(_ a: [u256; N]) -> MemArray<u256> {
    var m = unsafe {
        MemArray<u256>::new_uninit(N)
    }
    var i: usize = 0
    while i < N {
        m[i] = a[i]
        i += 1
    }
    m
}

/// The configuration matches the AIR: trace width, supported constraint degree (one quotient
/// chunk).
pub fn air_matches<A: Air>(_ c: FriParams) -> bool {
    c.width == A::WIDTH && A::MAX_DEGREE <= 2 && A::MAX_DEGREE >= 1
}

/// Verify a STARK proof of the AIR `A` for configuration `c`. `public` are the `A::NUM_PUBLIC`
/// public values (canonical field elements). Returns `false` for any invalid proof, including
/// non-canonical field elements, a proof or public-value list of the wrong length, an AIR that
/// does not match the configuration and unsupported parameters.
pub fn verify<A: Air>(_ c: FriParams, _ p: MemArray<u256>, _ public: MemArray<u256>) -> bool {
    if !params_valid(c) || !air_matches<A>(c) {
        return false
    }
    if (public.len() as u256) != A::NUM_PUBLIC {
        return false
    }
    if (p.len() as u256) != proof_words(c) {
        return false
    }
    if !proof_header_is_canonical(c, p, public) {
        return false
    }
    let ch = replay_transcript(c, p, public)
    if !ch.pow_ok { return false }
    var q: u256 = 0
    while q < c.num_queries {
        if !check_query(c, p, ch, q) {
            return false
        }
        q += 1
    }
    check_air<A>(c, p, public, ch)
}
