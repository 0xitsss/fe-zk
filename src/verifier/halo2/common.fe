//! Circuit-independent core of the halo2-KZG verifier (halo2-axiom 0.5.3, BN254, KZG).
//!
//! Everything circuit specific (gate and lookup expressions, permutation layout, query list,
//! SHPLONK rotation sets, GWC point groups) lives in a module emitted by
//! `fe-zk-gen halo2` from a `vk.json`; this file holds the pieces every emitted
//! verifier shares: the snark-verifier `EvmTranscript`, input decoding, batched field inversion
//! through the modexp precompile and the final pairing. Algorithm: `vectors/halo2/SPEC.md`.
//!
//! Typing enforces safety rules 1-3 here as in the rest of fe-zk: proof words become `Bn254Fr`
//! only through `Bn254Fr::from_canonical`, and `G1` only through `read_g1` (canonical, on the
//! curve, point at infinity rejected as SPEC section 2 demands).
use core::ptr::MemBuffer
use std::evm::{Call, Ctx}
use std::evm::crypto::keccak256
use ingot::ec::{G1, G2, g1_add, g1_mul, pairing_check}
use ingot::ec::precompile::put_at
pub use ingot::ec::precompile::inv_modexp
use ingot::field::{Bn254Fr, Field}

/// Constant circuit data shared by all halo2-KZG circuits. Private fields: `Vk::from_coords`.
/// The G2 points are validated (on curve, in the subgroup) by `G2::from_coords` before they
/// get here; the G1 generator by its type.
pub struct Vk { transcript_repr: Bn254Fr, g1: G1, g2: G2, s_g2: G2 }
impl Copy for Vk {}

impl Vk {
    /// `None` if any SRS point is the point at infinity (then every pairing check passes).
    pub fn from_coords(_ transcript_repr: Bn254Fr, _ g1: G1, _ g2: G2, _ s_g2: G2) -> Option<Vk> {
        if g1.is_infinity() || g2.is_infinity() || s_g2.is_infinity() {
            return Option::None
        }
        Option::Some(Vk { transcript_repr, g1, g2, s_g2 })
    }

    /// Key from compile-time constants: build the points with `G1::from_coords_or_infinity` /
    /// `G2::from_coords_or_infinity` and pair each with `static_assert(g1_is_valid(..))` /
    /// `static_assert(g2_is_valid(..))`, so no gas is spent on the G2 subgroup checks. A
    /// degenerate key (any SRS point at infinity) is poisoned to all-infinity and
    /// `final_pairing` rejects it.
    pub fn from_consts(_ transcript_repr: Bn254Fr, _ g1: G1, _ g2: G2, _ s_g2: G2) -> Vk {
        if g1.is_infinity() || g2.is_infinity() || s_g2.is_infinity() {
            return Vk {
                transcript_repr,
                g1: G1::infinity(),
                g2: G2::infinity(),
                s_g2: G2::infinity(),
            }
        }
        Vk { transcript_repr, g1, g2, s_g2 }
    }

    pub fn transcript_repr(self) -> Bn254Fr {
        self.transcript_repr
    }
    pub fn g1(self) -> G1 {
        self.g1
    }
    /// The same SRS with another circuit digest (tests: a wrong vk constant must be rejected).
    pub fn with_transcript_repr(self, _ transcript_repr: Bn254Fr) -> Vk {
        Vk { transcript_repr, g1: self.g1, g2: self.g2, s_g2: self.s_g2 }
    }
}

/// Reduction of a vk constant (trusted, emitted by the generator).
pub fn fr(_ v: u256) -> Bn254Fr {
    Bn254Fr::reduce(v)
}

/// A G1 constant of the verifying key. The generator checked it; this re-checks it (cheap)
/// because a `G1` can only be built by `G1::from_coords`.
pub fn g1_const(_ x: u256, _ y: u256) -> G1 {
    match G1::from_coords(x, y) {
        Option::Some(p) => p,
        Option::None => {
            assert(false)
            G1::infinity()
        },
    }
}

/// A proof point: canonical coordinates, on the curve, and NOT the point at infinity.
/// (`(0,0)` is rejected like in halo2's own `EvmTranscript::read_point`.)
pub fn read_g1(_ x: u256, _ y: u256) -> Option<G1> {
    match G1::from_coords(x, y) {
        Option::Some(p) => {
            if p.is_infinity() {
                Option::None
            } else {
                Option::Some(p)
            }
        },
        Option::None => Option::None,
    }
}

/// `N` consecutive proof commitments `(x, y)` starting at word `off`, each through `read_g1`
/// (canonical, on the curve, not infinity). `None` if any is rejected. One loop instead of `N`
/// unrolled copies of the check: the emitted verifiers stay under the EIP-170 code-size limit.
pub fn read_points<const L: usize, const N: usize>(_ proof: [u256; L], _ off: usize) -> Option<
    [G1; N],
> {
    assert(off + 2 * N <= L)
    var out = [G1::infinity(); N]
    var i: usize = 0
    while i < N {
        match read_g1(proof[off + 2 * i], proof[off + 2 * i + 1]) {
            Option::Some(p) => {
                out[i] = p
            },
            Option::None => {
                return Option::None
            },
        }
        i += 1
    }
    Option::Some(out)
}

/// `N` consecutive proof scalars starting at word `off`, each through `Bn254Fr::from_canonical`
/// (never reduced). `None` if any is `>= r`.
pub fn read_scalars<const L: usize, const N: usize>(_ proof: [u256; L], _ off: usize) -> Option<
    [Bn254Fr; N],
> {
    assert(off + N <= L)
    var out = [Bn254Fr::zero(); N]
    var i: usize = 0
    while i < N {
        match Bn254Fr::from_canonical(proof[off + i]) {
            Option::Some(v) => {
                out[i] = v
            },
            Option::None => {
                return Option::None
            },
        }
        i += 1
    }
    Option::Some(out)
}

/// Capacity of the transcript buffer in bytes. Memory is only paid for when touched; an absorb
/// past the capacity reverts (never silently truncates). The largest absorb run between two
/// squeezes of the shipped circuits is a few hundred bytes.
const TRANSCRIPT_CAP: usize = 8192

/// snark-verifier `EvmTranscript` state. The buffer holds the 32-byte big-endian words absorbed
/// since the last squeeze, prefixed by the previous digest. A squeeze hashes the whole buffer
/// and the digest becomes the new buffer; there are no labels (SPEC section 2). One contiguous
/// memory buffer: an absorb is one `MSTORE`, a squeeze one `KECCAK256` over the buffer.
pub struct Halo2Transcript { buf: MemBuffer, len: usize }

impl Halo2Transcript {
    pub fn new() -> Halo2Transcript {
        Halo2Transcript { buf: MemBuffer::with_capacity(TRANSCRIPT_CAP), len: 0 }
    }

    /// Absorb one 32-byte word (a canonical scalar or one coordinate).
    pub fn absorb(mut self, _ w: u256) {
        assert(self.len + 32 <= TRANSCRIPT_CAP)
        put_at(mut self.buf, self.len as u256, w)
        self.len += 32
    }

    pub fn absorb_point(mut self, _ x: u256, _ y: u256) {
        assert(self.len + 64 <= TRANSCRIPT_CAP)
        put_at(mut self.buf, self.len as u256, x)
        put_at(mut self.buf, (self.len + 32) as u256, y)
        self.len += 64
    }

    /// Absorb `proof[from..to]` word by word (points and scalars are both 32-byte words).
    pub fn absorb_words<const L: usize>(mut self, _ proof: [u256; L], _ from: usize, _ to: usize) {
        assert(to <= L)
        assert(from <= to)
        assert(self.len + (to - from) * 32 <= TRANSCRIPT_CAP)
        var i = from
        var at = self.len as u256
        while i < to {
            put_at(mut self.buf, at, proof[i])
            at += 32
            i += 1
        }
        self.len += (to - from) * 32
    }

    /// `keccak256(buf)` (plus a `0x01` byte if `buf` is exactly one word), reduced mod r.
    pub fn squeeze(mut self) -> Bn254Fr {
        var n = self.len
        if n == 32 {
            // One byte 0x01 after the word; the rest of the written word is outside the hashed range.
            put_at(mut self.buf, 32, 1 << 248)
            n = 33
        }
        unsafe {
            self.buf.set_len(n)
        }
        let h = keccak256(self.buf.span())
        put_at(mut self.buf, 0, h)
        self.len = 32
        Bn254Fr::reduce(h)
    }
}

/// Montgomery batch inversion: one modexp for all of `xs`. `None` if any element is zero.
pub fn batch_inv<const N: usize>(_ xs: [Bn254Fr; N]) -> Option<[Bn254Fr; N]>
uses (call: Call, ctx: Ctx)
{
    var pre = xs
    var acc = Bn254Fr::one()
    var i: usize = 0
    while i < N {
        pre[i] = acc
        acc = acc.mul(xs[i])
        i += 1
    }
    var inv = match inv_modexp(acc) {
        Option::Some(v) => v,
        Option::None => {
            return Option::None
        },
    }
    var out = xs
    var k: usize = 0
    while k < N {
        let j = N - 1 - k
        out[j] = inv.mul(pre[j])
        inv = inv.mul(xs[j])
        k += 1
    }
    Option::Some(out)
}

/// `e(left, [s]H) * e(right, -H) == 1` with success flag, length and result checks (rule 6)
/// inside `pairing_check`.
pub fn final_pairing(_ vk: Vk, _ left: G1, _ right: G1) -> bool
uses (call: Call, ctx: Ctx)
{
    if vk.g1.is_infinity() || vk.g2.is_infinity() || vk.s_g2.is_infinity() {
        return false
    }
    pairing_check([left, right], [vk.s_g2, vk.g2.neg()])
}

/// `acc + [s] p`.
pub fn mul_add(_ acc: G1, _ p: G1, _ s: Bn254Fr) -> G1 uses (call: Call, ctx: Ctx) {
    g1_add(acc, g1_mul(p, s))
}
