        s1 = sbox5(addmod(s1, P2_BN254_T3_EXT[0 + r * 3 + 1], R))
        s2 = sbox5(addmod(s2, P2_BN254_T3_EXT[0 + r * 3 + 2], R))
        let sum = s0 + s1 + s2
        s0 = addmod(s0, sum, R)
        s1 = addmod(s1, sum, R)
        s2 = addmod(s2, sum, R)
        r += 1
    }
    r = 0
    while r < 56 {
        s0 = sbox5(addmod(s0, P2_BN254_T3_INT[r], R))
        let sum = s0 + s1 + s2
        s0 = addmod(sum, mulmod(P2_BN254_T3_DIAG[0], s0, R), R)
        s1 = addmod(sum, mulmod(P2_BN254_T3_DIAG[1], s1, R), R)
        s2 = addmod(sum, mulmod(P2_BN254_T3_DIAG[2], s2, R), R)
        r += 1
    }
    r = 0
    while r < 4 {
        s0 = sbox5(addmod(s0, P2_BN254_T3_EXT[12 + r * 3 + 0], R))
        s1 = sbox5(addmod(s1, P2_BN254_T3_EXT[12 + r * 3 + 1], R))
        s2 = sbox5(addmod(s2, P2_BN254_T3_EXT[12 + r * 3 + 2], R))
        let sum = s0 + s1 + s2
        s0 = addmod(s0, sum, R)
        s1 = addmod(s1, sum, R)
        s2 = addmod(s2, sum, R)
        r += 1
    }
    [s0, s1, s2]
