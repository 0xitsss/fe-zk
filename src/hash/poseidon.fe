//! Poseidon over the BN254 scalar field, compatible with circomlib / circomlibjs `poseidon`.
//!
//! `poseidon_n(inputs)` is `circomlibjs.poseidon([inputs...])`: state `[0, inputs...]`
//! (t = n + 1), 8 full rounds, 56..60 partial rounds, x^5 S-box. This is the "optimized" form
//! (Neptune sparse matrices) of the same permutation: partial rounds cost O(t) field
//! multiplications instead of O(t^2); the output is identical to the plain form.
//!
//! Inputs are `Bn254Fr`, so a non-canonical input cannot be passed (safety rule 1).
use ingot::field::{Bn254Fr, Field}
use std::evm::crypto::{addmod, mulmod}
use super::poseidon_unrolled::{permute_t2, permute_t3, permute_t4, permute_t5, permute_t6}
use super::poseidon_constants::{
    POSEIDON_C2,
    POSEIDON_C3,
    POSEIDON_C4,
    POSEIDON_C5,
    POSEIDON_C6,
    POSEIDON_M2,
    POSEIDON_M3,
    POSEIDON_M4,
    POSEIDON_M5,
    POSEIDON_M6,
    POSEIDON_P2,
    POSEIDON_P3,
    POSEIDON_P4,
    POSEIDON_P5,
    POSEIDON_P6,
    POSEIDON_S2,
    POSEIDON_S3,
    POSEIDON_S4,
    POSEIDON_S5,
    POSEIDON_S6,
}

const R: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617

// Implementation notes (gas).
//
// The permutation works on raw `u256` lanes with `addmod`/`mulmod`, not on `Bn254Fr`:
// the public functions take and return `Bn254Fr` (so a non-canonical input cannot be passed,
// safety rule 1) and convert once at the boundary. The tables (`POSEIDON_*`) are canonical
// (every entry < R, test `poseidon_tables_are_canonical`), so no per-use `reduce` is needed.
//
// Bounds used for lazy reduction (safety rule 7), with R < 0.1889 * 2^256, so 5 * R < 2^256:
//  - `mulmod`/`addmod` are exact for any u256 operands (512-bit intermediate) and return < R.
//  - a sum of at most 5 values each < R does not overflow u256. `dot` adds products (each < R)
//    and reduces with `% R` every 4 terms, so the accumulator is always < R + 4 * R = 5 * R.

fn sbox(_ x: u256) -> u256 {
    let x2 = mulmod(x, x, R)
    let x4 = mulmod(x2, x2, R)
    mulmod(x4, x, R)
}

/// `sum_j m[off + j * stride] * s[j] mod R`, all `m` entries < R, `s[j]` any u256.
fn dot<const T: usize, const NM: usize>(
    _ s: [u256; T],
    _ m: [u256; NM],
    _ off: usize,
    _ stride: usize,
) -> u256 {
    var acc: u256 = 0
    var j: usize = 0
    while j < T {
        // acc < 5R before this add if the previous reduction ran (see module note)
        acc = acc + mulmod(m[off + j * stride], s[j], R)
        if j & 3 == 3 {
            acc = acc % R
        }
        j += 1
    }
    acc % R
}

/// `out_i = sum_j m[j * T + i] * s_j`.
fn mix<const T: usize, const NM: usize>(_ s: [u256; T], _ m: [u256; NM]) -> [u256; T] {
    var out: [u256; T] = s
    var i: usize = 0
    while i < T {
        out[i] = dot(s, m, i, T)
        i += 1
    }
    out
}

/// Full round front: `s_i = sbox(s_i) + c[offset + i]`.
fn sbox_add<const T: usize, const NC: usize>(
    _ s: [u256; T],
    _ c: [u256; NC],
    _ offset: usize,
) -> [u256; T] {
    var out: [u256; T] = s
    var i: usize = 0
    while i < T {
        out[i] = addmod(sbox(s[i]), c[offset + i], R)
        i += 1
    }
    out
}

/// The circomlib optimized permutation on a width-`T` state; returns lane 0.
/// Inputs must be canonical (< R); the type-checked callers guarantee it.
fn permute_array<const T: usize, const NC: usize, const NS: usize, const NM: usize>(
    _ input: [u256; T],
    _ c: [u256; NC],
    _ s: [u256; NS],
    _ m: [u256; NM],
    _ p: [u256; NM],
    _ n_p: usize,
) -> u256 {
    var st: [u256; T] = input
    var i: usize = 0
    while i < T {
        st[i] = addmod(input[i], c[i], R)
        i += 1
    }
    var r: usize = 0
    while r < 3 {
        st = mix(sbox_add(st, c, (r + 1) * T), m)
        r += 1
    }
    st = mix(sbox_add(st, c, 4 * T), p)

    r = 0
    while r < n_p {
        let x0 = addmod(sbox(st[0]), c[5 * T + r], R)
        let base = (2 * T - 1) * r
        // new lane 0 = s[base] * x0 + sum_j s[base + j] * st[j]
        var s0: u256 = mulmod(s[base], x0, R)
        var j: usize = 1
        while j < T {
            s0 = s0 + mulmod(s[base + j], st[j], R)
            if j & 3 == 3 { s0 = s0 % R }
            j += 1
        }
        var k2: usize = 1
        while k2 < T {
            st[k2] = addmod(st[k2], mulmod(x0, s[base + T + k2 - 1], R), R)
            k2 += 1
        }
        st[0] = s0 % R
        r += 1
    }

    r = 0
    while r < 3 {
        st = mix(sbox_add(st, c, 5 * T + n_p + r * T), m)
        r += 1
    }
    // only lane 0 of the final matrix product is the output
    var last: [u256; T] = st
    i = 0
    while i < T {
        last[i] = sbox(st[i])
        i += 1
    }
    dot(last, m, 0, T)
}

/// `circomlibjs.poseidon([a])`.
pub fn poseidon_1(_ a: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(permute_t2(a.to_canonical()))
}

/// `circomlibjs.poseidon([a, b])`.
pub fn poseidon_2(_ a: Bn254Fr, _ b: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(permute_t3(a.to_canonical(), b.to_canonical()))
}

/// `circomlibjs.poseidon([a, b, c])`.
pub fn poseidon_3(_ a: Bn254Fr, _ b: Bn254Fr, _ c: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_t4(a.to_canonical(), b.to_canonical(), c.to_canonical()),
    )
}

/// `circomlibjs.poseidon([a, b, c, d])`.
pub fn poseidon_4(_ a: Bn254Fr, _ b: Bn254Fr, _ c: Bn254Fr, _ d: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_t5(
            a.to_canonical(),
            b.to_canonical(),
            c.to_canonical(),
            d.to_canonical(),
        ),
    )
}

/// `circomlibjs.poseidon([a, b, c, d, e])`.
pub fn poseidon_5(_ a: Bn254Fr, _ b: Bn254Fr, _ c: Bn254Fr, _ d: Bn254Fr, _ e: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_t6(
            a.to_canonical(),
            b.to_canonical(),
            c.to_canonical(),
            d.to_canonical(),
            e.to_canonical(),
        ),
    )
}

/// Readable array version of `poseidon_n([a])`.
pub fn reference_poseidon_1(_ a: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_array(
            [0, a.to_canonical()],
            POSEIDON_C2,
            POSEIDON_S2,
            POSEIDON_M2,
            POSEIDON_P2,
            56,
        ),
    )
}

/// Readable array version of `poseidon_n([a, b])`.
pub fn reference_poseidon_2(_ a: Bn254Fr, _ b: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_array(
            [0, a.to_canonical(), b.to_canonical()],
            POSEIDON_C3,
            POSEIDON_S3,
            POSEIDON_M3,
            POSEIDON_P3,
            57,
        ),
    )
}

/// Readable array version of `poseidon_n([a, b, c])`.
pub fn reference_poseidon_3(_ a: Bn254Fr, _ b: Bn254Fr, _ c: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_array(
            [0, a.to_canonical(), b.to_canonical(), c.to_canonical()],
            POSEIDON_C4,
            POSEIDON_S4,
            POSEIDON_M4,
            POSEIDON_P4,
            56,
        ),
    )
}

/// Readable array version of `poseidon_n([a, b, c, d])`.
pub fn reference_poseidon_4(_ a: Bn254Fr, _ b: Bn254Fr, _ c: Bn254Fr, _ d: Bn254Fr) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_array(
            [0, a.to_canonical(), b.to_canonical(), c.to_canonical(), d.to_canonical()],
            POSEIDON_C5,
            POSEIDON_S5,
            POSEIDON_M5,
            POSEIDON_P5,
            60,
        ),
    )
}

/// Readable array version of `poseidon_n([a, b, c, d, e])`.
pub fn reference_poseidon_5(
    _ a: Bn254Fr,
    _ b: Bn254Fr,
    _ c: Bn254Fr,
    _ d: Bn254Fr,
    _ e: Bn254Fr,
) -> Bn254Fr {
    Bn254Fr::reduce(
        permute_array(
            [
                0,
                a.to_canonical(),
                b.to_canonical(),
                c.to_canonical(),
                d.to_canonical(),
                e.to_canonical(),
            ],
            POSEIDON_C6,
            POSEIDON_S6,
            POSEIDON_M6,
            POSEIDON_P6,
            60,
        ),
    )
}
