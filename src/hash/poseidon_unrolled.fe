    var s2: u256 = addmod(i2, POSEIDON_C6[2], R)
    var s3: u256 = addmod(i3, POSEIDON_C6[3], R)
    var s4: u256 = addmod(i4, POSEIDON_C6[4], R)
    var s5: u256 = addmod(i5, POSEIDON_C6[5], R)
    var r: usize = 0
    while r < 3 {
        let off = (r + 1) * 6
        let a0 = addmod(sbox(s0), POSEIDON_C6[off + 0], R)
        let a1 = addmod(sbox(s1), POSEIDON_C6[off + 1], R)
        let a2 = addmod(sbox(s2), POSEIDON_C6[off + 2], R)
        let a3 = addmod(sbox(s3), POSEIDON_C6[off + 3], R)
        let a4 = addmod(sbox(s4), POSEIDON_C6[off + 4], R)
        let a5 = addmod(sbox(s5), POSEIDON_C6[off + 5], R)
        s0 = addmod(
            mulmod(POSEIDON_M6[0], a0, R)
                + mulmod(POSEIDON_M6[6], a1, R)
                + mulmod(POSEIDON_M6[12], a2, R),
            mulmod(POSEIDON_M6[18], a3, R)
                + mulmod(POSEIDON_M6[24], a4, R)
                + mulmod(POSEIDON_M6[30], a5, R),
            R,
        )
        s1 = addmod(
            mulmod(POSEIDON_M6[1], a0, R)
                + mulmod(POSEIDON_M6[7], a1, R)
                + mulmod(POSEIDON_M6[13], a2, R),
            mulmod(POSEIDON_M6[19], a3, R)
                + mulmod(POSEIDON_M6[25], a4, R)
                + mulmod(POSEIDON_M6[31], a5, R),
            R,
        )
        s2 = addmod(
            mulmod(POSEIDON_M6[2], a0, R)
                + mulmod(POSEIDON_M6[8], a1, R)
                + mulmod(POSEIDON_M6[14], a2, R),
            mulmod(POSEIDON_M6[20], a3, R)
                + mulmod(POSEIDON_M6[26], a4, R)
                + mulmod(POSEIDON_M6[32], a5, R),
            R,
        )
        s3 = addmod(
            mulmod(POSEIDON_M6[3], a0, R)
                + mulmod(POSEIDON_M6[9], a1, R)
                + mulmod(POSEIDON_M6[15], a2, R),
            mulmod(POSEIDON_M6[21], a3, R)
                + mulmod(POSEIDON_M6[27], a4, R)
                + mulmod(POSEIDON_M6[33], a5, R),
            R,
        )
        s4 = addmod(
            mulmod(POSEIDON_M6[4], a0, R)
                + mulmod(POSEIDON_M6[10], a1, R)
                + mulmod(POSEIDON_M6[16], a2, R),
            mulmod(POSEIDON_M6[22], a3, R)
                + mulmod(POSEIDON_M6[28], a4, R)
                + mulmod(POSEIDON_M6[34], a5, R),
            R,
        )
        s5 = addmod(
            mulmod(POSEIDON_M6[5], a0, R)
                + mulmod(POSEIDON_M6[11], a1, R)
                + mulmod(POSEIDON_M6[17], a2, R),
            mulmod(POSEIDON_M6[23], a3, R)
                + mulmod(POSEIDON_M6[29], a4, R)
                + mulmod(POSEIDON_M6[35], a5, R),
            R,
        )
        r += 1
    }
    {
        let a0 = addmod(sbox(s0), POSEIDON_C6[24 + 0], R)
        let a1 = addmod(sbox(s1), POSEIDON_C6[24 + 1], R)
        let a2 = addmod(sbox(s2), POSEIDON_C6[24 + 2], R)
        let a3 = addmod(sbox(s3), POSEIDON_C6[24 + 3], R)
        let a4 = addmod(sbox(s4), POSEIDON_C6[24 + 4], R)
        let a5 = addmod(sbox(s5), POSEIDON_C6[24 + 5], R)
        s0 = addmod(
            mulmod(POSEIDON_P6[0], a0, R)
                + mulmod(POSEIDON_P6[6], a1, R)
                + mulmod(POSEIDON_P6[12], a2, R),
            mulmod(POSEIDON_P6[18], a3, R)
                + mulmod(POSEIDON_P6[24], a4, R)
                + mulmod(POSEIDON_P6[30], a5, R),
            R,
        )
        s1 = addmod(
            mulmod(POSEIDON_P6[1], a0, R)
                + mulmod(POSEIDON_P6[7], a1, R)
                + mulmod(POSEIDON_P6[13], a2, R),
            mulmod(POSEIDON_P6[19], a3, R)
                + mulmod(POSEIDON_P6[25], a4, R)
                + mulmod(POSEIDON_P6[31], a5, R),
            R,
        )
        s2 = addmod(
            mulmod(POSEIDON_P6[2], a0, R)
                + mulmod(POSEIDON_P6[8], a1, R)
                + mulmod(POSEIDON_P6[14], a2, R),
            mulmod(POSEIDON_P6[20], a3, R)
                + mulmod(POSEIDON_P6[26], a4, R)
                + mulmod(POSEIDON_P6[32], a5, R),
            R,
        )
        s3 = addmod(
            mulmod(POSEIDON_P6[3], a0, R)
                + mulmod(POSEIDON_P6[9], a1, R)
                + mulmod(POSEIDON_P6[15], a2, R),
            mulmod(POSEIDON_P6[21], a3, R)
                + mulmod(POSEIDON_P6[27], a4, R)
                + mulmod(POSEIDON_P6[33], a5, R),
            R,
        )
        s4 = addmod(
            mulmod(POSEIDON_P6[4], a0, R)
                + mulmod(POSEIDON_P6[10], a1, R)
                + mulmod(POSEIDON_P6[16], a2, R),
            mulmod(POSEIDON_P6[22], a3, R)
                + mulmod(POSEIDON_P6[28], a4, R)
                + mulmod(POSEIDON_P6[34], a5, R),
            R,
        )
        s5 = addmod(
            mulmod(POSEIDON_P6[5], a0, R)
                + mulmod(POSEIDON_P6[11], a1, R)
                + mulmod(POSEIDON_P6[17], a2, R),
            mulmod(POSEIDON_P6[23], a3, R)
                + mulmod(POSEIDON_P6[29], a4, R)
                + mulmod(POSEIDON_P6[35], a5, R),
            R,
        )
    }
    r = 0
    while r < 60 {
        let x0 = addmod(sbox(s0), POSEIDON_C6[30 + r], R)
        let base = 11 * r
        let n0 = addmod(
            mulmod(POSEIDON_S6[base], x0, R)
                + mulmod(POSEIDON_S6[base + 1], s1, R)
                + mulmod(POSEIDON_S6[base + 2], s2, R),
            mulmod(POSEIDON_S6[base + 3], s3, R)
                + mulmod(POSEIDON_S6[base + 4], s4, R)
                + mulmod(POSEIDON_S6[base + 5], s5, R),
            R,
        )
        s1 = addmod(s1, mulmod(x0, POSEIDON_S6[base + 6], R), R)
        s2 = addmod(s2, mulmod(x0, POSEIDON_S6[base + 7], R), R)
        s3 = addmod(s3, mulmod(x0, POSEIDON_S6[base + 8], R), R)
        s4 = addmod(s4, mulmod(x0, POSEIDON_S6[base + 9], R), R)
        s5 = addmod(s5, mulmod(x0, POSEIDON_S6[base + 10], R), R)
        s0 = n0
        r += 1
    }
    r = 0
    while r < 3 {
        let off = 90 + r * 6
        let a0 = addmod(sbox(s0), POSEIDON_C6[off + 0], R)
        let a1 = addmod(sbox(s1), POSEIDON_C6[off + 1], R)
        let a2 = addmod(sbox(s2), POSEIDON_C6[off + 2], R)
        let a3 = addmod(sbox(s3), POSEIDON_C6[off + 3], R)
        let a4 = addmod(sbox(s4), POSEIDON_C6[off + 4], R)
        let a5 = addmod(sbox(s5), POSEIDON_C6[off + 5], R)
        s0 = addmod(
            mulmod(POSEIDON_M6[0], a0, R)
                + mulmod(POSEIDON_M6[6], a1, R)
                + mulmod(POSEIDON_M6[12], a2, R),
            mulmod(POSEIDON_M6[18], a3, R)
                + mulmod(POSEIDON_M6[24], a4, R)
                + mulmod(POSEIDON_M6[30], a5, R),
            R,
        )
        s1 = addmod(
            mulmod(POSEIDON_M6[1], a0, R)
                + mulmod(POSEIDON_M6[7], a1, R)
                + mulmod(POSEIDON_M6[13], a2, R),
            mulmod(POSEIDON_M6[19], a3, R)
                + mulmod(POSEIDON_M6[25], a4, R)
                + mulmod(POSEIDON_M6[31], a5, R),
            R,
        )
        s2 = addmod(
            mulmod(POSEIDON_M6[2], a0, R)
                + mulmod(POSEIDON_M6[8], a1, R)
                + mulmod(POSEIDON_M6[14], a2, R),
            mulmod(POSEIDON_M6[20], a3, R)
                + mulmod(POSEIDON_M6[26], a4, R)
                + mulmod(POSEIDON_M6[32], a5, R),
            R,
        )
        s3 = addmod(
            mulmod(POSEIDON_M6[3], a0, R)
                + mulmod(POSEIDON_M6[9], a1, R)
                + mulmod(POSEIDON_M6[15], a2, R),
            mulmod(POSEIDON_M6[21], a3, R)
                + mulmod(POSEIDON_M6[27], a4, R)
                + mulmod(POSEIDON_M6[33], a5, R),
            R,
        )
        s4 = addmod(
            mulmod(POSEIDON_M6[4], a0, R)
                + mulmod(POSEIDON_M6[10], a1, R)
                + mulmod(POSEIDON_M6[16], a2, R),
            mulmod(POSEIDON_M6[22], a3, R)
                + mulmod(POSEIDON_M6[28], a4, R)
                + mulmod(POSEIDON_M6[34], a5, R),
            R,
        )
        s5 = addmod(
            mulmod(POSEIDON_M6[5], a0, R)
                + mulmod(POSEIDON_M6[11], a1, R)
                + mulmod(POSEIDON_M6[17], a2, R),
            mulmod(POSEIDON_M6[23], a3, R)
                + mulmod(POSEIDON_M6[29], a4, R)
                + mulmod(POSEIDON_M6[35], a5, R),
            R,
        )
        r += 1
    }
    let z0 = sbox(s0)
    let z1 = sbox(s1)
    let z2 = sbox(s2)
    let z3 = sbox(s3)
    let z4 = sbox(s4)
    let z5 = sbox(s5)
    addmod(
        mulmod(POSEIDON_M6[0], z0, R)
            + mulmod(POSEIDON_M6[6], z1, R)
            + mulmod(POSEIDON_M6[12], z2, R),
        mulmod(POSEIDON_M6[18], z3, R)
            + mulmod(POSEIDON_M6[24], z4, R)
            + mulmod(POSEIDON_M6[30], z5, R),
        R,
    )
}
