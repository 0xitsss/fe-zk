//! Shared helpers for calling EVM precompiles with explicit success and length checks
//! (safety rule 6). Not re-exported: every public wrapper lives next to its point types.
use core::ptr::{self, FixedMemBuffer, MemBuffer}
use core::abi::{load_word, store_word}
use std::evm::{Address, Call, Ctx}

// Every call passes an explicit gas cap just above the precompile's price. A failing precompile
// (invalid point, bad proof) consumes ALL gas forwarded to it, so forwarding "everything" would
// let one rejected point burn 63/64 of the transaction's gas.

/// Gas that must remain above a precompile's forwarded cap before it is called. Covers the work
/// between the check and the STATICCALL plus the rest of the caller's frame.
pub const GAS_MARGIN: u256 = 5000

/// Failure rule: an invalid input is `false`, a lack of gas is a revert. A precompile that runs
/// out of gas looks exactly like one that rejected its input, so without this check a caller
/// could pick the gas limit that makes a valid proof come back `false`. Reverts unless at least
/// `cap + GAS_MARGIN` gas remains.
pub fn require_gas(_ cap: u256) uses (ctx: Ctx) {
    assert(ctx.gas() >= cap + GAS_MARGIN)
}

/// Writes `v` as the 32-byte word at byte offset `32 * index`.
pub fn put(_ buf: mut MemBuffer, _ index: usize, _ v: u256) {
    unsafe {
        store_word(
            ptr: ptr::offset_bytes(buf.ptr(), (index * 32) as u256),
            value: v,
        )
    }
}

/// Writes `v` as the 32-byte word at byte offset `at` (need not be word aligned).
pub fn put_at(_ buf: mut MemBuffer, _ at: u256, _ v: u256) {
    unsafe {
        store_word(ptr: ptr::offset_bytes(buf.ptr(), at), value: v)
    }
}

/// Reads the 32-byte word at byte offset `32 * index`.
pub fn get(_ buf: MemBuffer, _ index: usize) -> u256 {
    unsafe {
        load_word(ptr::offset_bytes(buf.ptr(), (index * 32) as u256))
    }
}

/// Static call to precompile `addr` with the first `in_len` bytes of `input`.
/// Returns the call's success flag. If the call succeeded, reverts unless it returned
/// exactly `out_len` bytes.
pub fn call_try(
    _ addr: u256,
    _ gas: u256,
    _ input: mut MemBuffer,
    _ in_len: usize,
    _ out: mut MemBuffer,
    _ out_len: u256,
) -> bool
uses (call: Call, ctx: Ctx)
{
    require_gas(gas)
    unsafe {
        input.set_len(in_len)
    }
    let r = call
        .raw_staticcall(
            addr: Address::new(addr),
            gas: gas,
            args: input.span(),
            ret: mut out,
        )
    if r.success() {
        assert(r.returndata_len() == out_len)
    }
    r.success()
}

/// Like `call_try`, but reverts if the call fails.
pub fn call_checked(
    _ addr: u256,
    _ gas: u256,
    _ input: mut MemBuffer,
    _ in_len: usize,
    _ out: mut MemBuffer,
    _ out_len: u256,
)
uses (call: Call, ctx: Ctx)
{
    assert(call_try(addr, gas, mut input, in_len, mut out, out_len))
}

/// Writes `v` as the word at byte offset `at` of a fixed buffer.
#[inline(always)]
pub fn fput<const N: usize>(_ buf: FixedMemBuffer<N>, _ at: u256, _ v: u256) {
    unsafe {
        store_word(ptr: ptr::offset_bytes(buf.ptr(), at), value: v)
    }
}

/// Reads the word at byte offset `at` of a fixed buffer.
#[inline(always)]
pub fn fget<const N: usize>(_ buf: FixedMemBuffer<N>, _ at: u256) -> u256 {
    unsafe {
        load_word(ptr::offset_bytes(buf.ptr(), at))
    }
}

/// Fixed-size variant of `call_try`: no heap allocation, `I` input bytes and `O` output bytes
/// are static. Success flag is returned; if the call succeeded, reverts unless it returned
/// exactly `O` bytes.
#[inline(always)]
pub fn call_try_fixed<const I: usize>(
    _ addr: u256,
    _ gas: u256,
    _ input: own FixedMemBuffer<I>,
    _ out: mut MemBuffer,
    _ out_len: u256,
) -> bool
uses (call: Call, ctx: Ctx)
{
    require_gas(gas)
    var inb = input.into_buffer()
    let r = call.raw_staticcall(
            addr: Address::new(addr),
            gas: gas,
            args: inb.span(),
            ret: mut out,
        )
    if r.success() {
        assert(r.returndata_len() == out_len)
    }
    r.success()
}

/// `call_try_fixed` for an input in a `MemBuffer` whose first `in_len` bytes are written.
#[inline(always)]
pub fn call_try_fixed_buf(
    _ addr: u256,
    _ gas: u256,
    _ input: mut MemBuffer,
    _ in_len: usize,
    _ out: mut MemBuffer,
    _ out_len: u256,
) -> bool
uses (call: Call, ctx: Ctx)
{
    require_gas(gas)
    unsafe {
        input.set_len(in_len)
    }
    let r = call
        .raw_staticcall(
            addr: Address::new(addr),
            gas: gas,
            args: input.span(),
            ret: mut out,
        )
    if r.success() {
        assert(r.returndata_len() == out_len)
    }
    r.success()
}
