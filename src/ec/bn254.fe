//! BN254 (alt_bn128) curve layer: typed points, precompile wrappers, G2 subgroup check.
//!
//! `G1` and `G2` have private fields. Outside this file a point can only be made by
//! `G1::from_coords` / `G2::from_coords` (which check canonical coordinates, curve membership
//! and, for G2, subgroup membership), by the compile-time `from_coords_or_infinity`, by
//! `generator()`, or as the output of an operation on valid points. A raw `u256` can therefore
//! never become a point unchecked (safety rules 1-3).
//!
//! All validity checks are `const fn` over raw `u256` words (`mulmod` / `addmod`), so the same
//! code runs at runtime (`from_coords`, calldata) and at compile time (`static_assert` on
//! verifying-key constants, see `fe-zk-gen`): a key with an invalid point does not compile, and a
//! valid key costs no gas to validate.
//!
//! Precompile wrappers revert (`assert`) if the call fails or returns the wrong number of bytes
//! (safety rule 6). `pairing_check` returns `true` only if the precompile returns exactly 1.
//!
//! Precompile word order for G2 (EIP-197): `x_imag, x_real, y_imag, y_real`. The Fe API uses
//! `(x0, x1, y0, y1)` = `(x_real, x_imag, y_real, y_imag)`, the order of py_ecc / arkworks.
use core::ptr::{FixedMemBuffer, MemBuffer}
use std::evm::{Call, Ctx}
use std::evm::crypto::{addmod, mulmod}
use ingot::field::{Bn254Fr, Field}
use super::precompile::{
    call_checked,
    call_try,
    call_try_fixed,
    call_try_fixed_buf,
    fget,
    fput,
    get,
    put,
}

/// BN254 base field modulus.
const Q: u256 = 21888242871839275222246405745257275088696311157297823662689037894645226208583

/// `6 x^2` for the BN254 parameter `x = 4965661367192848881`; `psi(P) = [6 x^2] P` on G2.
const SIX_X_SQ: u256 = 147946756881789318990833708069417712966

// psi constants: GAMMA1 = xi^((q-1)/3), GAMMA2 = xi^((q-1)/2), xi = 9 + u (py_ecc, see scripts/ec-vectors.py)
const GAMMA1_C0: u256 = 21575463638280843010398324269430826099269044274347216827212613867836435027261
const GAMMA1_C1: u256 = 10307601595873709700152284273816112264069230130616436755625194854815875713954
const GAMMA2_C0: u256 = 2821565182194536844548159561693502659359617185244120367078079554186484126554
const GAMMA2_C1: u256 = 3505843767911556378687030309984248845540243509899259641013678093033130930403
/// Twist coefficient b' = 3 / (9 + u).
const B2_C0: u256 = 19485874751759354771024239261021720505790618469301721065564631296452457478373
const B2_C1: u256 = 266929791119991161246907387137283842545076965332900288569378510910307636690

// ---------------------------------------------------------------------------------------
// Fq helpers (canonical u256 in [0, Q))
// ---------------------------------------------------------------------------------------

const fn fadd(_ a: u256, _ b: u256) -> u256 {
    addmod(a, b, Q)
}

const fn fsub(_ a: u256, _ b: u256) -> u256 {
    // b < Q, so Q - b is in (0, Q]; addmod reduces
    addmod(a, Q - b, Q)
}

const fn fmul(_ a: u256, _ b: u256) -> u256 {
    mulmod(a, b, Q)
}

const fn fneg(_ a: u256) -> u256 {
    addmod(0, Q - a, Q)
}

// ---------------------------------------------------------------------------------------
// Fq2 = Fq[u] / (u^2 + 1), both coordinates canonical
// ---------------------------------------------------------------------------------------

struct Fq2 { c0: u256, c1: u256 }
impl Copy for Fq2 {}

impl Fq2 {
    const fn new(_ c0: u256, _ c1: u256) -> Fq2 {
        Fq2 { c0, c1 }
    }
    const fn zero() -> Fq2 {
        Fq2 { c0: 0, c1: 0 }
    }
    const fn one() -> Fq2 {
        Fq2 { c0: 1, c1: 0 }
    }
    const fn is_zero(self) -> bool {
        self.c0 == 0 && self.c1 == 0
    }
    const fn eq(self, _ o: Fq2) -> bool {
        self.c0 == o.c0 && self.c1 == o.c1
    }
    const fn add(self, _ o: Fq2) -> Fq2 {
        Fq2 { c0: fadd(self.c0, o.c0), c1: fadd(self.c1, o.c1) }
    }
    const fn sub(self, _ o: Fq2) -> Fq2 {
        Fq2 { c0: fsub(self.c0, o.c0), c1: fsub(self.c1, o.c1) }
    }
    const fn neg(self) -> Fq2 {
        Fq2 { c0: fneg(self.c0), c1: fneg(self.c1) }
    }
    const fn double(self) -> Fq2 {
        self.add(self)
    }
    const fn conj(self) -> Fq2 {
        Fq2 { c0: self.c0, c1: fneg(self.c1) }
    }
    /// Karatsuba: 3 base multiplications.
    const fn mul(self, _ o: Fq2) -> Fq2 {
        let v0 = fmul(self.c0, o.c0)
        let v1 = fmul(self.c1, o.c1)
        let s = fmul(fadd(self.c0, self.c1), fadd(o.c0, o.c1))
        Fq2 { c0: fsub(v0, v1), c1: fsub(fsub(s, v0), v1) }
    }
    const fn square(self) -> Fq2 {
        // (a+bu)^2 = (a+b)(a-b) + 2ab u
        let ab = fmul(self.c0, self.c1)
        Fq2 { c0: fmul(fadd(self.c0, self.c1), fsub(self.c0, self.c1)), c1: fadd(ab, ab) }
    }
}

// ---------------------------------------------------------------------------------------
// G1
// ---------------------------------------------------------------------------------------

/// Whether `(x, y)` is a valid G1 point: both coordinates `< q` (never reduced) and either the
/// explicit infinity `(0, 0)` or on `y^2 = x^3 + 3`. G1 has cofactor 1, so no subgroup check.
/// `const fn`: usable in `static_assert` and as runtime check.
pub const fn g1_is_valid(_ x: u256, _ y: u256) -> bool {
    if x >= Q || y >= Q {
        return false
    }
    if x == 0 && y == 0 {
        return true
    }
    fmul(y, y) == fadd(fmul(fmul(x, x), x), 3)
}

/// A point of BN254 G1 (`y^2 = x^3 + 3` over Fq, prime order, cofactor 1), affine; `(0, 0)` is
/// the point at infinity. Fields are private: build with `G1::from_coords`.
pub struct G1 { x: u256, y: u256 }
impl Copy for G1 {}

impl G1 {
    /// Validated constructor for untrusted coordinates. `None` if `x` or `y` is `>= q`
    /// (never reduced), or if the point is not on the curve. `(0, 0)` is infinity.
    pub fn from_coords(_ x: u256, _ y: u256) -> Option<G1> {
        if g1_is_valid(x, y) {
            Option::Some(G1 { x, y })
        } else {
            Option::None
        }
    }

    /// Compile-time constructor: the point if `(x, y)` passes `g1_is_valid`, else the point at
    /// infinity, so an unchecked point can never exist. Pair it with
    /// `static_assert(g1_is_valid(x, y))` to turn an invalid constant into a compile error.
    pub const fn from_coords_or_infinity(_ x: u256, _ y: u256) -> G1 {
        if g1_is_valid(x, y) {
            G1 { x, y }
        } else {
            G1 { x: 0, y: 0 }
        }
    }

    pub fn generator() -> G1 {
        G1 { x: 1, y: 2 }
    }

    pub const fn infinity() -> G1 {
        G1 { x: 0, y: 0 }
    }

    pub const fn is_infinity(self) -> bool {
        (self.x | self.y) == 0
    }

    /// Canonical x coordinate.
    pub fn x(self) -> u256 {
        self.x
    }

    /// Canonical y coordinate.
    pub fn y(self) -> u256 {
        self.y
    }

    pub const fn neg(self) -> G1 {
        G1 { x: self.x, y: fneg(self.y) }
    }

    pub fn eq(self, _ o: G1) -> bool {
        self.x == o.x && self.y == o.y
    }
}

// ---------------------------------------------------------------------------------------
// G2
// ---------------------------------------------------------------------------------------

// Jacobian point on the twist, used only by the subgroup check. Z = 0 is infinity.
struct J2 { x: Fq2, y: Fq2, z: Fq2 }
impl Copy for J2 {}

const fn j2_inf() -> J2 {
    J2 { x: Fq2::one(), y: Fq2::one(), z: Fq2::zero() }
}

/// Doubling for `a = 0` (dbl-2009-l). `Y = 0` or `Z = 0` yields `Z3 = 0`, i.e. infinity.
const fn j2_double(_ p: J2) -> J2 {
    let a = p.x.square()
    let b = p.y.square()
    let c = b.square()
    let t = p.x.add(b).square().sub(a).sub(c)
    let d = t.double()
    let e = a.double().add(a)
    let f = e.square()
    let x3 = f.sub(d.double())
    let c8 = c.double().double().double()
    let y3 = e.mul(d.sub(x3)).sub(c8)
    let z3 = p.y.mul(p.z).double()
    J2 { x: x3, y: y3, z: z3 }
}

/// Complete addition (add-2007-bl) with explicit handling of infinity, `P == Q` and `P == -Q`.
const fn j2_add(_ p: J2, _ q: J2) -> J2 {
    if p.z.is_zero() { return q }
    if q.z.is_zero() { return p }
    let z1z1 = p.z.square()
    let z2z2 = q.z.square()
    let u1 = p.x.mul(z2z2)
    let u2 = q.x.mul(z1z1)
    let s1 = p.y.mul(q.z).mul(z2z2)
    let s2 = q.y.mul(p.z).mul(z1z1)
    let h = u2.sub(u1)
    let r0 = s2.sub(s1)
    if h.is_zero() {
        if r0.is_zero() {
            return j2_double(p)
        }
        return j2_inf()
    }
    let i = h.double().square()
    let j = h.mul(i)
    let r = r0.double()
    let v = u1.mul(i)
    let x3 = r.square().sub(j).sub(v.double())
    let y3 = r.mul(v.sub(x3)).sub(s1.mul(j).double())
    let z3 = p.z.add(q.z).square().sub(z1z1).sub(z2z2).mul(h)
    J2 { x: x3, y: y3, z: z3 }
}

/// `[6 x^2] P` by left-to-right double-and-add (6 x^2 has 127 bits).
const fn j2_mul_six_x_sq(_ p: J2) -> J2 {
    var acc = p
    var i: u256 = 125
    while true {
        acc = j2_double(acc)
        if (SIX_X_SQ >> i) & 1 == 1 {
            acc = j2_add(acc, p)
        }
        if i == 0 { break }
        i -= 1
    }
    acc
}

/// Whether `(x0 + x1 u, y0 + y1 u)` is a valid G2 point: canonical coordinates (`< q`, never
/// reduced), the explicit all-zero infinity, or on the twist `y^2 = x^3 + 3/(9+u)` AND in the
/// order-`r` subgroup.
///
/// Subgroup test: `psi(P) == [6 x^2] P` where `psi` is the untwist-Frobenius-twist
/// endomorphism `(x, y) -> (conj(x) * GAMMA1, conj(y) * GAMMA2)`. On the twist group
/// `E'(Fq2)` (order `h * r`), `psi` acts as `[p]` on the order-`r` subgroup and `p = 6 x^2
/// mod r`; the equality fails for points outside it (Scott, ePrint 2021/1130, which proves
/// the check complete for BN curves). About 127 doublings and ~60 additions in Fq2, no
/// inversion; ~750k gas at runtime (`gas_report`), free at compile time.
pub const fn g2_is_valid(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> bool {
    if !g2_is_on_twist(x0, x1, y0, y1) {
        return false
    }
    if x0 == 0 && x1 == 0 && y0 == 0 && y1 == 0 {
        return true
    }
    let x = Fq2::new(x0, x1)
    let y = Fq2::new(y0, y1)
    let px = x.conj().mul(Fq2::new(GAMMA1_C0, GAMMA1_C1))
    let py = y.conj().mul(Fq2::new(GAMMA2_C0, GAMMA2_C1))
    let r = j2_mul_six_x_sq(J2 { x, y, z: Fq2::one() })
    if r.z.is_zero() {
        return false
    }
    let z2 = r.z.square()
    px.mul(z2).eq(r.x) && py.mul(z2).mul(r.z).eq(r.y)
}

/// Canonical coordinates and (`y^2 = x^3 + b'`) or infinity; no subgroup check.
const fn g2_is_on_twist(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> bool {
    if x0 >= Q || x1 >= Q || y0 >= Q || y1 >= Q {
        return false
    }
    let x = Fq2::new(x0, x1)
    let y = Fq2::new(y0, y1)
    if x.is_zero() && y.is_zero() {
        return true
    }
    y.square().eq(x.square().mul(x).add(Fq2::new(B2_C0, B2_C1)))
}

/// A point of the order-`r` subgroup of the BN254 twist `y^2 = x^3 + 3/(9+u)` over Fq2,
/// affine; all-zero is infinity. `from_coords` checks canonical coordinates, curve membership
/// and subgroup membership (see `g2_is_valid`).
pub struct G2 { x: Fq2, y: Fq2 }
impl Copy for G2 {}

impl G2 {
    /// Validated constructor for untrusted coordinates `x = x0 + x1 u`, `y = y0 + y1 u`
    /// (real part first). `None` if `g2_is_valid` is false. All-zero is infinity.
    pub fn from_coords(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> Option<G2> {
        if g2_is_valid(x0, x1, y0, y1) {
            Option::Some(G2 { x: Fq2::new(x0, x1), y: Fq2::new(y0, y1) })
        } else {
            Option::None
        }
    }

    /// Compile-time constructor: the point if it passes `g2_is_valid`, else infinity, so an
    /// unchecked point can never exist. Pair it with `static_assert(g2_is_valid(..))` to turn an
    /// invalid constant into a compile error.
    pub const fn from_coords_or_infinity(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> G2 {
        if g2_is_valid(x0, x1, y0, y1) {
            G2 { x: Fq2::new(x0, x1), y: Fq2::new(y0, y1) }
        } else {
            G2 { x: Fq2::zero(), y: Fq2::zero() }
        }
    }

    pub fn generator() -> G2 {
        G2 {
            x: Fq2::new(
                10857046999023057135944570762232829481370756359578518086990519993285655852781,
                11559732032986387107991004021392285783925812861821192530917403151452391805634,
            ),
            y: Fq2::new(
                8495653923123431417604973247489272438418190587263600148770280649306958101930,
                4082367875863433681332203403145435568316851327593401208105741076214120093531,
            ),
        }
    }

    pub const fn infinity() -> G2 {
        G2 { x: Fq2::zero(), y: Fq2::zero() }
    }

    pub const fn is_infinity(self) -> bool {
        (self.x.c0 | self.x.c1 | self.y.c0 | self.y.c1) == 0
    }

    pub fn x0(self) -> u256 {
        self.x.c0
    }
    pub fn x1(self) -> u256 {
        self.x.c1
    }
    pub fn y0(self) -> u256 {
        self.y.c0
    }
    pub fn y1(self) -> u256 {
        self.y.c1
    }

    pub const fn neg(self) -> G2 {
        G2 { x: self.x, y: self.y.neg() }
    }

    pub fn eq(self, _ o: G2) -> bool {
        self.x.eq(o.x) && self.y.eq(o.y)
    }
}

// ---------------------------------------------------------------------------------------
// G2Proof: untrusted G2 points from proofs
// ---------------------------------------------------------------------------------------

/// A G2 point taken from a proof (e.g. Groth16 `B`): canonical coordinates and twist-curve
/// membership are checked in Fe, the subgroup check is NOT done here. EIP-197 makes the pairing
/// precompile (0x08) fail unless every G2 input has order `r`
/// (https://eips.ethereum.org/EIPS/eip-197), so the check is completed by the only operation this
/// type supports: `pairing_check_proof` / `pairing_try_proof`. There is deliberately no conversion
/// to `G2` and no accessor that yields a `G2`; a `G2Proof` can only reach the pairing. The test
/// `proof_g2_non_subgroup_passes_cheap_check_then_pairing_rejects` pins the precompile behaviour.
pub struct G2Proof { x: Fq2, y: Fq2 }
impl Copy for G2Proof {}

impl G2Proof {
    /// `None` if any coordinate is `>= q` (never reduced) or the point is not on the twist.
    /// All-zero is infinity. Real part first, like `G2::from_coords`.
    pub fn from_coords(_ x0: u256, _ x1: u256, _ y0: u256, _ y1: u256) -> Option<G2Proof> {
        if g2_is_on_twist(x0, x1, y0, y1) {
            Option::Some(G2Proof { x: Fq2::new(x0, x1), y: Fq2::new(y0, y1) })
        } else {
            Option::None
        }
    }

    /// Widening: every checked `G2` is a valid pairing operand.
    pub fn from_g2(_ g: G2) -> G2Proof {
        G2Proof { x: g.x, y: g.y }
    }
}

// ---------------------------------------------------------------------------------------
// Precompile wrappers
// ---------------------------------------------------------------------------------------

/// `a + b` via precompile 0x06. Reverts on failure.
pub fn g1_add(_ a: G1, _ b: G1) -> G1 uses (call: Call, ctx: Ctx) {
    let input = unsafe {
        FixedMemBuffer<128>::alloc_uninit()
    }
    fput(input, 0, a.x)
    fput(input, 32, a.y)
    fput(input, 64, b.x)
    fput(input, 96, b.y)
    var out = unsafe {
        FixedMemBuffer<64>::alloc_uninit().into_buffer()
    }
    assert(call_try_fixed(6, 500, input, mut out, 64))
    // The precompile only outputs on-curve, canonical points (or (0,0)).
    G1 { x: get(out, 0), y: get(out, 1) }
}

/// `[s] p` via precompile 0x07. The scalar is a canonical `Bn254Fr`. Reverts on failure.
pub fn g1_mul(_ p: G1, _ s: Bn254Fr) -> G1 uses (call: Call, ctx: Ctx) {
    let input = unsafe {
        FixedMemBuffer<96>::alloc_uninit()
    }
    fput(input, 0, p.x)
    fput(input, 32, p.y)
    fput(input, 64, s.to_canonical())
    var out = unsafe {
        FixedMemBuffer<64>::alloc_uninit().into_buffer()
    }
    assert(call_try_fixed(7, 7000, input, mut out, 64))
    G1 { x: get(out, 0), y: get(out, 1) }
}

/// Calls the pairing precompile on `n` pairs already written to `input`.
/// Result code: 0 = product != 1, 1 = product == 1, 2 = precompile call failed.
/// Reverts on a returned length other than 32 or a word above 1.
fn pairing_run(_ input: mut MemBuffer, _ n: usize) -> u256
uses (call: Call, ctx: Ctx)
{
    var out = unsafe {
        FixedMemBuffer<32>::alloc_uninit().into_buffer()
    }
    // Explicit gas cap: a failing pairing burns everything forwarded to it.
    let ok = call_try_fixed_buf(
        8,
        50000 + 40000 * (n as u256),
        mut input,
        n * 192,
        mut out,
        32,
    )
    if !ok { return 2 }
    let w = get(out, 0)
    assert(w <= 1)
    w
}

/// Result code of `pairing_raw`: see `pairing_run`.
fn pairing_raw<const N: usize>(_ ps: [G1; N], _ qs: [G2Proof; N]) -> u256
uses (call: Call, ctx: Ctx)
{
    assert(N != 0)
    var input = unsafe {
        MemBuffer::alloc_uninit(N * 192)
    }
    var i: usize = 0
    while i < N {
        let p = ps[i]
        let q = qs[i]
        // i < N, so 6 * i + 5 < 6 * N <= usize bound of the allocation: no overflow
        let o = i * 6
        put(mut input, o, p.x)
        put(mut input, o + 1, p.y)
        put(mut input, o + 2, q.x.c1)
        put(mut input, o + 3, q.x.c0)
        put(mut input, o + 4, q.y.c1)
        put(mut input, o + 5, q.y.c0)
        i += 1
    }
    pairing_run(mut input, N)
}

/// `true` iff `prod_i e(ps[i], qs[i]) == 1`, via precompile 0x08. Reverts if the call fails,
/// returns a length other than 32, returns a word other than 0 or 1, or `N == 0`
/// (an empty product would be vacuously true).
pub fn pairing_check<const N: usize>(_ ps: [G1; N], _ qs: [G2; N]) -> bool
uses (call: Call, ctx: Ctx)
{
    assert(N != 0)
    var input = unsafe {
        MemBuffer::alloc_uninit(N * 192)
    }
    var i: usize = 0
    while i < N {
        let p = ps[i]
        let q = qs[i]
        let o = i * 6
        put(mut input, o, p.x)
        put(mut input, o + 1, p.y)
        put(mut input, o + 2, q.x.c1)
        put(mut input, o + 3, q.x.c0)
        put(mut input, o + 4, q.y.c1)
        put(mut input, o + 5, q.y.c0)
        i += 1
    }
    let w = pairing_run(mut input, N)
    assert(w <= 1)
    w == 1
}

/// Like `pairing_check` for untrusted `G2Proof` operands, strict: reverts if the precompile
/// call fails (which is what happens for a point outside the order-`r` subgroup).
pub fn pairing_check_proof<const N: usize>(_ ps: [G1; N], _ qs: [G2Proof; N]) -> bool
uses (call: Call, ctx: Ctx)
{
    let w = pairing_raw(ps, qs)
    assert(w <= 1)
    w == 1
}

/// Like `pairing_check_proof` but a failing precompile call (malformed or non-subgroup G2)
/// yields `false` instead of reverting. Success flag and returned length are still checked;
/// "call failed" is mapped to rejection, never to acceptance. The failing call burns only the
/// capped gas of `pairing_raw`.
///
/// A lack of gas is not a `false`: `call_try_fixed_buf` reverts unless `cap + GAS_MARGIN` gas
/// remains, so `false` here means the precompile saw the operands and refused them. Gas caps are
/// set for current precompile prices (EIP-1108); a repricing above a cap makes calls fail closed
/// (revert or `false`), never accept.
pub fn pairing_try_proof<const N: usize>(_ ps: [G1; N], _ qs: [G2Proof; N]) -> bool
uses (call: Call, ctx: Ctx)
{
    pairing_raw(ps, qs) == 1
}
