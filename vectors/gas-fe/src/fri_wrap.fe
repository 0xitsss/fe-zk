//! FRI/STARK verifier wrapper (Plonky3 uni-stark Fibonacci proof, KoalaBear, degree-4 extension).
//! The proof arrives as 217 calldata words in field order of `StarkProof` (queries flattened in
//! `QueryProof` field order); the public values are 3 more words.
use fe_zk::verifier::fri::{QueryProof, StarkProof, verify}

const Q_WORDS: usize = 42

fn row4(_ w: [u256; 217], _ at: usize) -> [u256; 4] {
    [w[at], w[at + 1], w[at + 2], w[at + 3]]
}

fn path6(_ w: [u256; 217], _ at: usize) -> [u256; 6] {
    [w[at], w[at + 1], w[at + 2], w[at + 3], w[at + 4], w[at + 5]]
}

fn query(_ w: [u256; 217], _ at: usize) -> QueryProof {
    var fp: [u256; 12] = [0; 12]
    var i: usize = 0
    while i < 12 {
        fp[i] = w[at + 30 + i]
        i += 1
    }
    QueryProof {
        trace_row: [w[at], w[at + 1]],
        trace_path: path6(w, at + 2),
        quotient_row: row4(w, at + 8),
        quotient_path: path6(w, at + 12),
        fold_sibling: [row4(w, at + 18), row4(w, at + 22), row4(w, at + 26)],
        fold_paths: fp,
    }
}

fn unpack(_ w: [u256; 217]) -> StarkProof {
    StarkProof {
        trace_commit: w[0],
        quotient_commit: w[1],
        trace_local: [row4(w, 2), row4(w, 6)],
        trace_next: [row4(w, 10), row4(w, 14)],
        quotient_chunk: [row4(w, 18), row4(w, 22), row4(w, 26), row4(w, 30)],
        fri_commits: [w[34], w[35], w[36]],
        commit_pow_witnesses: [w[37], w[38], w[39]],
        final_poly: [row4(w, 40), row4(w, 44)],
        query_pow_witness: w[48],
        queries: [
            query(w, 49),
            query(w, 49 + Q_WORDS),
            query(w, 49 + 2 * Q_WORDS),
            query(w, 49 + 3 * Q_WORDS),
        ],
    }
}

msg FriMsg {
    #[selector = sol("verify(uint256[217],uint256[3])")]
    Verify { proof: [u256; 217], public: [u256; 3] } -> bool,
}

pub contract FriFib {
    recv FriMsg {
        Verify { proof, public } -> bool {
            verify(unpack(proof), public)
        }
    }
}
