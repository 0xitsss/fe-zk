fn verify_with<const N: usize>(
    _ vk: groth16::Vk<N>,
    _ inputs: [u256; N],
    _ points: [u256; 8],
) -> bool
uses (call: Call, ctx: Ctx)
{
    groth16::verify_calldata(
        vk,
        [points[0], points[1]],
        [[points[3], points[2]], [points[5], points[4]]],
        [points[6], points[7]],
        inputs,
    )
}

fn signals(_ root: u256, _ nullifier: u256, _ message: u256, _ scope: u256) -> [u256; 4] {
    [root, nullifier, hash_to_field(message).to_canonical(), hash_to_field(scope).to_canonical()]
}

/// Like `verify_proof`, but only for depth 1..LOW_MAX_DEPTH (groups up to 2^5 = 32 members): false for any other depth.
/// Pulls only these keys into the contract, which keeps a contract that also holds a LeanImt under the
/// 24,576-byte limit (the tree alone is about 14 KB). Same checks, same result for a depth in range.
pub fn verify_proof_low(
    _ depth: u256,
    _ root: u256,
    _ nullifier: u256,
    _ message: u256,
    _ scope: u256,
    _ points: [u256; 8],
) -> bool
uses (call: Call, ctx: Ctx)
{
    let inputs = signals(root, nullifier, message, scope)
    if depth == 1 {
        return verify_with(vk_d1(), inputs, points)
    }
    if depth == 2 {
        return verify_with(vk_d2(), inputs, points)
    }
    if depth == 3 {
        return verify_with(vk_d3(), inputs, points)
    }
    if depth == 4 {
        return verify_with(vk_d4(), inputs, points)
    }
    if depth == 5 {
        return verify_with(vk_d5(), inputs, points)
    }
    false
}

/// Like `verify_proof`, but only for depth LOW_MAX_DEPTH+1..MAX_DEPTH: false for any other depth.
/// Pulls only these keys into the contract, which keeps a contract that also holds a LeanImt under the
/// 24,576-byte limit (the tree alone is about 14 KB). Same checks, same result for a depth in range.
pub fn verify_proof_high(
    _ depth: u256,
    _ root: u256,
    _ nullifier: u256,
    _ message: u256,
    _ scope: u256,
    _ points: [u256; 8],
) -> bool
uses (call: Call, ctx: Ctx)
{
    let inputs = signals(root, nullifier, message, scope)
    if depth == 6 {
        return verify_with(vk_d6(), inputs, points)
    }
    if depth == 7 {
        return verify_with(vk_d7(), inputs, points)
    }
    if depth == 8 {
        return verify_with(vk_d8(), inputs, points)
    }
    if depth == 9 {
        return verify_with(vk_d9(), inputs, points)
    }
    if depth == 10 {
        return verify_with(vk_d10(), inputs, points)
    }
    false
}

/// Verifies a Semaphore v4 proof. Returns false (never reverts) if `depth` is 0 or above
/// `MAX_DEPTH`, if any word is not canonical, or if the proof does not verify for that depth.
/// `message` and `scope` are the raw values; they are hashed like `Semaphore.sol` does.
/// The caller must still check that `root` is a root of its group and spend the nullifier.
/// Holds all ten keys (about 11 KB of code): see `verify_proof_low` for contracts that are near the
/// size limit.
pub fn verify_proof(
    _ depth: u256,
    _ root: u256,
    _ nullifier: u256,
    _ message: u256,
    _ scope: u256,
    _ points: [u256; 8],
) -> bool
uses (call: Call, ctx: Ctx)
{
    if depth <= LOW_MAX_DEPTH {
        return verify_proof_low(depth, root, nullifier, message, scope, points)
    }
    verify_proof_high(depth, root, nullifier, message, scope, points)
}
