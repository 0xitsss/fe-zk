use ingot::keys_d7
use ingot::keys_d8
use ingot::keys_d9
use ingot::keys_d10

/// Largest Merkle tree depth this ingot has a key for (Semaphore ships keys up to 32; the
/// examples only need the small ones, and each key costs compile time and code size).
pub const MAX_DEPTH: u256 = 10
/// Largest depth `verify_proof_low` handles.
pub const LOW_MAX_DEPTH: u256 = 5

