//! GENERATED by scripts/gen-semaphore-lib.py from the key modules keys_d1..keys_d10 -- do not edit.
//!
//! Semaphore v4 proof verification for Fe contracts.
//!
//! `verify_proof` takes the fields of Semaphore's `SemaphoreProof` struct (what
//! `@semaphore-protocol/proof` `generateProof` returns) and checks the Groth16 proof against the
//! published per-depth verifying key of the Semaphore ceremony (depth 1..10, keys from
//! `packages/proof/src/verification-keys.json`, see scripts/regen-semaphore-keys.sh).
//!
//! Public inputs, in the order of `SemaphoreVerifier.sol`:
//! `[merkleTreeRoot, nullifier, hash(message), hash(scope)]` with `hash(x) = keccak256(x) >> 8`.
//! `points` is the packed proof of Semaphore: `[a0, a1, b01, b00, b11, b10, c0, c1]`, i.e. B in
//! EVM (imaginary, real) order exactly as passed to `SemaphoreVerifier.verifyProof`.
use std::evm::{Call, Ctx}
use fe_zk::groth16
use fe_zk::anon::hash_to_field
use fe_zk::{Field, G1, G2}
