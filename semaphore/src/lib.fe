/// Digest (`fe-zk-gen`, see the key module header) of the verifying key for `depth`, or 0 if there is no key.
pub fn key_digest(_ depth: u256) -> u256 {
    if depth == 1 {
        return keys_d1::VK_DIGEST
    }
    if depth == 2 {
        return keys_d2::VK_DIGEST
    }
    if depth == 3 {
        return keys_d3::VK_DIGEST
    }
    if depth == 4 {
        return keys_d4::VK_DIGEST
    }
    if depth == 5 {
        return keys_d5::VK_DIGEST
    }
    if depth == 6 {
        return keys_d6::VK_DIGEST
    }
    if depth == 7 {
        return keys_d7::VK_DIGEST
    }
    if depth == 8 {
        return keys_d8::VK_DIGEST
    }
    if depth == 9 {
        return keys_d9::VK_DIGEST
    }
    if depth == 10 {
        return keys_d10::VK_DIGEST
    }
    0
}

