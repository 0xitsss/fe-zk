#[test]
fn depth_out_of_range_false() uses (call: Call, ctx: Ctx) {
    // no revert, just false: depth 0, above MAX_DEPTH, and absurd values
    assert(MAX_DEPTH == 10)
    assert(
        !verify_proof(
            0,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            11,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            12,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            32,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            33,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            256,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(key_digest(0) == 0)
    assert(key_digest(11) == 0)
}

#[test]
fn depth_mismatch_false() uses (call: Call, ctx: Ctx) {
    // a proof is only valid under the key of the depth it was made for
    assert(
        !verify_proof(
            2,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            10,
            13935598660665747423895462904844615634606051400193726890571296688239354172259,
            8639367502796254487350222119042536446759879139597952194227172235970006306090,
            1,
            1001,
            d1_points(),
        ),
    )
    assert(
        !verify_proof(
            1,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            2,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            4,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
