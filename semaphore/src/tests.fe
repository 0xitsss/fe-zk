#[test]
fn non_canonical_words_false() uses (call: Call, ctx: Ctx) {
    // root + r and nullifier + r are the same field element but not canonical: rejected, not reduced
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311 + R,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198 + R,
            3,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            R,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff,
            3,
            1003,
            d3_points(),
        ),
    )
}

#[test]
fn tampered_points_false() uses (call: Call, ctx: Ctx) {
    // every single word of the proof matters
    var p0 = d3_points()
    p0[0] = p0[0] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p0,
        ),
    )
    var p1 = d3_points()
    p1[1] = p1[1] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p1,
        ),
    )
    var p2 = d3_points()
    p2[2] = p2[2] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p2,
        ),
    )
    var p3 = d3_points()
    p3[3] = p3[3] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p3,
        ),
    )
    var p4 = d3_points()
    p4[4] = p4[4] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p4,
        ),
    )
    var p5 = d3_points()
    p5[5] = p5[5] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p5,
        ),
    )
    var p6 = d3_points()
    p6[6] = p6[6] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p6,
        ),
    )
    var p7 = d3_points()
    p7[7] = p7[7] + 1
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            p7,
        ),
    )
    // a word >= q is rejected, not reduced
    var big = d3_points()
    big[0] = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            big,
        ),
    )
    // all zero: the point at infinity is not a valid proof element
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            [0, 0, 0, 0, 0, 0, 0, 0],
        ),
    )
}

#[test]
fn b_word_order_matters() uses (call: Call, ctx: Ctx) {
    // SemaphoreVerifier.sol order is (imaginary, real); the snarkjs JSON order must be rejected
    let p = d3_points()
    assert(d3_ok())
    let swapped: [u256; 8] = [p[0], p[1], p[3], p[2], p[5], p[4], p[6], p[7]]
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            swapped,
        ),
    )
    // A and C swapped
    let ac: [u256; 8] = [p[6], p[7], p[2], p[3], p[4], p[5], p[0], p[1]]
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            3,
            1003,
            ac,
        ),
    )
}

