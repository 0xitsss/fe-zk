#[test]
fn key_digests_distinct_and_nonzero() {
    assert(key_digest(1) != 0)
    assert(key_digest(2) != 0)
    assert(key_digest(3) != 0)
    assert(key_digest(4) != 0)
    assert(key_digest(5) != 0)
    assert(key_digest(6) != 0)
    assert(key_digest(7) != 0)
    assert(key_digest(8) != 0)
    assert(key_digest(9) != 0)
    assert(key_digest(10) != 0)
    assert(key_digest(1) != key_digest(2))
    assert(key_digest(1) != key_digest(3))
    assert(key_digest(1) != key_digest(4))
    assert(key_digest(1) != key_digest(5))
    assert(key_digest(1) != key_digest(6))
    assert(key_digest(1) != key_digest(7))
    assert(key_digest(1) != key_digest(8))
    assert(key_digest(1) != key_digest(9))
    assert(key_digest(1) != key_digest(10))
    assert(key_digest(2) != key_digest(3))
    assert(key_digest(2) != key_digest(4))
    assert(key_digest(2) != key_digest(5))
    assert(key_digest(2) != key_digest(6))
    assert(key_digest(2) != key_digest(7))
    assert(key_digest(2) != key_digest(8))
    assert(key_digest(2) != key_digest(9))
    assert(key_digest(2) != key_digest(10))
    assert(key_digest(3) != key_digest(4))
    assert(key_digest(3) != key_digest(5))
    assert(key_digest(3) != key_digest(6))
    assert(key_digest(3) != key_digest(7))
    assert(key_digest(3) != key_digest(8))
    assert(key_digest(3) != key_digest(9))
    assert(key_digest(3) != key_digest(10))
    assert(key_digest(4) != key_digest(5))
    assert(key_digest(4) != key_digest(6))
    assert(key_digest(4) != key_digest(7))
    assert(key_digest(4) != key_digest(8))
    assert(key_digest(4) != key_digest(9))
    assert(key_digest(4) != key_digest(10))
    assert(key_digest(5) != key_digest(6))
    assert(key_digest(5) != key_digest(7))
    assert(key_digest(5) != key_digest(8))
    assert(key_digest(5) != key_digest(9))
    assert(key_digest(5) != key_digest(10))
    assert(key_digest(6) != key_digest(7))
    assert(key_digest(6) != key_digest(8))
    assert(key_digest(6) != key_digest(9))
    assert(key_digest(6) != key_digest(10))
    assert(key_digest(7) != key_digest(8))
    assert(key_digest(7) != key_digest(9))
    assert(key_digest(7) != key_digest(10))
    assert(key_digest(8) != key_digest(9))
    assert(key_digest(8) != key_digest(10))
    assert(key_digest(9) != key_digest(10))
}

#[test]
fn tampered_message_false() uses (call: Call, ctx: Ctx) {
    assert(d3_ok())
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            4,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            0,
            1003,
            d3_points(),
        ),
    )
    assert(
        !verify_proof(
            3,
            14979395686019736638842636854037966679815518754694393214032642095348923764311,
            17153833095991935709320666105379470995317170939380458287621481406316607567198,
            1003,
            1003,
            d3_points(),
        ),
    )
}

