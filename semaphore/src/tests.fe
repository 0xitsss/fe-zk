//! Semaphore v4 verifier tests: real proofs from the official SDK (one per depth 1..10) and the real
//! ceremony fixture. GENERATED by scripts/gen-semaphore-tests.py -- do not edit.
//! Gas: `fe test --show-logs` prints the `GasUsed` events (what = depth).
use ingot::{LOW_MAX_DEPTH, MAX_DEPTH, key_digest, verify_proof, verify_proof_high, verify_proof_low}
use fe_zk::anon::hash_to_field
use fe_zk::Field
use std::evm::{Call, Ctx, Evm}

const R: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617

#[event]
struct GasUsed { what: u256, gas: u256 }

// Proof of the real ceremony fixture (vectors/groth16/real_semaphore_d10, snarkjs), message 1, scope 42
fn real_points() -> [u256; 8] {
    [
        10542108266925685695952599051752623801520962185863451784927276407137856980232,
        79018216857546600114571240959260313061001067675545208559133649417853869105,
        18167428550826632398247461840419096552359773229748593545707860560131586421229,
        19880481142187037362285083500335897108373650019858396699622763063156434696978,
        1243549592389563604619414759755325280617540512004777562258351842671861627349,
        19408899947461825033677036093381452812284250871752740713185924250691794872822,
        9979153546783021842277272700970265312349136550306550728791298650747805712522,
        9526089804907186217889790827691913678135632943142222001306479142208415005311,
    ]
}

fn real_root() -> u256 {
    7849583768829632107197315701067626715345479343546028587428979357557488291089
}

fn real_nullifier() -> u256 {
    5491226049346717773575330492876067147700571028513469748198295297159852039205
}

#[test]
fn real_d10_proof_accepted() uses (call: Call, ctx: Ctx) {
    // the public inputs of the fixture are the hashes of message 1 and scope 42
    assert(
        hash_to_field(1).to_canonical()
            == 312829776796408387545637016147278514583116203736587368460269838669765409292,
    )
    assert(
        hash_to_field(42).to_canonical()
            == 337128325429352729837209583172397910712856832050213866488156768494212314437,
    )
    assert(
        verify_proof(10, real_root(), real_nullifier(), 1, 42, real_points()),
    )
}

#[test]
fn real_d10_wrong_depth_and_signals_rejected() uses (call: Call, ctx: Ctx) {
    assert(
        !verify_proof(9, real_root(), real_nullifier(), 1, 42, real_points()),
    )
    assert(
        !verify_proof(
            10,
            real_root(),
            real_nullifier() + 1,
            1,
            42,
            real_points(),
        ),
    )
    assert(
        !verify_proof(10, real_root(), real_nullifier(), 2, 42, real_points()),
    )
    assert(
        !verify_proof(10, real_root(), real_nullifier(), 1, 43, real_points()),
    )
}

